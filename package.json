{
  "name": "aiv-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsx scripts/check-content-identities.ts && tsx scripts/check-markdown-headings.ts && tsx scripts/og/generate-og-images.ts && astro build && tsx scripts/verify-redirects.ts && tsx scripts/check-internal-links.ts && tsx scripts/check-og-images.ts",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:content-identities && pnpm run test:og-images && pnpm run posters:test && pnpm run events:test",
    "validate": "pnpm build && pnpm lint && pnpm run format:check && pnpm run check:contrast && pnpm test",
    "audit:dependencies": "pnpm audit --audit-level low",
    "verify:redirects": "tsx scripts/verify-redirects.ts",
    "check:content-identities": "tsx scripts/check-content-identities.ts",
    "test:content-identities": "tsx scripts/content-identities.test.ts",
    "check:internal-links": "tsx scripts/check-internal-links.ts",
    "check:contrast": "node scripts/contrast-check.mjs",
    "generate:og-images": "tsx scripts/og/generate-og-images.ts",
    "check:og-images": "tsx scripts/check-og-images.ts",
    "test:og-images": "tsx scripts/og/yaml-frontmatter.test.ts && tsx scripts/og/social-images.test.ts",
    "posters:import": "tsx scripts/posters/import-posters.ts",
    "posters:test": "tsx scripts/posters/slug-stability.test.ts",
    "events:test": "tsx scripts/events/date-range.test.ts && tsx scripts/events/poster-embed.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@expressive-code/core": "^0.44.0",
    "@expressive-code/plugin-line-numbers": "^0.44.0",
    "astro": "^7.2.9",
    "astro-expressive-code": "^0.44.0",
    "astro-mermaid": "^2.1.0",
    "expressive-code-language-badge": "^1.1.0",
    "katex": "^0.17.0",
    "mermaid": "^11.17.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^24.13.2",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^17.7.0",
    "js-yaml": "4.3.1",
    "prettier": "^3.8.5",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
