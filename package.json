{
  "name": "aiv-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsx scripts/check-markdown-headings.ts && astro build && tsx scripts/verify-redirects.ts && tsx scripts/check-internal-links.ts",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify:redirects": "tsx scripts/verify-redirects.ts",
    "check:internal-links": "tsx scripts/check-internal-links.ts",
    "check:contrast": "node scripts/contrast-check.mjs",
    "posters:import": "tsx scripts/posters/import-posters.ts",
    "posters:test": "tsx scripts/posters/slug-stability.test.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.18",
    "@expressive-code/core": "^0.44.0",
    "@expressive-code/plugin-line-numbers": "^0.44.0",
    "astro": "^7.0.3",
    "astro-expressive-code": "^0.44.0",
    "astro-mermaid": "^2.1.0",
    "expressive-code-language-badge": "^1.1.0",
    "katex": "^0.17.0",
    "mermaid": "^11.16.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.8.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
