{
  "name": "aiv-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && tsx scripts/verify-redirects.ts && tsx scripts/check-internal-links.ts",
