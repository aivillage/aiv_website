---
import Button from "../ui/Button.astro";

type SectionId = "details" | "posters" | "schedule" | "poster-times";

type Props = {
  current: SectionId;
};

const { current } = Astro.props as Props;
const sections: Array<{ id: SectionId; href: string; label: string }> = [
  { id: "details", href: "#event-details", label: "Event Details" },
  { id: "posters", href: "#poster-session", label: "Posters" },
  { id: "schedule", href: "#schedule", label: "Full Schedule" },
  {
    id: "poster-times",
    href: "#poster-presentation-schedule",
    label: "Poster Times",
  },
];
---

<nav class="event-section-nav" aria-label="Event section navigation">
  <p class="event-section-nav__label">Event navigation</p>
  <div class="event-section-nav__links">
    {sections.map((section) => (
      <Button
        href={section.href}
        variant={section.id === current ? "primary" : "secondary"}
        size="sm"
        ariaCurrent={section.id === current ? "location" : undefined}
      >
        {section.label}
      </Button>
    ))}
  </div>
</nav>

<style>
  .event-section-nav {
    border-top: 1px solid var(--aiv-rule-color);
    margin-block: 2.5rem 3rem;
    padding-top: 1.25rem;
  }

  .event-section-nav__label {
    color: var(--aiv-text-muted);
    font-family: var(--aiv-font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .event-section-nav__links {
    align-items: stretch;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 40rem) {
    .event-section-nav__links {
      flex-direction: column;
    }
  }
</style>
