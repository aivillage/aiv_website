---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { VolunteerEntry } from "../utils/site";

const { volunteer, Content } = Astro.props as {
  volunteer: VolunteerEntry;
  Content?: AstroComponentFactory;
};
const initials = `${volunteer.data.first_name.slice(0, 1)}${volunteer.data.last_name.slice(0, 1)}`;
const fullName = `${volunteer.data.first_name} ${volunteer.data.last_name}`;
const anchorId = volunteer.data.slug;
---

<div class="team-member volunteer-card" id={anchorId}>
  <div class="member-photo volunteer-card__photo">
    {
      volunteer.data.profile ? (
        <img
          class="volunteer-card__image"
          src={`/assets/images/profiles/${volunteer.data.profile}`}
          alt={fullName}
        />
      ) : (
        <div class="volunteer-card__placeholder">
          <span>{initials}</span>
        </div>
      )
    }
  </div>
  <div class="member-info volunteer-card__info">
    <h3>
      <a class="volunteer-card__name-link" href={`#${anchorId}`}>
        <span>{fullName}</span>
        <span class="volunteer-card__permalink" aria-hidden="true">#</span>
      </a>
    </h3>
    {
      volunteer.data.position && (
        <div class="volunteer-card__position">
          <strong>{volunteer.data.position}</strong>
        </div>
      )
    }
    {
      volunteer.data.affiliation && (
        <div class="volunteer-card__meta">
          <strong>Affiliation:</strong> {volunteer.data.affiliation}
        </div>
      )
    }
    {
      volunteer.data.expertise && (
        <div class="volunteer-card__meta">
          <strong>Expertise:</strong> {volunteer.data.expertise}
        </div>
      )
    }
    {
      volunteer.data.bio && Content && (
        <div class="volunteer-card__bio">
          <Content />
        </div>
      )
    }
  </div>
</div>

<style>
  .volunteer-card {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-left: 4px solid var(--aiv-action-secondary);
    border-radius: 5px;
    box-shadow: var(--aiv-card-shadow);
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    scroll-margin-top: 6rem;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .volunteer-card:target {
    border-color: var(--aiv-action-primary);
    box-shadow: var(--aiv-card-hover-shadow);
  }

  .volunteer-card__photo {
    flex-shrink: 0;
  }

  .volunteer-card__image,
  .volunteer-card__placeholder {
    border: 2px solid var(--aiv-card-hover-border);
    border-radius: 50%;
    height: 120px;
    width: 120px;
  }

  .volunteer-card__image {
    object-fit: cover;
  }

  .volunteer-card__placeholder {
    align-items: center;
    background: var(--aiv-nested-bg);
    display: flex;
    justify-content: center;
  }

  .volunteer-card__placeholder span {
    color: var(--aiv-brand-primary);
    font-family: var(--aiv-font-mono);
    font-size: 2rem;
  }

  .volunteer-card__info {
    flex: 1;
  }

  .volunteer-card__info h3 {
    margin: 0 0 0.5rem;
  }

  .volunteer-card__name-link {
    align-items: baseline;
    color: var(--aiv-text-primary);
    display: inline-flex;
    text-decoration: none;
  }

  .volunteer-card__name-link:hover {
    color: var(--aiv-action-primary);
  }

  .volunteer-card__name-link:focus-visible {
    border-radius: 0.2rem;
    outline: 3px solid var(--aiv-focus-ring);
    outline-offset: 3px;
  }

  .volunteer-card__permalink {
    color: var(--aiv-action-primary);
    margin-left: 0.4rem;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .volunteer-card__name-link:hover .volunteer-card__permalink,
  .volunteer-card__name-link:focus-visible .volunteer-card__permalink {
    opacity: 1;
  }

  .volunteer-card__position {
    color: var(--aiv-action-secondary);
    font-family: var(--aiv-font-mono);
    font-size: 0.9rem;
    margin: 0.25rem 0;
  }

  .volunteer-card__meta {
    color: var(--aiv-text-muted);
    font-size: 0.9rem;
    margin: 0.25rem 0;
  }

  .volunteer-card__bio {
    color: var(--aiv-text-secondary);
    line-height: 1.6;
    margin-top: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .volunteer-card,
    .volunteer-card__permalink {
      transition: none;
    }
  }
</style>
