---
import { defaultSocialImageSource, site } from "../data/site";
import {
  generatedSocialImageDimensions,
  generatedSocialImagePath,
} from "../utils/social-images";
import { isoDateOnly } from "../utils/site";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  socialImageAlt?: string;
  type?: "website" | "article" | "event";
  publishedTime?: Date;
  author?: string | string[];
  eventDate?: Date;
  eventEndDate?: Date;
  eventLocation?: string;
  noindex?: boolean;
};

const {
  title,
  description = site.description,
  canonical = "/",
  image,
  socialImageAlt,
  type = "website",
  publishedTime,
  author,
  eventDate,
  eventEndDate,
  eventLocation,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonicalUrl = new URL(canonical, site.url).toString();
const selectedImageSource = image ?? defaultSocialImageSource;
const imageUrl = new URL(generatedSocialImagePath(selectedImageSource), site.url).toString();
const imageDimensions = generatedSocialImageDimensions(selectedImageSource);
const normalizedSocialImageAlt = socialImageAlt?.trim() || undefined;
const authors = author ? (Array.isArray(author) ? author : [author]) : [];
const structuredAuthors = authors.map((name) => ({
  "@type": name === site.title ? "Organization" : "Person",
  name,
}));
const structuredAuthor =
  authors.length === 0
    ? { "@type": "Organization", name: site.title }
    : authors.length === 1
      ? structuredAuthors[0]
      : structuredAuthors;
const jsonLd =
  canonical === "/"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          name: site.title,
          url: site.url,
          description,
        },
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          name: site.title,
          url: site.url,
          sameAs: site.social,
        },
      ]
    : type === "event"
      ? {
          "@context": "https://schema.org",
          "@type": "Event",
          name: title ?? site.title,
          url: canonicalUrl,
          startDate: eventDate ? isoDateOnly(eventDate) : undefined,
          endDate: eventEndDate ? isoDateOnly(eventEndDate) : undefined,
          description,
          location: eventLocation ? { "@type": "Place", name: eventLocation } : undefined,
        }
      : type === "article"
        ? {
            "@context": "https://schema.org",
            "@type": "BlogPosting",
            headline: title ?? site.title,
            description,
            url: canonicalUrl,
            mainEntityOfPage: canonicalUrl,
            datePublished: publishedTime?.toISOString(),
            author: structuredAuthor,
            publisher: { "@type": "Organization", name: site.title, url: site.url },
            image: imageUrl,
          }
      : {
          "@context": "https://schema.org",
          "@type": "WebPage",
          name: title ?? site.title,
          description,
          url: canonicalUrl,
          mainEntityOfPage: canonicalUrl,
        };
---

<meta charset="utf-8" />
<meta name="generator" content={Astro.generator} />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,follow" />}
<link rel="icon" href="/public/img/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" href="/public/img/favicon-32x32.png" sizes="32x32" />
<link rel="icon" type="image/png" href="/public/img/favicon-16x16.png" sizes="16x16" />
<link rel="apple-touch-icon" href="/public/img/favicon-32x32.png" />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:title" content={title ?? site.title} />
<meta property="og:locale" content="en_US" />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={site.title} />
<meta property="og:type" content={type === "event" ? "website" : type} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageDimensions && <meta property="og:image:width" content={imageDimensions.width.toString()} />}
{imageDimensions && <meta property="og:image:height" content={imageDimensions.height.toString()} />}
{normalizedSocialImageAlt && <meta property="og:image:alt" content={normalizedSocialImageAlt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? site.title} />
<meta name="twitter:site" content={`@${site.twitter}`} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
{normalizedSocialImageAlt && <meta name="twitter:image:alt" content={normalizedSocialImageAlt} />}
<link type="application/rss+xml" rel="alternate" href={new URL("/feed.xml", site.url).toString()} title={site.title} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
