---
import type { SponsorEntry } from "../utils/site";
import { sponsorPath } from "../utils/site";

type LinkMode = "external" | "detail" | "none";

const { sponsors, linkMode = "external", compact = false } = Astro.props as {
  sponsors: SponsorEntry[];
  linkMode?: LinkMode;
  compact?: boolean;
};
---

<div class:list={["sponsor-grid", { "sponsor-grid--compact": compact }]}>
  {sponsors.map((sponsor) => {
    const href = linkMode === "detail" ? sponsorPath(sponsor) : linkMode === "external" ? sponsor.data.url : undefined;
    const target = linkMode === "external" && href ? "_blank" : undefined;
    const rel = linkMode === "external" && href ? "noopener noreferrer" : undefined;
    const logoContent = sponsor.data.logo ? (
      <img class="sponsor-grid__logo" src={`/assets/images/logos/${sponsor.data.logo}`} alt={`${sponsor.data.name} logo`} />
    ) : (
      <span>{sponsor.data.name}</span>
    );

    return (
      <div class="card sponsor-grid__card">
        {href ? (
          <a class="sponsor-grid__logo-box" href={href} target={target} rel={rel}>
            {logoContent}
          </a>
        ) : (
          <div class="sponsor-grid__logo-box">
            {logoContent}
          </div>
        )}
        <h3 class="sponsor-grid__name">
          {href ? <a href={href} target={target} rel={rel}>{sponsor.data.name}</a> : sponsor.data.name}
        </h3>
      </div>
    );
  })}
</div>

<style>
  .sponsor-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    margin: 2rem 0;
  }

  .sponsor-grid--compact {
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 1.5rem 0;
  }

  .sponsor-grid__card {
    align-items: center;
    display: grid;
    justify-items: center;
  }

  .sponsor-grid--compact .sponsor-grid__card {
    padding: 1rem;
  }

  .sponsor-grid__logo-box {
    align-items: center;
    background: #fff;
    border: 2px solid var(--aiv-card-border);
    border-radius: 10%;
    display: flex;
    height: 240px;
    justify-content: center;
    padding: 20px;
    width: 240px;
  }

  .sponsor-grid--compact .sponsor-grid__logo-box {
    border-width: 1px;
    border-radius: 5px;
    height: 100px;
    padding: 16px;
    width: 150px;
  }

  .sponsor-grid__logo {
    max-height: 200px;
    max-width: 200px;
    object-fit: contain;
  }

  .sponsor-grid--compact .sponsor-grid__logo {
    max-height: 70px;
    max-width: 120px;
  }

  .sponsor-grid__name {
    text-align: center;
  }

  .sponsor-grid--compact .sponsor-grid__name {
    font-size: 1rem;
    margin: 0.75rem 0 0;
  }
</style>
