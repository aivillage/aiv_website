---
type ProofItem = {
  value?: string;
  label: string;
  detail?: string;
};

type Props = {
  items?: ProofItem[];
  mobileHeading?: string;
  class?: string;
};

const { items = [], mobileHeading, class: className } = Astro.props as Props;
---

<div class:list={["aiv-proof-strip", className]}>
  {mobileHeading && <p class="aiv-proof-strip__heading">{mobileHeading}</p>}
  {items.length > 0 ? (
    items.map((item) => (
      <div class="aiv-proof-strip__item">
        {item.value && <strong class="aiv-proof-strip__value">{item.value}</strong>}
        <span class="aiv-proof-strip__label">{item.label}</span>
        {item.detail && <span class="aiv-proof-strip__detail">{item.detail}</span>}
      </div>
    ))
  ) : (
    <slot />
  )}
</div>

<style>
  .aiv-proof-strip {
    border-block: 1px solid var(--aiv-rule-color);
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    padding-block: 1.25rem;
  }

  .aiv-proof-strip__heading {
    display: none;
  }

  .aiv-proof-strip__item {
    display: grid;
    gap: 0.2rem;
  }

  .aiv-proof-strip__value {
    color: var(--aiv-brand-primary);
    font-family: var(--aiv-font-mono);
    font-size: clamp(1.4rem, 2vw, 2rem);
    line-height: 1.1;
  }

  .aiv-proof-strip__label {
    color: var(--aiv-text-primary);
    font-family: var(--aiv-font-mono);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .aiv-proof-strip__detail {
    color: var(--aiv-text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 639px) {
    .aiv-proof-strip__heading {
      color: var(--aiv-action-secondary);
      display: block;
      font-family: var(--aiv-font-mono);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1.3;
      margin: 0 0 0.95rem;
      text-transform: uppercase;
      grid-column: 1 / -1;
    }

    .aiv-proof-strip__item {
      align-items: start;
      gap: 0.45rem;
      grid-template-columns: auto 1fr;
    }

    .aiv-proof-strip__item::before {
      background: var(--aiv-text-muted);
      border-radius: 999px;
      content: "";
      height: 0.3rem;
      margin-top: 0.62em;
      opacity: 0.8;
      width: 0.3rem;
    }

    .aiv-proof-strip__label {
      color: var(--aiv-text-secondary);
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0;
      line-height: 1.45;
    }
  }
</style>
