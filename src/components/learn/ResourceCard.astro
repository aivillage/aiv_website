---
import type { CollectionEntry } from "astro:content";
import DifficultyBadge from "./DifficultyBadge.astro";
import StageBadge from "./StageBadge.astro";
import { accessModeLabels, formatLabel, refId, resourceActionLabel, resourcePath } from "../../utils/learn";

type Props = {
  resource: CollectionEntry<"learnResources">;
};

const { resource } = Astro.props;
const trackRefs = resource.data.tracks.map(refId).join(" ");
const sourceLabel = resource.data.sourcePlatform === "youtube" ? "YouTube" : resource.data.sourcePlatform ? formatLabel(resource.data.sourcePlatform) : "";
const creator = resource.data.creator || resource.data.attribution;
const accessLabel = accessModeLabels[resource.data.accessMode] || accessModeLabels.direct_open;
const actionLabel = resourceActionLabel(resource);
const relatedTracks = resource.data.tracks.map((trackRef) => formatLabel(refId(trackRef).replace(/-/g, "_"))).slice(0, 2);
const isUnderReview = resource.data.reviewStatus !== "accepted";
const isOffRamp = resource.data.accessMode !== "direct_open";
---

<article class="learn-card" data-track-refs={trackRefs} data-stage={resource.data.targetStage} data-difficulty={resource.data.difficulty} data-type={resource.data.resourceType} data-access={resource.data.accessMode}>
  <div class="learn-card__meta">
    <StageBadge value={resource.data.targetStage} />
    <DifficultyBadge value={resource.data.difficulty} />
    <span class="learn-access-badge">{isOffRamp ? "Extra/off-ramp" : accessLabel}</span>
    {isUnderReview && <span class="learn-access-badge learn-access-badge--review">Under review</span>}
  </div>
  <h3><a href={resourcePath(resource)}>{resource.data.title}</a></h3>
  <p class="learn-card__provider">
    {resource.data.provider}
    <a href={resource.data.canonicalUrl} target="_blank" rel="noopener noreferrer">Open original</a>
  </p>
  {resource.data.watchFocus && <p>{resource.data.watchFocus}</p>}
  {resource.data.checkpointPrompt && <p class="learn-card__checkpoint">{resource.data.checkpointPrompt}</p>}
  <div class="learn-card__meta">
    <span>{actionLabel}</span>
    <span>{formatLabel(resource.data.resourceType)}</span>
    {sourceLabel && <span>{sourceLabel}</span>}
    {creator && <span>By {creator}</span>}
    {relatedTracks.length > 0 && <span>Track: {relatedTracks.join(", ")}</span>}
    {resource.data.embedAllowed && <span>Official embed available</span>}
  </div>
</article>

<style>
  .learn-card {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-radius: 8px;
    box-shadow: var(--aiv-card-shadow);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 100%;
    padding: 1.15rem;
  }

  .learn-card[hidden] {
    display: none;
  }

  .learn-card h3 {
    font-size: 1.08rem;
    margin: 0;
  }

  .learn-card p {
    margin: 0;
  }

  .learn-card__provider,
  .learn-card__checkpoint,
  .learn-card__meta {
    color: var(--aiv-text-muted);
  }

  .learn-card__provider {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .learn-card__meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.9rem;
    gap: 0.5rem;
  }

  .learn-access-badge {
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 999px;
    color: var(--aiv-text);
    padding: 0.12rem 0.45rem;
  }
</style>
