---
import type { CollectionEntry } from "astro:content";
import StatusBadge from "./StatusBadge.astro";
import { difficultyLabels, entrySlug, getModuleWatchTarget, labPath, moduleTypeLabels, refId, trackScopedModulePath } from "../../utils/learn";

type Props = {
  track: CollectionEntry<"learnTracks">;
  modules: CollectionEntry<"learnModules">[];
  resources?: CollectionEntry<"learnResources">[];
  labs?: CollectionEntry<"learnLabs">[];
};

const { track, modules, resources = [], labs = [] } = Astro.props;

function shouldShowModuleStatus(status: CollectionEntry<"learnModules">["data"]["status"]) {
  return ["coming_soon", "stale", "draft"].includes(status);
}

function shouldShowDifficulty(difficulty: CollectionEntry<"learnModules">["data"]["difficulty"]) {
  return ["advanced", "expert"].includes(difficulty);
}

function firstLabForModule(module: CollectionEntry<"learnModules">) {
  const moduleLabRefs = new Set((module.data.labs || []).map(refId));
  return labs.find((lab) => moduleLabRefs.has(entrySlug(lab)) || moduleLabRefs.has(lab.id));
}
---

<section class="path-map learn-surface-path" aria-labelledby="path-map-heading">
  <div class="path-map__header">
    <div>
      <span class="path-map__eyebrow">Learning path</span>
      <h2 id="path-map-heading">Follow the module path</h2>
    </div>
    {modules.length > 0 && <p>{modules.length} public {modules.length === 1 ? "module" : "modules"}</p>}
  </div>

  {modules.length > 0 ? (
    <ol class="path-map__list">
      {modules.map((module, index) => {
        const href = trackScopedModulePath(track, module);
        const actionLabel = index === 0 ? "Start module" : "Open module";
        const watchTarget = getModuleWatchTarget(module, resources, { governingTrack: track });
        const relatedLab = firstLabForModule(module);
        return (
          <li class="path-map__item">
            <div class="path-map__content">
              <div class="path-map__marker" aria-label={`Module ${index + 1}`}>{index + 1}</div>
              <div class="path-map__main">
                <div class="path-map__meta">
                  {shouldShowModuleStatus(module.data.status) && <StatusBadge value={module.data.status} />}
                  <span>{moduleTypeLabels[module.data.moduleType]}</span>
                  {shouldShowDifficulty(module.data.difficulty) && <span>{difficultyLabels[module.data.difficulty]}</span>}
                </div>
                <h3><a href={href}>{module.data.title}</a></h3>
                <p>{module.data.summary}</p>
                <p class="path-map__produces"><span>Produces:</span> {module.data.requiredArtifact || "Checkpoint being refined."}</p>
              </div>
            </div>
            <div class="path-map__actions" aria-label={`${module.data.title} actions`}>
              <a class="path-map__action path-map__action--primary" href={href}>{actionLabel}</a>
              <div class="path-map__secondary-actions">
                {watchTarget && <a class="path-map__action path-map__action--secondary" href={watchTarget.href}>Watch</a>}
                {relatedLab && <a class="path-map__action path-map__action--secondary" href={labPath(relatedLab)}>Practice</a>}
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  ) : (
    <div class="path-map__empty">
      <h3>{track.data.status === "coming_soon" ? "Module path coming soon" : "No public modules yet"}</h3>
      <p>
        {track.data.status === "coming_soon"
          ? "This track is visible as a roadmap, but its module path is not public yet."
          : "This track is in the curriculum index, but no public module sequence is available yet."}
      </p>
    </div>
  )}
</section>

<style>
  .path-map {
    display: grid;
    gap: 0.75rem;
    padding: 0.9rem;
  }

  .path-map__header {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
  }

  .path-map__header h2,
  .path-map__header p,
  .path-map__main h3,
  .path-map__main p,
  .path-map__empty h3,
  .path-map__empty p {
    margin: 0;
  }

  .path-map__header p {
    color: var(--aiv-text-muted);
    font-weight: 800;
  }

  .path-map__eyebrow,
  .path-map__produces span {
    color: var(--aiv-text-muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .path-map__list {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .path-map__item {
    align-items: start;
    display: grid;
    gap: 0.85rem;
    grid-template-columns: minmax(0, 1fr) minmax(10.5rem, auto);
    padding: 0.8rem 0;
    position: relative;
  }

  .path-map__item + .path-map__item {
    border-top: 1px solid color-mix(in srgb, var(--aiv-action-primary) 28%, var(--aiv-line-subtle));
  }

  .path-map__content {
    align-items: start;
    display: grid;
    gap: 0.72rem;
    grid-template-columns: auto minmax(0, 1fr);
    min-width: 0;
  }

  .path-map__marker {
    align-items: center;
    background: var(--aiv-action-primary);
    border: 2px solid color-mix(in srgb, var(--aiv-bg-canvas) 34%, transparent);
    border-radius: 999px;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--aiv-action-primary) 18%, transparent);
    color: var(--aiv-bg-canvas);
    display: inline-flex;
    font-family: var(--aiv-font-mono);
    font-weight: 900;
    height: 2.25rem;
    justify-content: center;
    margin-top: 0.15rem;
    width: 2.25rem;
  }

  .path-map__main {
    display: grid;
    gap: 0.28rem;
    min-width: 0;
  }

  .path-map__main h3 {
    font-size: clamp(1.08rem, 1.6vw, 1.35rem);
    line-height: 1.18;
  }

  .path-map__main p {
    color: var(--aiv-text-secondary);
    display: -webkit-box;
    font-size: 0.95rem;
    line-height: 1.45;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .path-map__main .path-map__produces {
    color: var(--aiv-text-primary);
    display: block;
    font-size: 0.92rem;
    font-weight: 750;
    line-height: 1.35;
    overflow: visible;
  }

  .path-map__meta {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.82rem;
    gap: 0.42rem;
  }

  .path-map__actions {
    align-items: stretch;
    display: grid;
    gap: 0.48rem;
    justify-items: stretch;
  }

  .path-map__secondary-actions {
    display: grid;
    gap: 0.42rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .path-map__action {
    align-items: center;
    border-radius: 6px;
    display: inline-flex;
    font-weight: 800;
    justify-content: center;
    min-height: 2.45rem;
    padding: 0.42rem 0.7rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .path-map__action--primary {
    border: 1px solid var(--aiv-action-primary);
    color: var(--aiv-action-primary);
  }

  .path-map__item:first-child .path-map__action--primary {
    background: var(--aiv-action-primary);
    color: var(--aiv-bg-canvas);
  }

  .path-map__action--secondary {
    border: 1px solid var(--aiv-line-strong);
    color: var(--aiv-text-secondary);
    font-size: 0.9rem;
    min-height: 2.25rem;
    padding-inline: 0.58rem;
  }

  .path-map__empty {
    display: grid;
    gap: 0.35rem;
    padding-block: 0.65rem;
  }

  .path-map__empty p {
    color: var(--aiv-text-secondary);
  }

  .path-map__main a:focus-visible,
  .path-map__action:focus-visible {
    outline: 3px solid var(--aiv-focus-ring);
    outline-offset: 3px;
  }

  @media (max-width: 980px) {
    .path-map__item {
      grid-template-columns: 1fr;
    }

    .path-map__action {
      justify-self: start;
    }

    .path-map__actions {
      justify-items: start;
    }

    .path-map__secondary-actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 540px) {
    .path-map {
      padding: 0.9rem;
    }

    .path-map__main p {
      -webkit-line-clamp: 2;
    }

    .path-map__content {
      grid-template-columns: 1fr;
    }

    .path-map__marker {
      border-radius: 6px;
      height: 2rem;
      width: 2.7rem;
    }
  }
</style>
