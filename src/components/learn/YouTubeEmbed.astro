---
type Props = {
  title: string;
  creator: string;
  canonicalUrl: string;
  channelUrl?: string;
  videoId?: string;
  playlistId?: string;
  playlistUrl?: string;
  mediaType?: string;
  embedPrivacyMode?: "enhanced" | "standard";
};

const {
  title,
  creator,
  canonicalUrl,
  channelUrl,
  videoId,
  playlistId,
  playlistUrl,
  mediaType,
  embedPrivacyMode = "enhanced",
} = Astro.props;
const host = embedPrivacyMode === "standard" ? "https://www.youtube.com" : "https://www.youtube-nocookie.com";
const usePlaylist = mediaType === "playlist" && playlistId;
const embedSrc = usePlaylist
  ? `${host}/embed?listType=playlist&list=${encodeURIComponent(playlistId)}`
  : `${host}/embed/${encodeURIComponent(videoId || "")}`;
const embedTitle = usePlaylist ? `${title} playlist` : title;
---

<section class="youtube-embed" data-youtube-embed data-embed-src={embedSrc} data-embed-title={embedTitle}>
  <div class="youtube-embed__frame" data-youtube-frame>
    <div class="youtube-embed__facade">
      <p class="youtube-embed__eyebrow">YouTube</p>
      <h3>{title}</h3>
      <p>
        Embedded from YouTube. Video belongs to
        {channelUrl ? <a href={channelUrl} target="_blank" rel="noopener noreferrer">{creator}</a> : creator}.
      </p>
      <button type="button" data-youtube-load>Load embedded video</button>
    </div>
  </div>
  <div class="youtube-embed__meta">
    <a href={canonicalUrl} target="_blank" rel="noopener noreferrer">Open on YouTube</a>
    {playlistUrl && <a href={playlistUrl} target="_blank" rel="noopener noreferrer">Open playlist</a>}
  </div>
</section>

<script>
  const players = Array.from(document.querySelectorAll<HTMLElement>("[data-youtube-embed]"));

  players.forEach((player) => {
    const button = player.querySelector<HTMLButtonElement>("[data-youtube-load]");
    const frame = player.querySelector<HTMLElement>("[data-youtube-frame]");
    const src = player.dataset.embedSrc;
    const title = player.dataset.embedTitle || "YouTube video";

    if (!button || !frame || !src) return;

    button.addEventListener("click", () => {
      const separator = src.includes("?") ? "&" : "?";
      const iframe = document.createElement("iframe");
      iframe.src = `${src}${separator}${["autoplay", "1"].join("=")}`;
      iframe.title = title;
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      frame.replaceChildren(iframe);
    }, { once: true });
  });
</script>

<style>
  .youtube-embed {
    display: grid;
    gap: 0.75rem;
  }

  .youtube-embed__frame {
    aspect-ratio: 16 / 9;
    background: var(--aiv-bg-panel);
    border: 1px solid var(--aiv-line-subtle);
    border-radius: 8px;
    min-height: 200px;
    overflow: hidden;
    width: 100%;
  }

  .youtube-embed__frame iframe {
    border: 0;
    height: 100%;
    width: 100%;
  }

  .youtube-embed__facade {
    align-content: center;
    display: grid;
    gap: 0.75rem;
    min-height: 100%;
    padding: 1.25rem;
    place-items: center;
    text-align: center;
  }

  .youtube-embed__facade h3,
  .youtube-embed__facade p {
    margin: 0;
    max-width: 56ch;
  }

  .youtube-embed__eyebrow {
    color: var(--aiv-text-muted);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .youtube-embed__facade button {
    background: var(--aiv-accent-primary);
    border: 1px solid var(--aiv-accent-primary);
    border-radius: 6px;
    color: var(--aiv-bg);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    min-height: 2.5rem;
    padding: 0.55rem 0.85rem;
  }

  .youtube-embed__meta {
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.9rem;
    gap: 0.75rem;
  }
</style>
