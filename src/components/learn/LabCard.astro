---
import type { CollectionEntry } from "astro:content";
import ArtifactBadge from "./ArtifactBadge.astro";
import DifficultyBadge from "./DifficultyBadge.astro";
import StageBadge from "./StageBadge.astro";
import StatusBadge from "./StatusBadge.astro";
import { canRenderLearnLab, formatLabel, labPath } from "../../utils/learn";

type Props = {
  lab: CollectionEntry<"learnLabs">;
};

const { lab } = Astro.props;
const href = canRenderLearnLab(lab) ? labPath(lab) : "";
---

<article class="learn-card">
  <div class="learn-card__meta">
    <StatusBadge value={lab.data.status} />
    <DifficultyBadge value={lab.data.difficulty} />
    {lab.data.isOffensive && <span class="learn-card__flag">Offensive</span>}
  </div>
  <h3>{href ? <a href={href}>{lab.data.title}</a> : lab.data.title}</h3>
  <p>{lab.data.summary}</p>
  <div class="learn-card__meta">
    <StageBadge value={lab.data.stageStart} />
    <span>to</span>
    <StageBadge value={lab.data.stageEnd} />
  </div>
  <dl>
    <div>
      <dt>Safety boundary</dt>
      <dd>{lab.data.safetyBoundary}</dd>
    </div>
    <div>
      <dt>Run modes</dt>
      <dd>{lab.data.runModes.map(formatLabel).join(", ")}</dd>
    </div>
    <div>
      <dt>Debrief</dt>
      <dd>{formatLabel(lab.data.debriefStatus)}</dd>
    </div>
  </dl>
  <ArtifactBadge value={lab.data.requiredArtifact} />
</article>

<style>
  .learn-card {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-radius: 8px;
    box-shadow: var(--aiv-card-shadow);
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    min-height: 100%;
    padding: 1.15rem;
  }

  .learn-card h3 {
    font-size: 1.12rem;
    margin: 0;
  }

  .learn-card p {
    margin: 0;
  }

  .learn-card__meta {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.9rem;
    gap: 0.5rem;
  }

  .learn-card__flag {
    border: 1px solid var(--aiv-risk);
    border-radius: 999px;
    color: var(--aiv-risk);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.28rem 0.65rem;
  }

  .learn-card dl {
    display: grid;
    gap: 0.65rem;
    margin: 0;
  }

  .learn-card dt {
    color: var(--aiv-text-muted);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .learn-card dd {
    margin: 0;
  }
</style>
