---
import type { CollectionEntry } from "astro:content";
import { canRenderLearnLab, labPath } from "../../utils/learn";

type Props = {
  lab: CollectionEntry<"learnLabs">;
  usedInModuleTitle?: string;
  usedInModuleHref?: string;
};

const { lab, usedInModuleTitle, usedInModuleHref } = Astro.props;
const href = canRenderLearnLab(lab) ? labPath(lab) : "";
---

<article class="learn-card">
  <div class="learn-card__meta">
    {lab.data.isOffensive && <span class="learn-card__flag">Offensive toy lab</span>}
    <span>{lab.data.estimatedMinutes} min</span>
  </div>
  <h3>{href ? <a href={href}>{lab.data.title}</a> : lab.data.title}</h3>
  <p>{lab.data.summary}</p>
  <dl>
    <div>
      <dt>Safety boundary</dt>
      <dd>{lab.data.safetyBoundary}</dd>
    </div>
    <div>
      <dt>Expected artifact</dt>
      <dd>{lab.data.requiredArtifact}</dd>
    </div>
  </dl>
  {(usedInModuleTitle || href) && (
    <div class="learn-card__actions">
      {usedInModuleTitle && (
        usedInModuleHref ? <a href={usedInModuleHref}>Used in {usedInModuleTitle}</a> : <span>Used in {usedInModuleTitle}</span>
      )}
      {href && <a href={href}>Open lab</a>}
    </div>
  )}
</article>

<style>
  .learn-card {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-radius: 8px;
    box-shadow: var(--aiv-card-shadow);
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin: 0;
    min-height: 100%;
    padding: 1.15rem;
  }

  .learn-card h3 {
    font-size: 1.12rem;
    margin: 0;
  }

  .learn-card p {
    margin: 0;
  }

  .learn-card__meta {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.9rem;
    gap: 0.5rem;
  }

  .learn-card__flag {
    border: 1px solid var(--aiv-risk);
    border-radius: 999px;
    color: var(--aiv-risk);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.28rem 0.65rem;
  }

  .learn-card__actions {
    align-items: center;
    border-top: 1px solid var(--aiv-line-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .learn-card__actions a,
  .learn-card__actions span {
    align-items: center;
    display: inline-flex;
    min-height: 2.35rem;
  }

  .learn-card dl {
    display: grid;
    gap: 0.65rem;
    margin: 0;
  }

  .learn-card dt {
    color: var(--aiv-text-muted);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .learn-card dd {
    margin: 0;
  }
</style>
