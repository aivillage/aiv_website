---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageShell from "../layout/PageShell.astro";
import ArtifactGuide from "./ArtifactGuide.astro";
import DifficultyBadge from "./DifficultyBadge.astro";
import LabCard from "./LabCard.astro";
import YouTubeEmbed from "./YouTubeEmbed.astro";
import {
  accessModeLabels,
  artifactFieldsForModule,
  canRenderLearnTrack,
  formatLabel,
  modulePath,
  moduleTypeLabels,
  resourcePath,
  trackPath,
  trackScopedModulePath,
} from "../../utils/learn";

type ResourceGroup = {
  role: "required" | "optional" | "deeper";
  heading: string;
  items: ResourceItem[];
};

type ResourceItem = {
  resource: CollectionEntry<"learnResources">;
  step?: number;
  note?: string;
  sourceIndex: number;
};

type TrackContext = {
  track: CollectionEntry<"learnTracks">;
  moduleIndex: number;
  moduleCount: number;
  previousModule?: CollectionEntry<"learnModules">;
  nextModule?: CollectionEntry<"learnModules">;
};

type Props = {
  module: CollectionEntry<"learnModules">;
  tracks: CollectionEntry<"learnTracks">[];
  canonicalTracks: CollectionEntry<"learnTracks">[];
  prerequisites: CollectionEntry<"learnModules">[];
  resourceGroups: ResourceGroup[];
  featuredEmbed?: ResourceItem;
  labs: CollectionEntry<"learnLabs">[];
  canonical: string;
  trackContext?: TrackContext;
  globalTrackContext?: TrackContext;
};

const {
  module: learnModule,
  tracks,
  canonicalTracks,
  prerequisites,
  resourceGroups,
  featuredEmbed,
  labs,
  canonical,
  trackContext,
  globalTrackContext,
} = Astro.props;
const { Content } = await render(learnModule);
const genericObjectivePatterns = [
  /^Describe the main concepts for .+\.$/,
  /^Identify the artifact or checkpoint this module supports\.$/,
];
const hasCustomLearningObjectives = learnModule.data.learningObjectives.some(
  (objective) => !genericObjectivePatterns.some((pattern) => pattern.test(objective)),
);
const visibleResourceGroups = resourceGroups.filter((group) => group.items.length > 0);
const requiredGroup = visibleResourceGroups.find((group) => group.role === "required");
const requiredStepCount = requiredGroup?.items.length ?? 0;
const optionalGroups = visibleResourceGroups.filter((group) => group.role !== "required");
type SupplementalResourceKind = "optional" | "deeper" | "off_ramp" | "under_review";
const supplementalSectionLabels: Record<SupplementalResourceKind, string> = {
  optional: "Optional resources",
  deeper: "Go deeper",
  off_ramp: "Off-ramp resources",
  under_review: "Under review",
};
const supplementalSectionText: Record<SupplementalResourceKind, string> = {
  optional: "Use these after the required steps when they help with the same module checkpoint.",
  deeper: "Direct-open material for learners who want more depth without leaving the AIV path.",
  off_ramp: "Helpful links that need an account, course context, product commitment, or another extra step.",
  under_review: "Secondary links kept visible while source details or review status are still being checked.",
};
const supplementalSectionOrder: SupplementalResourceKind[] = ["optional", "deeper", "off_ramp", "under_review"];
const moduleTitle = learnModule.data.title;
const breadcrumbTrack = trackContext?.track;
const requiredCheckpointSource = requiredGroup?.items.find((item) => item.resource.data.checkpointPrompt)
  || requiredGroup?.items.find((item) => item.note)
  || requiredGroup?.items.find((item) => item.resource.data.watchFocus);
const checkpointPrompt = requiredCheckpointSource?.resource.data.checkpointPrompt
  || requiredCheckpointSource?.note
  || requiredCheckpointSource?.resource.data.watchFocus
  || (learnModule.data.requiredArtifact
    ? `Create this artifact: ${learnModule.data.requiredArtifact}. Capture the key decision, evidence, and review step from this lesson.`
    : "Beta checkpoint: identify the artifact this module should produce, then write the smallest useful version before moving on.");
const hasSecurityLensText = learnModule.data.securityLensText.trim().length > 0;
const artifactGuideTrack = trackContext?.track || globalTrackContext?.track || canonicalTracks[0];
const artifactFields = artifactFieldsForModule(learnModule, artifactGuideTrack);
const evidenceExpected = [
  "The artifact named above, written in your own context.",
  "One resource, lab, log, sample, or source note that supports it.",
  "One limitation, review question, or owner before using it downstream.",
];

function accessLabel(resource: CollectionEntry<"learnResources">) {
  return accessModeLabels[resource.data.accessMode] || accessModeLabels.direct_open;
}

function actionLabel(resource: CollectionEntry<"learnResources">) {
  if (resource.data.mediaType === "video" || resource.data.resourceType === "video" || resource.data.mediaType === "playlist") return "Watch";
  if (resource.data.resourceType === "lab") return "Practice";
  if (resource.data.resourceType === "tool" || resource.data.resourceType === "repo") return "Build checkpoint";
  return "Read";
}

function isUnderReview(resource: CollectionEntry<"learnResources">) {
  return resource.data.reviewStatus !== "accepted";
}

function isOffRampResource(resource: CollectionEntry<"learnResources">) {
  return resource.data.accessMode !== "direct_open" || resource.data.loginRequired || resource.data.cost !== "free";
}

function isAivTemplateResource(resource: CollectionEntry<"learnResources">) {
  return resource.data.provider === "AI Village Learn" &&
    resource.data.rightsMode === "internal" &&
    resource.data.reviewStatus === "accepted" &&
    resource.data.status !== "draft" &&
    resource.data.accessMode === "direct_open" &&
    !resource.data.loginRequired &&
    resource.data.cost === "free" &&
    /template/i.test(resource.data.title);
}

function supplementalKind(resource: CollectionEntry<"learnResources">, role: ResourceGroup["role"]): SupplementalResourceKind {
  if (isUnderReview(resource)) return "under_review";
  if (isOffRampResource(resource)) return "off_ramp";
  if (role === "deeper") return "deeper";
  return "optional";
}

function resourceFraming(item: ResourceItem) {
  return item.note || item.resource.data.watchFocus || item.resource.data.checkpointPrompt || "";
}

function moduleHref(module: CollectionEntry<"learnModules">) {
  return trackContext ? trackScopedModulePath(trackContext.track, module) : modulePath(module);
}

function trackModuleHref(track: CollectionEntry<"learnTracks">) {
  return trackScopedModulePath(track, learnModule);
}

function isFeaturedResourceItem(item: ResourceItem) {
  return Boolean(featuredEmbed && featuredEmbed.resource.id === item.resource.id && featuredEmbed.sourceIndex === item.sourceIndex);
}

function resourceSupportText(item: ResourceItem) {
  return resourceFraming(item) || `Use this ${formatLabel(item.resource.data.resourceType).toLowerCase()} to support the ${learnModule.data.requiredArtifact || "module checkpoint"}.`;
}

const supplementalSections = supplementalSectionOrder
  .map((kind) => ({
    kind,
    title: supplementalSectionLabels[kind],
    text: supplementalSectionText[kind],
    items: optionalGroups.flatMap((group) =>
      group.items
        .filter((item) => supplementalKind(item.resource, group.role) === kind)
        .map((item) => ({ item })),
    ),
  }))
  .filter((section) => section.items.length > 0);
const templateResourceItem = visibleResourceGroups
  .filter((group) => group.role === "required" || group.role === "optional")
  .flatMap((group) => group.items)
  .find((item) => isAivTemplateResource(item.resource));
const templateResource = templateResourceItem
  ? {
      title: templateResourceItem.resource.data.title,
      href: resourcePath(templateResourceItem.resource),
    }
  : undefined;
---

<BaseLayout title={moduleTitle} canonical={canonical} description={learnModule.data.summary}>
  <PageShell class="learn-module-page">
    <nav class="learn-breadcrumb" aria-label="Breadcrumb">
      <a href="/learn/">Learn</a>
      {" / "}
      {breadcrumbTrack ? <a href={trackPath(breadcrumbTrack)}>{breadcrumbTrack.data.title}</a> : <span>Modules</span>}
      {" / "}
      <span>{moduleTitle}</span>
    </nav>

    <header class="learn-module-header">
      <div>
        <div class="learn-meta-row">
          {trackContext && <span>Module {trackContext.moduleIndex + 1} of {trackContext.moduleCount} · {trackContext.track.data.title}</span>}
          {globalTrackContext && <span>Module {globalTrackContext.moduleIndex + 1} of {globalTrackContext.moduleCount} · {globalTrackContext.track.data.title}</span>}
          <DifficultyBadge value={learnModule.data.difficulty} />
          <span>{moduleTypeLabels[learnModule.data.moduleType]}</span>
        </div>
        <h1>{moduleTitle}</h1>
        <p class="text-lead">{learnModule.data.summary}</p>
      </div>
      <aside class:list={["learn-side-panel", trackContext && "learn-side-panel--track-context"]} data-track-context={trackContext ? "true" : undefined}>
        <h2>{trackContext ? "Track Context" : "Related Tracks"}</h2>
        {trackContext ? (
          <>
            <p class="learn-side-panel__desktop">Continue through this module inside {trackContext.track.data.title}.</p>
            <p class="learn-track-context-summary">{trackContext.track.data.title} · Module {trackContext.moduleIndex + 1} of {trackContext.moduleCount}</p>
            <a href={trackPath(trackContext.track)}>Back to track</a>
          </>
        ) : (
          <ul>
            {
              tracks.map((track) => (
                <li>
                  {canRenderLearnTrack(track) ? <a href={trackPath(track)}>{track.data.title}</a> : track.data.title}
                </li>
              ))
            }
          </ul>
        )}
      </aside>
    </header>

    {requiredGroup && (
      <section class:list={["learn-start-here", requiredStepCount === 1 && "learn-start-here--single"]} aria-labelledby="start-here-heading">
        <div class="learn-section-heading">
          <div>
            <span class="learn-kicker">Required path</span>
            <h2 id="start-here-heading">Start Here</h2>
          </div>
          <p>Use these steps first, then produce the checkpoint artifact before moving on.</p>
        </div>
        <div class:list={["learn-step-list", requiredStepCount === 1 ? "learn-step-list--single" : "learn-step-list--sequence"]}>
          {requiredGroup.items.map((item, index) => {
            const resource = item.resource;
            const framing = resourceSupportText(item);
            const isFeatured = isFeaturedResourceItem(item);
            const stepLabel = requiredStepCount === 1 ? "First action" : `Step ${item.step ?? index + 1}`;
            return (
              <article class:list={["learn-step-card", requiredStepCount === 1 && "learn-step-card--primary", isFeatured && "learn-step-card--has-embed"]}>
                <div class="learn-step-card__number">{stepLabel}</div>
                <div class="learn-step-card__body">
                  <div class="learn-step-card__content">
                    <span class="learn-step-card__action">{actionLabel(resource)}</span>
                    <h3><a href={resourcePath(resource)}>{resource.data.title}</a></h3>
                    <p>{framing}</p>
                    <div class="learn-step-card__meta">
                      <span>{resource.data.provider}</span>
                      <span>{formatLabel(resource.data.resourceType)}</span>
                      <span class="learn-access-badge">{accessLabel(resource)}</span>
                      {isUnderReview(resource) && <span class="learn-access-badge learn-access-badge--review">Under review</span>}
                    </div>
                    <div class="learn-step-card__actions">
                      <a class="learn-step-card__action-link learn-step-card__action-link--secondary" href={resourcePath(resource)}>View AIV notes</a>
                      <a class="learn-step-card__action-link learn-step-card__action-link--primary" href={resource.data.canonicalUrl} target="_blank" rel="noopener noreferrer">Open original</a>
                    </div>
                  </div>
                  {isFeatured && (
                    <div class="learn-step-card__embed">
                      <YouTubeEmbed
                        title={resource.data.title}
                        creator={resource.data.creator || resource.data.attribution || resource.data.provider}
                        canonicalUrl={resource.data.canonicalUrl}
                        channelUrl={resource.data.channelUrl}
                        videoId={resource.data.videoId}
                        playlistId={resource.data.playlistId}
                        playlistUrl={resource.data.playlistUrl}
                        mediaType={resource.data.mediaType || resource.data.resourceType}
                        embedPrivacyMode={resource.data.embedPrivacyMode}
                      />
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <section class="learn-content-body learn-lesson-notes">
      <Content />
    </section>

    {hasCustomLearningObjectives && (
      <section class="learn-objectives-section">
        <h2>Learning Objectives</h2>
        <ul>
          {learnModule.data.learningObjectives.map((objective) => <li>{objective}</li>)}
        </ul>
      </section>
    )}

    {prerequisites.length > 0 && (
      <section class="learn-compact-section">
        <h2>Prerequisites</h2>
        <ul>
          {prerequisites.map((prerequisite) => <li><a href={moduleHref(prerequisite)}>{prerequisite.data.title}</a></li>)}
        </ul>
      </section>
    )}

    <ArtifactGuide
      title={learnModule.data.requiredArtifact || "Module checkpoint"}
      prompt={checkpointPrompt}
      evidenceExpected={evidenceExpected}
      fields={artifactFields}
      templateResource={templateResource}
      relatedTrackTitle={artifactGuideTrack?.data.title}
      relatedModuleTitle={learnModule.data.title}
    />

    {hasSecurityLensText && (
      <section class="learn-security-panel">
        <span class="learn-kicker">Security Lens: review your artifact</span>
        <h2>Review before you move on</h2>
        <p>{learnModule.data.securityLensText}</p>
      </section>
    )}

    {labs.length > 0 && (
      <section class="learn-lab-section">
        <div class="learn-section-heading">
          <div>
            <span class="learn-kicker">Practice</span>
            <h2>Practice this with...</h2>
          </div>
          <p>Use the lab boundary and expected artifact before opening source material.</p>
        </div>
        <div class="learn-grid">
          {labs.map((lab) => <LabCard lab={lab} usedInModuleTitle={learnModule.data.title} usedInModuleHref={moduleHref(learnModule)} />)}
        </div>
      </section>
    )}

    {supplementalSections.map((section) => (
      <section class:list={["learn-resource-section", `learn-resource-section--${section.kind}`]}>
        <div class="learn-section-heading">
          <div>
            <span class="learn-kicker">Support</span>
            <h2>{section.title}</h2>
          </div>
          <p>{section.text}</p>
        </div>
        <div class="learn-resource-card-list">
          {section.items.map(({ item }) => {
            const resource = item.resource;
            const framing = resourceSupportText(item);
            return (
              <article class="learn-resource-card">
                <div>
                  <span class="learn-step-card__action">{actionLabel(resource)}</span>
                  <h3><a href={resourcePath(resource)}>{resource.data.title}</a></h3>
                  <p>{framing}</p>
                </div>
                <div class="learn-step-card__meta">
                  <span>{resource.data.provider}</span>
                  <span>{formatLabel(resource.data.resourceType)}</span>
                  {(resource.data.accessMode !== "direct_open" || isOffRampResource(resource)) && (
                    <span class="learn-access-badge">{accessLabel(resource)}</span>
                  )}
                  {section.kind === "off_ramp" && <span class="learn-access-badge">Off-ramp</span>}
                  {section.kind === "under_review" && <span class="learn-access-badge learn-access-badge--review">Under review</span>}
                </div>
                <div class="learn-step-card__actions">
                  <a href={resourcePath(resource)}>View AIV notes</a>
                  <a href={resource.data.canonicalUrl} target="_blank" rel="noopener noreferrer">Open original</a>
                </div>
                {isFeaturedResourceItem(item) && (
                  <div class="learn-step-card__embed">
                    <YouTubeEmbed
                      title={resource.data.title}
                      creator={resource.data.creator || resource.data.attribution || resource.data.provider}
                      canonicalUrl={resource.data.canonicalUrl}
                      channelUrl={resource.data.channelUrl}
                      videoId={resource.data.videoId}
                      playlistId={resource.data.playlistId}
                      playlistUrl={resource.data.playlistUrl}
                      mediaType={resource.data.mediaType || resource.data.resourceType}
                      embedPrivacyMode={resource.data.embedPrivacyMode}
                    />
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </section>
    ))}

    <section class="learn-navigation-panel" aria-label="Module navigation">
      {trackContext ? (
        <>
          <h2>Continue in {trackContext.track.data.title}</h2>
          <div class="learn-module-nav">
            <div class="learn-module-nav__item">
              <span>Previous module</span>
              {trackContext.previousModule ? (
                <a href={trackScopedModulePath(trackContext.track, trackContext.previousModule)}>{trackContext.previousModule.data.title}</a>
              ) : (
                <p class="text-muted">This is the first module in the track.</p>
              )}
            </div>
            <div class="learn-module-nav__item learn-module-nav__item--next">
              <span>Next module</span>
              {trackContext.nextModule ? (
                <a href={trackScopedModulePath(trackContext.track, trackContext.nextModule)}>{trackContext.nextModule.data.title}</a>
              ) : (
                <p class="text-muted">This is the final module in the track.</p>
              )}
            </div>
            <div class="learn-module-nav__item">
              <span>Track</span>
              <a href={trackPath(trackContext.track)}>Back to {trackContext.track.data.title}</a>
            </div>
          </div>
        </>
      ) : canonicalTracks.length > 1 ? (
        <>
          <h2>Continue this module in a track</h2>
          <p class="text-muted">This module belongs to multiple public paths. Choose a track to get the right next module.</p>
          <ul class="learn-link-list">
            {canonicalTracks.map((track) => <li><a href={trackModuleHref(track)}>{track.data.title}</a></li>)}
          </ul>
        </>
      ) : globalTrackContext ? (
        <>
          <h2>Continue in {globalTrackContext.track.data.title}</h2>
          <div class="learn-module-nav">
            <div class="learn-module-nav__item">
              <span>Previous module</span>
              {globalTrackContext.previousModule ? (
                <a href={trackScopedModulePath(globalTrackContext.track, globalTrackContext.previousModule)}>{globalTrackContext.previousModule.data.title}</a>
              ) : (
                <p class="text-muted">This is the first module in the track.</p>
              )}
            </div>
            <div class="learn-module-nav__item learn-module-nav__item--next">
              <span>Next module</span>
              {globalTrackContext.nextModule ? (
                <a href={trackScopedModulePath(globalTrackContext.track, globalTrackContext.nextModule)}>{globalTrackContext.nextModule.data.title}</a>
              ) : (
                <p class="text-muted">This is the final module in the track.</p>
              )}
            </div>
            <div class="learn-module-nav__item">
              <span>Track context</span>
              <a href={trackModuleHref(globalTrackContext.track)}>Open in {globalTrackContext.track.data.title}</a>
            </div>
          </div>
        </>
      ) : tracks.length > 0 ? (
        <>
          <h2>Continue learning</h2>
          <ul class="learn-link-list">
            {tracks.filter(canRenderLearnTrack).map((track) => <li><a href={trackPath(track)}>{track.data.title}</a></li>)}
          </ul>
        </>
      ) : (
        <>
          <h2>Continue learning</h2>
          <p><a href="/learn/">Back to Learn</a></p>
        </>
      )}
    </section>
  </PageShell>
</BaseLayout>

<style>
  .learn-module-page {
    display: grid;
    gap: 2.1rem;
  }

  .learn-breadcrumb,
  .learn-meta-row {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .learn-module-header {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
  }

  .learn-side-panel,
  .learn-compact-section,
  .learn-navigation-panel {
    background: color-mix(in srgb, var(--aiv-nested-bg) 82%, transparent);
    border: 1px solid var(--aiv-line-subtle);
    border-radius: 8px;
    padding: 1rem;
  }

  .learn-side-panel h2,
  .learn-compact-section h2,
  .learn-navigation-panel h2 {
    font-size: 1.1rem;
    margin-top: 0;
  }

  .learn-side-panel ul,
  .learn-compact-section ul,
  .learn-link-list {
    display: grid;
    gap: 0.65rem;
    margin-bottom: 0;
    padding-left: 1.2rem;
  }

  .learn-track-context-summary {
    display: none;
  }

  .learn-grid,
  .learn-module-nav,
  .learn-resource-card-list,
  .learn-step-list {
    display: grid;
    gap: 0.75rem;
  }

  .learn-module-nav {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .learn-module-nav__item {
    display: grid;
    gap: 0.2rem;
  }

  .learn-section-heading {
    align-items: end;
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(12rem, max-content) minmax(18rem, 62ch);
    justify-content: space-between;
  }

  .learn-section-heading h2,
  .learn-section-heading p {
    margin: 0;
  }

  .learn-section-heading p {
    color: var(--aiv-text-muted);
    max-width: 62ch;
    min-width: 0;
  }

  .learn-section-heading h2 {
    white-space: nowrap;
  }

  .learn-start-here {
    background: color-mix(in srgb, var(--aiv-action-primary) 8%, var(--aiv-bg-panel));
    border: 1px solid color-mix(in srgb, var(--aiv-action-primary) 62%, var(--aiv-line-subtle));
    border-left: 4px solid var(--aiv-action-primary);
    border-radius: 8px;
    display: grid;
    gap: 1rem;
    min-width: 0;
    padding: 1.2rem;
  }

  .learn-start-here .learn-step-list {
    grid-template-columns: minmax(0, 1fr);
  }

  .learn-start-here--single .learn-section-heading {
    align-items: center;
  }

  .learn-step-card,
  .learn-resource-card {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-radius: 8px;
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
  }

  .learn-step-card {
    grid-template-columns: auto minmax(0, 1fr);
    min-width: min(100%, 22rem);
  }

  .learn-start-here .learn-step-card {
    background: color-mix(in srgb, var(--aiv-bg-panel) 68%, transparent);
    border-color: color-mix(in srgb, var(--aiv-action-primary) 28%, var(--aiv-line-subtle));
    box-shadow: none;
  }

  .learn-start-here--single .learn-step-card {
    background: transparent;
    border-color: transparent;
    padding: 0.25rem 0 0;
  }

  .learn-step-card__number {
    align-items: center;
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 999px;
    color: var(--aiv-text-primary);
    display: inline-flex;
    font-weight: 800;
    height: 3rem;
    justify-content: center;
    line-height: 1.15;
    text-align: center;
    width: 4.2rem;
  }

  .learn-step-card--primary .learn-step-card__number {
    background: var(--aiv-action-primary);
    border-color: var(--aiv-action-primary);
    border-radius: 6px;
    color: var(--aiv-bg-canvas);
    height: auto;
    min-height: 2.75rem;
    padding: 0 0.65rem;
    width: auto;
  }

  .learn-step-card__body,
  .learn-step-card__content,
  .learn-resource-card {
    min-width: 0;
  }

  .learn-step-card__body,
  .learn-step-card__content,
  .learn-step-card__embed {
    display: grid;
    gap: 0.75rem;
  }

  .learn-step-card--has-embed .learn-step-card__body {
    align-items: start;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 360px);
  }

  .learn-step-card h3,
  .learn-resource-card h3,
  .learn-step-card p,
  .learn-resource-card p {
    margin: 0;
  }

  .learn-step-card h3,
  .learn-resource-card h3 {
    font-size: 1.18rem;
    line-height: 1.25;
  }

  .learn-step-card__action {
    color: var(--aiv-action-secondary);
    font-family: var(--aiv-font-mono);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .learn-step-card__actions,
  .learn-step-card__meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

