---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageShell from "../layout/PageShell.astro";
import ArtifactBadge from "./ArtifactBadge.astro";
import DifficultyBadge from "./DifficultyBadge.astro";
import LabCard from "./LabCard.astro";
import SecurityLensCallout from "./SecurityLensCallout.astro";
import StageBadge from "./StageBadge.astro";
import StatusBadge from "./StatusBadge.astro";
import YouTubeEmbed from "./YouTubeEmbed.astro";
import {
  accessModeLabels,
  canRenderLearnTrack,
  formatLabel,
  modulePath,
  moduleTypeLabels,
  resourcePath,
  trackPath,
  trackScopedModulePath,
} from "../../utils/learn";

type ResourceGroup = {
  role: "required" | "optional" | "deeper";
  heading: string;
  items: ResourceItem[];
};

type ResourceItem = {
  resource: CollectionEntry<"learnResources">;
  step?: number;
  note?: string;
  sourceIndex: number;
};

type TrackContext = {
  track: CollectionEntry<"learnTracks">;
  moduleIndex: number;
  moduleCount: number;
  previousModule?: CollectionEntry<"learnModules">;
  nextModule?: CollectionEntry<"learnModules">;
};

type Props = {
  module: CollectionEntry<"learnModules">;
  tracks: CollectionEntry<"learnTracks">[];
  canonicalTracks: CollectionEntry<"learnTracks">[];
  prerequisites: CollectionEntry<"learnModules">[];
  resourceGroups: ResourceGroup[];
  featuredEmbed?: ResourceItem;
  labs: CollectionEntry<"learnLabs">[];
  canonical: string;
  trackContext?: TrackContext;
  globalTrackContext?: TrackContext;
};

const {
  module: learnModule,
  tracks,
  canonicalTracks,
  prerequisites,
  resourceGroups,
  featuredEmbed,
  labs,
  canonical,
  trackContext,
  globalTrackContext,
} = Astro.props;
const { Content } = await render(learnModule);
const genericObjectivePatterns = [
  /^Describe the main concepts for .+\.$/,
  /^Identify the artifact or checkpoint this module supports\.$/,
];
const hasCustomLearningObjectives = learnModule.data.learningObjectives.some(
  (objective) => !genericObjectivePatterns.some((pattern) => pattern.test(objective)),
);
const visibleResourceGroups = resourceGroups.filter((group) => group.items.length > 0);
const requiredGroup = visibleResourceGroups.find((group) => group.role === "required");
const optionalGroups = visibleResourceGroups.filter((group) => group.role !== "required");
const moduleTitle = learnModule.data.title;
const breadcrumbTrack = trackContext?.track;
const requiredCheckpointSource = requiredGroup?.items.find((item) => item.resource.data.checkpointPrompt)
  || requiredGroup?.items.find((item) => item.note)
  || requiredGroup?.items.find((item) => item.resource.data.watchFocus);
const checkpointPrompt = requiredCheckpointSource?.resource.data.checkpointPrompt
  || requiredCheckpointSource?.note
  || requiredCheckpointSource?.resource.data.watchFocus
  || (learnModule.data.requiredArtifact
    ? `Create a ${learnModule.data.requiredArtifact} that captures the key decision, evidence, and review step from this lesson.`
    : "Beta checkpoint: identify the artifact this module should produce, then write the smallest useful version before moving on.");
const hasSecurityLensText = learnModule.data.securityLensText.trim().length > 0;

function accessLabel(resource: CollectionEntry<"learnResources">) {
  return accessModeLabels[resource.data.accessMode] || accessModeLabels.direct_open;
}

function actionLabel(resource: CollectionEntry<"learnResources">) {
  if (resource.data.mediaType === "video" || resource.data.resourceType === "video" || resource.data.mediaType === "playlist") return "Watch";
  if (resource.data.resourceType === "lab") return "Practice";
  if (resource.data.resourceType === "tool" || resource.data.resourceType === "repo") return "Build checkpoint";
  return "Read";
}

function isUnderReview(resource: CollectionEntry<"learnResources">) {
  return resource.data.reviewStatus !== "accepted";
}

function showOffRampBadge(resource: CollectionEntry<"learnResources">, role: ResourceGroup["role"]) {
  return role === "deeper" || resource.data.accessMode !== "direct_open" || resource.data.reviewStatus !== "accepted";
}

function resourceFraming(item: ResourceItem) {
  return item.note || item.resource.data.watchFocus || item.resource.data.checkpointPrompt || "";
}

function moduleHref(module: CollectionEntry<"learnModules">) {
  return trackContext ? trackScopedModulePath(trackContext.track, module) : modulePath(module);
}

function trackModuleHref(track: CollectionEntry<"learnTracks">) {
  return trackScopedModulePath(track, learnModule);
}
---

<BaseLayout title={moduleTitle} canonical={canonical} description={learnModule.data.summary}>
  <PageShell class="learn-module-page">
    <nav class="learn-breadcrumb" aria-label="Breadcrumb">
      <a href="/learn/">Learn</a>
      {" / "}
      {breadcrumbTrack ? <a href={trackPath(breadcrumbTrack)}>{breadcrumbTrack.data.title}</a> : <span>Modules</span>}
      {" / "}
      <span>{moduleTitle}</span>
    </nav>

    <header class="learn-module-header">
      <div>
        <div class="learn-meta-row">
          <StatusBadge value={learnModule.data.status} />
          {trackContext && <span>Module {trackContext.moduleIndex + 1} of {trackContext.moduleCount} · {trackContext.track.data.title}</span>}
          {globalTrackContext && <span>Module {globalTrackContext.moduleIndex + 1} of {globalTrackContext.moduleCount} · {globalTrackContext.track.data.title}</span>}
          <StageBadge value={learnModule.data.stageStart} />
          <span>to</span>
          <StageBadge value={learnModule.data.stageEnd} />
          <DifficultyBadge value={learnModule.data.difficulty} />
          <span>{moduleTypeLabels[learnModule.data.moduleType]}</span>
        </div>
        <h1>{moduleTitle}</h1>
        <p class="text-lead">{learnModule.data.summary}</p>
      </div>
      <aside class="learn-side-panel">
        <h2>{trackContext ? "Track Context" : "Related Tracks"}</h2>
        {trackContext ? (
          <>
            <p>Continue through this module inside {trackContext.track.data.title}.</p>
            <a href={trackPath(trackContext.track)}>Back to track</a>
          </>
        ) : (
          <ul>
            {
              tracks.map((track) => (
                <li>
                  {canRenderLearnTrack(track) ? <a href={trackPath(track)}>{track.data.title}</a> : track.data.title}
                </li>
              ))
            }
          </ul>
        )}
      </aside>
    </header>

    <section class="learn-content-body">
      <Content />
    </section>

    {requiredGroup && (
      <section class="learn-resource-group learn-start-here">
        <h2>Start here</h2>
        <ul>
          {requiredGroup.items.map((item) => {
            const resource = item.resource;
            const framing = resourceFraming(item);
            return (
              <li>
                {item.step && <span class="learn-step-marker">Step {item.step}</span>}
                <a href={resourcePath(resource)}>{resource.data.title}</a>
                <span>
                  {actionLabel(resource)} - {resource.data.provider} - {formatLabel(resource.data.resourceType)} -
                  <a href={resource.data.canonicalUrl} target="_blank" rel="noopener noreferrer"> Open original</a>
                  {" "}
                  <span class="learn-access-badge">{accessLabel(resource)}</span>
                  {isUnderReview(resource) && <span class="learn-access-badge">Under review</span>}
                </span>
                {framing && <p>{framing}</p>}
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {featuredEmbed && (
      <section>
        <h2>Featured Resource</h2>
        <div class="learn-featured-embed">
          <YouTubeEmbed
            title={featuredEmbed.resource.data.title}
            creator={featuredEmbed.resource.data.creator || featuredEmbed.resource.data.attribution || featuredEmbed.resource.data.provider}
            canonicalUrl={featuredEmbed.resource.data.canonicalUrl}
            channelUrl={featuredEmbed.resource.data.channelUrl}
            videoId={featuredEmbed.resource.data.videoId}
            playlistId={featuredEmbed.resource.data.playlistId}
            playlistUrl={featuredEmbed.resource.data.playlistUrl}
            mediaType={featuredEmbed.resource.data.mediaType || featuredEmbed.resource.data.resourceType}
            embedPrivacyMode={featuredEmbed.resource.data.embedPrivacyMode}
          />
        </div>
      </section>
    )}

    {hasCustomLearningObjectives && (
      <section class="learn-compact-section">
        <h2>Learning Objectives</h2>
        <ul>
          {learnModule.data.learningObjectives.map((objective) => <li>{objective}</li>)}
        </ul>
      </section>
    )}

    {prerequisites.length > 0 && (
      <section class="learn-compact-section">
        <h2>Prerequisites</h2>
        <ul>
          {prerequisites.map((prerequisite) => <li><a href={moduleHref(prerequisite)}>{prerequisite.data.title}</a></li>)}
        </ul>
      </section>
    )}

    <section class="learn-checkpoint-card">
      <div>
        <span class="learn-kicker">Checkpoint</span>
        <h2>{learnModule.data.requiredArtifact || "Module checkpoint"}</h2>
        <p>{checkpointPrompt}</p>
      </div>
      {learnModule.data.requiredArtifact && <ArtifactBadge value={learnModule.data.requiredArtifact} />}
    </section>

    {hasSecurityLensText && (
      <section class="learn-security-section">
        <p class="text-muted">Before you move on, review this artifact through the Security Lens.</p>
        <SecurityLensCallout lens={learnModule.data.securityLens} text={learnModule.data.securityLensText} />
      </section>
    )}

    {labs.length > 0 && (
      <section>
        <h2>Practice this with...</h2>
        <div class="learn-grid">{labs.map((lab) => <LabCard lab={lab} />)}</div>
      </section>
    )}

    {optionalGroups.map((group) => (
      <section class="learn-resource-group">
        <h2>{group.heading}</h2>
        <ul>
          {group.items.map((item) => {
            const resource = item.resource;
            const framing = resourceFraming(item);
            return (
              <li>
                <a href={resourcePath(resource)}>{resource.data.title}</a>
                <span>
                  {actionLabel(resource)} - {resource.data.provider} - {formatLabel(resource.data.resourceType)} -
                <a href={resource.data.canonicalUrl} target="_blank" rel="noopener noreferrer"> Open original</a>
                {" "}
                {(resource.data.accessMode !== "direct_open" || isUnderReview(resource)) && <span class="learn-access-badge">{accessLabel(resource)}</span>}
                {showOffRampBadge(resource, group.role) && <span class="learn-access-badge">Extra/off-ramp</span>}
                  {isUnderReview(resource) && <span class="learn-access-badge">Under review</span>}
                </span>
                {framing && <p>{framing}</p>}
              </li>
            );
          })}
        </ul>
      </section>
    ))}

    <section class="learn-navigation-panel" aria-label="Module navigation">
      {trackContext ? (
        <>
          <h2>Continue in {trackContext.track.data.title}</h2>
          <div class="learn-module-nav">
            <div>
              <span>Previous module</span>
              {trackContext.previousModule ? (
                <a href={trackScopedModulePath(trackContext.track, trackContext.previousModule)}>{trackContext.previousModule.data.title}</a>
              ) : (
                <p class="text-muted">This is the first module in the track.</p>
              )}
            </div>
            <div>
              <span>Next module</span>
              {trackContext.nextModule ? (
                <a href={trackScopedModulePath(trackContext.track, trackContext.nextModule)}>{trackContext.nextModule.data.title}</a>
              ) : (
                <p class="text-muted">This is the final module in the track.</p>
              )}
            </div>
            <div>
              <span>Track</span>
              <a href={trackPath(trackContext.track)}>Back to {trackContext.track.data.title}</a>
            </div>
          </div>
        </>
      ) : canonicalTracks.length > 1 ? (
        <>
          <h2>Continue this module in a track</h2>
          <p class="text-muted">This module belongs to multiple public paths. Choose a track to get the right next module.</p>
          <ul class="learn-link-list">
            {canonicalTracks.map((track) => <li><a href={trackModuleHref(track)}>{track.data.title}</a></li>)}
          </ul>
        </>
      ) : globalTrackContext ? (
        <>
          <h2>Continue in {globalTrackContext.track.data.title}</h2>
          <div class="learn-module-nav">
            <div>
              <span>Previous module</span>
              {globalTrackContext.previousModule ? (
                <a href={trackScopedModulePath(globalTrackContext.track, globalTrackContext.previousModule)}>{globalTrackContext.previousModule.data.title}</a>
              ) : (
                <p class="text-muted">This is the first module in the track.</p>
              )}
            </div>
            <div>
              <span>Next module</span>
              {globalTrackContext.nextModule ? (
                <a href={trackScopedModulePath(globalTrackContext.track, globalTrackContext.nextModule)}>{globalTrackContext.nextModule.data.title}</a>
              ) : (
                <p class="text-muted">This is the final module in the track.</p>
              )}
            </div>
            <div>
              <span>Track context</span>
              <a href={trackModuleHref(globalTrackContext.track)}>Open in {globalTrackContext.track.data.title}</a>
            </div>
          </div>
        </>
      ) : tracks.length > 0 ? (
        <>
          <h2>Continue learning</h2>
          <ul class="learn-link-list">
            {tracks.filter(canRenderLearnTrack).map((track) => <li><a href={trackPath(track)}>{track.data.title}</a></li>)}
          </ul>
        </>
      ) : (
        <>
          <h2>Continue learning</h2>
          <p><a href="/learn/">Back to Learn</a></p>
        </>
      )}
    </section>
  </PageShell>
</BaseLayout>

<style>
  .learn-module-page {
    display: grid;
    gap: 2rem;
  }

  .learn-breadcrumb,
  .learn-meta-row {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .learn-module-header {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
  }

  .learn-side-panel,
  .learn-resource-group,
  .learn-compact-section,
  .learn-checkpoint-card,
  .learn-navigation-panel {
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 8px;
    padding: 1rem;
  }

  .learn-side-panel h2,
  .learn-resource-group h2,
  .learn-compact-section h2,
  .learn-navigation-panel h2 {
    font-size: 1.1rem;
    margin-top: 0;
  }

  .learn-side-panel ul,
  .learn-resource-group ul,
  .learn-compact-section ul,
  .learn-link-list {
    display: grid;
    gap: 0.65rem;
    margin-bottom: 0;
    padding-left: 1.2rem;
  }

  .learn-resource-groups,
  .learn-featured-embed,
  .learn-grid,
  .learn-module-nav {
    display: grid;
    gap: 0.75rem;
  }

  .learn-resource-groups,
  .learn-module-nav {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .learn-resource-group li,
  .learn-module-nav > div {
    display: grid;
    gap: 0.2rem;
  }

  .learn-checkpoint-card {
    align-items: start;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .learn-checkpoint-card h2 {
    margin-bottom: 0.4rem;
    margin-top: 0.2rem;
  }

  .learn-kicker,
  .learn-step-marker {
    color: var(--aiv-text-muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .learn-security-section {
    display: grid;
    gap: 0.5rem;
  }

  .learn-access-badge {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-radius: 999px;
    color: var(--aiv-text);
    display: inline-flex;
    font-size: 0.78rem;
    margin-left: 0.25rem;
    padding: 0.08rem 0.4rem;
  }

  .learn-resource-group span,
  .learn-module-nav span {
    color: var(--aiv-text-muted);
    font-size: 0.9rem;
  }

  .learn-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .learn-content-body {
    max-width: 76ch;
  }

  @media (max-width: 780px) {
    .learn-module-header {
      grid-template-columns: 1fr;
    }

    .learn-checkpoint-card {
      display: grid;
    }
  }
</style>
