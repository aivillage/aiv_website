---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageShell from "../layout/PageShell.astro";
import ArtifactGuide from "./ArtifactGuide.astro";
import CompactPathNav from "./CompactPathNav.astro";
import LessonStep from "./LessonStep.astro";
import LessonTaskHeader from "./LessonTaskHeader.astro";
import SecurityReview from "./SecurityReview.astro";
import {
  accessModeLabels,
  artifactFieldsForModule,
  formatLabel,
  labPath,
  modulePath,
  resourcePath,
  trackPath,
  trackScopedModulePath,
} from "../../utils/learn";

type ResourceGroup = {
  role: "required" | "optional" | "deeper";
  heading: string;
  items: ResourceItem[];
};

type ResourceItem = {
  resource: CollectionEntry<"learnResources">;
  step?: number;
  note?: string;
  sourceIndex: number;
};

type TrackContext = {
  track: CollectionEntry<"learnTracks">;
  moduleIndex: number;
  moduleCount: number;
  previousModule?: CollectionEntry<"learnModules">;
  nextModule?: CollectionEntry<"learnModules">;
};

type JumpLink = {
  href: string;
  label: string;
};

type Props = {
  module: CollectionEntry<"learnModules">;
  tracks: CollectionEntry<"learnTracks">[];
  canonicalTracks: CollectionEntry<"learnTracks">[];
  prerequisites: CollectionEntry<"learnModules">[];
  resourceGroups: ResourceGroup[];
  featuredEmbed?: ResourceItem;
  labs: CollectionEntry<"learnLabs">[];
  canonical: string;
  trackContext?: TrackContext;
  globalTrackContext?: TrackContext;
};

const {
  module: learnModule,
  tracks,
  canonicalTracks,
  prerequisites,
  resourceGroups,
  featuredEmbed,
  labs,
  canonical,
  trackContext,
  globalTrackContext,
} = Astro.props;
const { Content } = await render(learnModule);
const genericObjectivePatterns = [
  /^Describe the main concepts for .+\.$/,
  /^Identify the artifact or checkpoint this module supports\.$/,
];
const hasCustomLearningObjectives = learnModule.data.learningObjectives.some(
  (objective) => !genericObjectivePatterns.some((pattern) => pattern.test(objective)),
);
const visibleResourceGroups = resourceGroups.filter((group) => group.items.length > 0);
const requiredGroup = visibleResourceGroups.find((group) => group.role === "required");
const optionalGroups = visibleResourceGroups.filter((group) => group.role !== "required");
type SupplementalResourceKind = "optional" | "deeper" | "off_ramp";
const supplementalSectionLabels: Record<SupplementalResourceKind, string> = {
  optional: "Optional resources",
  deeper: "Go deeper",
  off_ramp: "Off-ramp resources",
};
const supplementalSectionText: Record<SupplementalResourceKind, string> = {
  optional: "Use these after the required steps when they support the same checkpoint.",
  deeper: "Direct-open material for learners who want more depth without leaving the AIV path.",
  off_ramp: "Useful material that needs an account, course context, product commitment, review, or another extra step.",
};
const supplementalSectionOrder: SupplementalResourceKind[] = ["optional", "deeper", "off_ramp"];
const moduleTitle = learnModule.data.title;
const breadcrumbTrack = trackContext?.track;
const requiredCheckpointSource = requiredGroup?.items.find((item) => item.resource.data.checkpointPrompt)
  || requiredGroup?.items.find((item) => item.note)
  || requiredGroup?.items.find((item) => item.resource.data.watchFocus);
const checkpointPrompt = requiredCheckpointSource?.resource.data.checkpointPrompt
  || requiredCheckpointSource?.note
  || requiredCheckpointSource?.resource.data.watchFocus
  || (learnModule.data.requiredArtifact
    ? `Create this artifact: ${learnModule.data.requiredArtifact}. Capture the key decision, evidence, and review step from this lesson.`
    : "Beta checkpoint: identify the artifact this module should produce, then write the smallest useful version before moving on.");
const hasSecurityLensText = learnModule.data.securityLensText.trim().length > 0;
const artifactGuideTrack = trackContext?.track || globalTrackContext?.track || canonicalTracks[0];
const artifactFields = artifactFieldsForModule(learnModule, artifactGuideTrack);
const evidenceExpected = [
  "The artifact named above, written in your own context.",
  "One resource, lab, log, sample, or source note that supports it.",
  "One limitation, review question, or owner before using it downstream.",
];
const securityChecklist = artifactFields.filter((field) =>
  /evidence|owner|review|boundary|control|approval|scope|authorized|allowed|denied|audit|escalation|data|tool|risk/i.test(field),
);

function accessLabel(resource: CollectionEntry<"learnResources">) {
  return accessModeLabels[resource.data.accessMode] || accessModeLabels.direct_open;
}

function actionLabel(resource: CollectionEntry<"learnResources">) {
  if (/template/i.test(resource.data.title)) return "Use template";
  if (resource.data.mediaType === "video" || resource.data.resourceType === "video" || resource.data.mediaType === "playlist") return "Watch";
  if (resource.data.resourceType === "lab" || resource.data.resourceType === "tool" || resource.data.resourceType === "repo") return "Practice";
  return "Read";
}

function isUnderReview(resource: CollectionEntry<"learnResources">) {
  return resource.data.reviewStatus !== "accepted";
}

function hasOffRampAccess(resource: CollectionEntry<"learnResources">) {
  return resource.data.accessMode !== "direct_open" || resource.data.loginRequired || resource.data.cost !== "free";
}

function isCourseLikeOptional(resource: CollectionEntry<"learnResources">, role: ResourceGroup["role"]) {
  return role !== "deeper" && resource.data.resourceType === "course";
}

function isAivTemplateResource(resource: CollectionEntry<"learnResources">) {
  return resource.data.provider === "AI Village Learn" &&
    resource.data.rightsMode === "internal" &&
    resource.data.reviewStatus === "accepted" &&
    resource.data.status !== "draft" &&
    resource.data.accessMode === "direct_open" &&
    !resource.data.loginRequired &&
    resource.data.cost === "free" &&
    /template/i.test(resource.data.title);
}

function supplementalKind(resource: CollectionEntry<"learnResources">, role: ResourceGroup["role"]): SupplementalResourceKind {
  if (isUnderReview(resource) || hasOffRampAccess(resource) || isCourseLikeOptional(resource, role)) return "off_ramp";
  if (role === "deeper") return "deeper";
  return "optional";
}

function resourceFraming(item: ResourceItem) {
  return item.note || item.resource.data.watchFocus || item.resource.data.checkpointPrompt || "";
}

function moduleHref(module: CollectionEntry<"learnModules">) {
  if (trackContext) return trackScopedModulePath(trackContext.track, module);
  if (globalTrackContext) return trackScopedModulePath(globalTrackContext.track, module);
  return modulePath(module);
}

function isFeaturedResourceItem(item: ResourceItem) {
  return Boolean(featuredEmbed && featuredEmbed.resource.id === item.resource.id && featuredEmbed.sourceIndex === item.sourceIndex);
}

function resourceSupportText(item: ResourceItem) {
  return resourceFraming(item) || `Use this ${formatLabel(item.resource.data.resourceType).toLowerCase()} to support the ${learnModule.data.requiredArtifact || "module checkpoint"}.`;
}

const supplementalSections = supplementalSectionOrder
  .map((kind) => ({
    kind,
    title: supplementalSectionLabels[kind],
    text: supplementalSectionText[kind],
    items: optionalGroups.flatMap((group) =>
      group.items
        .filter((item) => supplementalKind(item.resource, group.role) === kind)
        .map((item) => ({ item })),
    ),
  }))
  .filter((section) => section.items.length > 0);
const templateResourceItem = visibleResourceGroups
  .filter((group) => group.role === "required" || group.role === "optional")
  .flatMap((group) => group.items)
  .find((item) => isAivTemplateResource(item.resource));
const templateResource = templateResourceItem
  ? {
      title: templateResourceItem.resource.data.title,
      href: resourcePath(templateResourceItem.resource),
    }
  : undefined;
const jumpLinks = [
  requiredGroup && { href: "#lesson-steps", label: "Steps" },
  { href: "#artifact-worksheet", label: "Worksheet" },
  hasSecurityLensText && { href: "#security-review", label: "Security" },
  labs.length > 0 && { href: "#practice", label: "Practice" },
].filter(Boolean) as JumpLink[];
---

<BaseLayout title={moduleTitle} canonical={canonical} description={learnModule.data.summary}>
  <PageShell class="learn-module-page" width="full">
    <div class="learn-module-page__inner">
      <nav class="learn-breadcrumb" aria-label="Breadcrumb">
        <a href="/learn/">Learn</a>
        {" / "}
        {breadcrumbTrack ? <a href={trackPath(breadcrumbTrack)}>{breadcrumbTrack.data.title}</a> : <span>Modules</span>}
        {" / "}
        <span>{moduleTitle}</span>
      </nav>

      <LessonTaskHeader
        module={learnModule}
        tracks={tracks}
        canonicalTracks={canonicalTracks}
        trackContext={trackContext}
        globalTrackContext={globalTrackContext}
        jumpLinks={jumpLinks}
      />

      <CompactPathNav
        module={learnModule}
        trackContext={trackContext}
        globalTrackContext={globalTrackContext}
        tracks={tracks}
        canonicalTracks={canonicalTracks}
        jumpLinks={jumpLinks}
        variant="mobile"
      />

      <section class="learn-mobile-artifact-summary learn-surface-worksheet" aria-labelledby="mobile-artifact-summary-heading">
        <span>You will produce</span>
        <h2 id="mobile-artifact-summary-heading">{learnModule.data.requiredArtifact || "Module checkpoint"}</h2>
        <p>{checkpointPrompt}</p>
      </section>

      <main class="learn-workbook-layout">
        {requiredGroup ? (
          <section id="lesson-steps" class="learn-steps-section learn-surface-task" aria-labelledby="lesson-steps-heading">
            <div class="learn-section-heading">
              <div>
                <span class="learn-kicker">Required path</span>
                <h2 id="lesson-steps-heading">Start with this action</h2>
              </div>
              <p>Do these required steps before reading the full notes or opening extra resources.</p>
            </div>
            <div class="learn-step-list">
              {requiredGroup.items.map((item, index) => (
                <LessonStep
                  item={item}
                  index={index}
                  totalSteps={requiredGroup.items.length}
                  moduleArtifact={learnModule.data.requiredArtifact}
                  isFeatured={isFeaturedResourceItem(item)}
                />
              ))}
            </div>
          </section>
        ) : (
          <section id="lesson-steps" class="learn-steps-section learn-surface-task" aria-labelledby="lesson-steps-heading">
            <div class="learn-section-heading">
              <div>
                <span class="learn-kicker">Required path</span>
                <h2 id="lesson-steps-heading">Required steps are being refined</h2>
              </div>
              <p>Use the worksheet and lesson notes below while this module checkpoint is completed.</p>
            </div>
          </section>
        )}

        <aside class="learn-workbook-rail" aria-label="Artifact worksheet and path navigation">
          <div class="learn-workbook-rail__sticky">
            <ArtifactGuide
              title={learnModule.data.requiredArtifact || "Module checkpoint"}
              prompt={checkpointPrompt}
              evidenceExpected={evidenceExpected}
              fields={artifactFields}
              templateResource={templateResource}
              relatedTrackTitle={artifactGuideTrack?.data.title}
              relatedModuleTitle={learnModule.data.title}
              compact
            />

            {hasSecurityLensText && (
              <SecurityReview
                lens={learnModule.data.securityLens}
                text={learnModule.data.securityLensText}
                checklist={securityChecklist}
              />
            )}

            <CompactPathNav
              module={learnModule}
              trackContext={trackContext}
              globalTrackContext={globalTrackContext}
              tracks={tracks}
              canonicalTracks={canonicalTracks}
              jumpLinks={jumpLinks}
              variant="rail"
            />
          </div>
        </aside>

          <section id="lesson-notes" class="learn-lesson-notes learn-surface-reference" aria-labelledby="lesson-notes-heading">
            <div class="learn-section-heading learn-section-heading--notes">
              <div>
                <span class="learn-kicker">Workbook notes</span>
                <h2 id="lesson-notes-heading">Lesson notes</h2>
              </div>
            </div>
            <div class="learn-content-body">
              <Content />
            </div>
          </section>

          {hasCustomLearningObjectives && (
            <details class="learn-disclosure learn-surface-reference">
              <summary>Learning objectives</summary>
              <ul>
                {learnModule.data.learningObjectives.map((objective) => <li>{objective}</li>)}
              </ul>
            </details>
          )}

          {prerequisites.length > 0 && (
            <section class="learn-prerequisites-strip" aria-labelledby="learn-prerequisites-heading">
              <h2 id="learn-prerequisites-heading">Prerequisites</h2>
              <ul>
                {prerequisites.map((prerequisite) => <li><a href={moduleHref(prerequisite)}>{prerequisite.data.title}</a></li>)}
              </ul>
            </section>
          )}

          {labs.length > 0 && (
            <section id="practice" class="learn-practice-panel learn-surface-exercise" aria-labelledby="practice-heading">
              <div class="learn-section-heading">
                <div>
                  <span class="learn-kicker">Practice</span>
                  <h2 id="practice-heading">Practice this with...</h2>
                </div>
                <p>Use the lab boundary and expected artifact after the required lesson step.</p>
              </div>
              <div class="learn-practice-list">
                {labs.map((lab) => (
                  <article class="learn-practice-item">
                    <div>
                      <div class="learn-practice-item__meta">
                        {lab.data.isOffensive && <span>Offensive toy lab</span>}
                        <span>{lab.data.estimatedMinutes} min</span>
                      </div>
                      <h3><a href={labPath(lab)}>{lab.data.title}</a></h3>
                      <p>{lab.data.summary}</p>
                    </div>
                    <dl>
                      <div>
                        <dt>Safety boundary</dt>
                        <dd>{lab.data.safetyBoundary}</dd>
                      </div>
                      <div>
                        <dt>Expected artifact</dt>
                        <dd>{lab.data.requiredArtifact}</dd>
                      </div>
                    </dl>
                    <a class="learn-practice-item__action" href={labPath(lab)}>Open lab</a>
                  </article>
                ))}
              </div>
            </section>
          )}

          {supplementalSections.length > 0 && (
            <section class="learn-more-resources learn-surface-reference" aria-labelledby="more-resources-heading">
              <div class="learn-section-heading">
                <div>
                  <span class="learn-kicker">Support</span>
                  <h2 id="more-resources-heading">More resources</h2>
                </div>
                <p>Optional, deeper, and off-ramp links stay available without competing with the workbook task.</p>
              </div>
              <div class="learn-more-resource-groups">
                {supplementalSections.map((section) => (
                  <details class:list={["learn-resource-disclosure", `learn-resource-disclosure--${section.kind}`]}>
                    <summary>
                      <span>{section.title}</span>
                      <small>{section.items.length} {section.items.length === 1 ? "resource" : "resources"}</small>
                    </summary>
                    <p>{section.text}</p>
                    <div class="learn-resource-row-list">
                      {section.items.map(({ item }) => {
                        const resource = item.resource;
                        const framing = resourceSupportText(item);
                        return (
                          <article class="learn-resource-row">
                            <div class="learn-resource-row__main">
                              <span class="learn-resource-row__action">{actionLabel(resource)}</span>
                              <h3><a href={resourcePath(resource)}>{resource.data.title}</a></h3>
                              <p>{framing}</p>
                            </div>
                            <div class="learn-resource-row__meta">
                              <span>{resource.data.provider}</span>
                              <span>{formatLabel(resource.data.resourceType)}</span>
                              <span class="learn-access-badge">{accessLabel(resource)}</span>
                              {section.kind === "off_ramp" && <span class="learn-access-badge">Off-ramp</span>}
                              {isUnderReview(resource) && <span class="learn-access-badge learn-access-badge--review">Under review</span>}
                            </div>
                            <div class="learn-resource-row__actions">
                              <a href={resourcePath(resource)}>View AIV notes</a>
                              <a href={resource.data.canonicalUrl} target="_blank" rel="noopener noreferrer">Open original</a>
                            </div>
                          </article>
                        );
                      })}
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )}
      </main>

      <CompactPathNav
        module={learnModule}
        trackContext={trackContext}
        globalTrackContext={globalTrackContext}
        tracks={tracks}
        canonicalTracks={canonicalTracks}
        jumpLinks={jumpLinks}
        variant="footer"
      />
    </div>
  </PageShell>
</BaseLayout>

<style>
  .learn-module-page {
    width: 100%;
  }

  .learn-module-page__inner {
    display: grid;
    gap: 1rem;
    margin-inline: auto;
    max-width: 1440px;
    min-width: 0;
  }

  .learn-breadcrumb {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .learn-workbook-layout {
    align-items: start;
    display: grid;
    gap: 1.1rem;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
    min-width: 0;
  }

  .learn-mobile-artifact-summary {
    display: none;
  }

  .learn-steps-section,
  .learn-lesson-notes,
  .learn-disclosure,
  .learn-prerequisites-strip,
  .learn-practice-panel,
  .learn-more-resources {
    grid-column: 1;
    min-width: 0;
  }

  .learn-workbook-rail {
    grid-column: 2;
    grid-row: 1 / span 8;
    min-width: 0;
  }

  .learn-workbook-rail__sticky {
    display: grid;
    gap: 0.78rem;
    position: sticky;
    top: 1rem;
  }

  .learn-section-heading {
    align-items: start;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(11rem, max-content) minmax(18rem, 62ch);
    justify-content: space-between;
  }

  .learn-section-heading h2,
  .learn-section-heading p {
    margin: 0;
  }

  .learn-section-heading h2 {
    font-size: clamp(1.28rem, 2vw, 1.72rem);
    line-height: 1.15;
    white-space: nowrap;
  }

  .learn-section-heading p {
    color: var(--aiv-text-muted);
    line-height: 1.42;
    max-width: 62ch;
    min-width: 0;
  }

  .learn-kicker {
    color: var(--aiv-text-muted);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .learn-steps-section,
  .learn-lesson-notes,
  .learn-practice-panel,
  .learn-more-resources {
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
  }

  .learn-step-list {
    display: grid;
    gap: 0.72rem;
  }

  .learn-lesson-notes {
    max-width: min(100%, 86ch);
  }

  .learn-section-heading--notes {
    grid-template-columns: 1fr;
  }

  .learn-content-body {
    min-width: 0;
  }

  .learn-content-body :global(h2:first-child),
  .learn-content-body :global(h3:first-child),
  .learn-content-body :global(p:first-child) {
    margin-top: 0;
  }

  .learn-disclosure {
    max-width: min(100%, 86ch);
    padding: 0.75rem 0.95rem;
  }

  .learn-disclosure summary {
    cursor: pointer;
    font-weight: 900;
    min-height: 2.4rem;
  }

  .learn-disclosure ul {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 0;
    padding-left: 1.15rem;
  }

  .learn-prerequisites-strip {
    align-items: center;
    border-top: 1px solid var(--aiv-line-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 0.9rem;
    max-width: min(100%, 86ch);
    padding-top: 0.2rem;
  }

  .learn-prerequisites-strip h2 {
    color: var(--aiv-text-muted);
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    margin: 0;
    text-transform: uppercase;
  }

  .learn-prerequisites-strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .learn-prerequisites-strip a {
    align-items: center;
    background: color-mix(in srgb, var(--aiv-bg-panel) 68%, transparent);
    border: 1px solid var(--aiv-line-subtle);
    border-radius: 999px;
    display: inline-flex;
    font-weight: 800;
    min-height: 2.35rem;
    padding: 0.3rem 0.62rem;
    text-decoration: none;
  }

  .learn-practice-list {
    display: grid;
    gap: 0.72rem;
  }

  .learn-practice-item {
    align-items: start;
    background: color-mix(in srgb, var(--aiv-bg-panel) 62%, transparent);
    border: 1px solid color-mix(in srgb, var(--aiv-risk) 30%, var(--aiv-line-subtle));
    border-radius: 8px;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.6fr) auto;
    padding: 0.85rem;
  }

  .learn-practice-item h3,
  .learn-practice-item p,
  .learn-practice-item dl {
    margin: 0;
  }

  .learn-practice-item h3 {
    font-size: 1.12rem;
    line-height: 1.2;
    margin-top: 0.18rem;
  }

  .learn-practice-item p,
  .learn-practice-item dd {
    color: var(--aiv-text-secondary);
  }

  .learn-practice-item__meta {
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.86rem;
    gap: 0.5rem;
  }

  .learn-practice-item dl {
    display: grid;
    gap: 0.5rem;
  }

  .learn-practice-item dt {
    color: var(--aiv-text-muted);
    font-size: 0.76rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .learn-practice-item dd {
    margin: 0;
  }

  .learn-practice-item__action {
    align-items: center;
    border: 1px solid var(--aiv-risk);
    border-radius: 6px;
    color: var(--aiv-risk);
    display: inline-flex;
    font-weight: 900;
    justify-content: center;
    min-height: 2.65rem;
    padding: 0.42rem 0.72rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .learn-more-resource-groups,
  .learn-resource-row-list {
    display: grid;
    gap: 0.65rem;
  }

  .learn-resource-disclosure {
    background: color-mix(in srgb, var(--aiv-bg-canvas) 16%, transparent);
    border: 1px solid var(--aiv-line-subtle);
    border-radius: 8px;
    padding: 0.72rem 0.82rem;
  }

  .learn-resource-disclosure summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    min-height: 2.35rem;
  }

  .learn-resource-disclosure summary span {
    font-weight: 900;
  }

  .learn-resource-disclosure summary small {
    color: var(--aiv-text-muted);
    font-weight: 800;
  }

  .learn-resource-disclosure > p {
    color: var(--aiv-text-muted);
    margin-top: 0.45rem;
  }

  .learn-resource-row {
    border-top: 1px solid var(--aiv-line-subtle);
    display: grid;
    gap: 0.55rem;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.42fr) auto;
    padding-top: 0.72rem;
  }

  .learn-resource-row__main {
    display: grid;
    gap: 0.28rem;
    min-width: 0;
  }

  .learn-resource-row__action {
    color: var(--aiv-action-secondary);
    font-family: var(--aiv-font-mono);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .learn-resource-row h3,
  .learn-resource-row p {
    margin: 0;
  }

  .learn-resource-row h3 {
    font-size: 1rem;
    line-height: 1.25;
  }

  .learn-resource-row p {
    color: var(--aiv-text-secondary);
    line-height: 1.42;
  }

  .learn-resource-row__meta,
  .learn-resource-row__actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .learn-resource-row__meta {
    color: var(--aiv-text-muted);
    font-size: 0.86rem;
  }

  .learn-resource-row__actions a {
