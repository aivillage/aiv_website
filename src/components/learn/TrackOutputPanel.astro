---
import type { CollectionEntry } from "astro:content";

type Props = {
  track: CollectionEntry<"learnTracks">;
  modules: CollectionEntry<"learnModules">[];
  compact?: boolean;
};

const { track, modules, compact = false } = Astro.props;

function trackOutputForTrack(track: CollectionEntry<"learnTracks">) {
  const outputs = {
    "ai-practitioner": {
      title: "AI Workflow Plan",
      rollup: "Module artifacts become one reviewed AI workflow plan with allowed tools, allowed data, review levels, records, and escalation.",
      fields: ["workflow", "allowed tools", "allowed data", "review level", "recordkeeping", "escalation"],
    },
    "ai-builder-core": {
      title: "Team Knowledge Assistant design package",
      rollup: "Each module adds one design-package part for a small AI app: boundary, API plan, schema, retrieval, tools, evals, and observability.",
      fields: ["architecture", "API boundary", "schema", "retrieval", "tools", "evals", "observability"],
    },
    "agentic-ai-advanced-builder": {
      title: "Agent Risk Note",
      rollup: "The path rolls autonomy, tools, memory, retrieval, approvals, observability, evals, MCP scope, rollback, and stop controls into one risk note.",
      fields: ["goal", "autonomy", "tools", "memory", "approvals", "evals", "MCP scope", "rollback"],
    },
    "evals-reliability-grt": {
      title: "Inspect eval package + eval card + finding memo",
      rollup: "Inspect run notes, sample review, eval-card fields, transparency checks, and GRT-style claims form the evidence package.",
      fields: ["run package", "eval card", "sample evidence", "limitations", "non-claims", "finding memo"],
    },
    "ai-security-core": {
      title: "AI Security Core review pack",
      rollup: "Threat-model, OWASP, ATLAS, NIST, control, owner, and evidence entries become a reusable review pack for one AI system boundary.",
      fields: ["system boundary", "risk category", "evidence", "control", "owner", "review question"],
    },
    "defensive-ai-engineering": {
      title: "Defensive AI Engineering control pack",
      rollup: "This beta path builds an initial defensive control pack for review. It is a control-oriented beta path, not a full defensive operations curriculum.",
      fields: ["risk pattern", "control", "log signal", "regression test", "owner", "escalation"],
    },
    "offensive-ai-security-red-teaming": {
      title: "ROE + defensive red-team report package",
      rollup: "Rules of engagement, bounded lab debriefs, scoped evidence, mitigations, regression tests, and disclosure boundaries become the report package.",
      fields: ["scope", "authorized target", "finding", "evidence", "impact", "mitigation", "disclosure boundary"],
    },
    "governance-responsible-use": {
      title: "Governance evidence pack",
      rollup: "This evidence pack is coming soon. The public page is a roadmap while governance modules are not yet public.",
      fields: ["use case", "framework", "owner", "evidence", "caveat", "review cadence"],
    },
  } as const;

  return outputs[track.data.slug as keyof typeof outputs] || {
    title: track.data.requiredArtifacts[0] || "Track output",
    rollup: "Module artifacts build toward the track output and keep evidence, limits, and review ownership visible.",
    fields: track.data.requiredArtifacts.slice(0, 6),
  };
}

const trackOutput = trackOutputForTrack(track);
const supportingArtifacts = track.data.requiredArtifacts.filter(Boolean);
const visibleSupportingArtifacts = supportingArtifacts.slice(0, compact ? 2 : 3);
const hiddenSupportingCount = Math.max(supportingArtifacts.length - visibleSupportingArtifacts.length, 0);
const moduleArtifacts = Array.from(new Set(modules.map((module) => module.data.requiredArtifact).filter(Boolean)));
const supportingArtifactText = visibleSupportingArtifacts.length > 0
  ? `${visibleSupportingArtifacts.join(" / ")}${hiddenSupportingCount > 0 ? ` / +${hiddenSupportingCount} more` : ""}`
  : trackOutput.title;
const moduleRollupText = moduleArtifacts.length > 0
  ? `${moduleArtifacts.length} module ${moduleArtifacts.length === 1 ? "artifact rolls" : "artifacts roll"} into this output; each artifact is called out in the path below.`
  : "Module-level artifact details will appear in the path when public modules are available.";
const needsStatusNote = track.data.status === "stale" || modules.length === 0;
const statusNote = track.data.slug === "governance-responsible-use"
  ? "Governance evidence-pack modules are not public yet; use the related public tracks first and return here when modules are available."
  : track.data.slug === "defensive-ai-engineering"
    ? "This is a control-oriented beta path, not a full defensive operations curriculum."
    : modules.length === 0
      ? "Public module worksheets are not available for this track yet."
      : track.data.status === "stale"
        ? "This track is marked for review; use it as beta curriculum context."
        : "";
---

<section class:list={["track-output learn-surface-worksheet", compact && "track-output--compact"]} aria-labelledby="track-output-heading">
  <div class="track-output__intro">
    <span>You will produce</span>
    <h2 id="track-output-heading">{trackOutput.title}</h2>
    <p>{trackOutput.rollup}</p>
  </div>

  <ul class="track-output__field-list" aria-label="Track output fields">
    {trackOutput.fields.map((field) => <li>{field}</li>)}
  </ul>

  <div class="track-output__support">
    <p><span>Supports:</span> {supportingArtifactText}</p>
    <p>{moduleRollupText}</p>
  </div>

  {needsStatusNote && statusNote && <p class="track-output__note">{statusNote}</p>}
</section>

<style>
  .track-output {
    align-items: start;
    display: grid;
    gap: 0.55rem;
    padding: 0.78rem 0.9rem;
  }

  .track-output--compact {
    gap: 0.55rem;
  }

  .track-output__intro {
    display: grid;
    gap: 0.25rem;
  }

  .track-output__intro span {
    color: var(--aiv-text-muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .track-output h2,
  .track-output p,
  .track-output ul {
    margin: 0;
  }

  .track-output h2 {
    font-size: clamp(1.18rem, 1.45vw, 1.52rem);
    line-height: 1.15;
  }

  .track-output__intro p {
    color: var(--aiv-text-secondary);
    display: -webkit-box;
    font-size: 0.96rem;
    line-height: 1.4;
    max-width: 82ch;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .track-output__field-list,
  .track-output__artifact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
    list-style: none;
    padding: 0;
  }

  .track-output__field-list li {
    background: color-mix(in srgb, var(--aiv-bg-canvas) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--aiv-action-secondary) 34%, var(--aiv-line-subtle));
    border-radius: 999px;
    color: var(--aiv-text-primary);
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.2;
    padding: 0.22rem 0.52rem;
  }

  .track-output__artifact-list li {
    background: color-mix(in srgb, var(--aiv-bg-canvas) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--aiv-action-secondary) 32%, var(--aiv-line-subtle));
    border-radius: 6px;
    color: var(--aiv-text-primary);
    font-size: 0.88rem;
    line-height: 1.3;
    padding: 0.35rem 0.55rem;
  }

  .track-output__support {
    display: grid;
    gap: 0.25rem;
  }

  .track-output__support p {
    color: var(--aiv-text-secondary);
    display: -webkit-box;
    font-size: 0.9rem;
    line-height: 1.4;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .track-output__support span {
    color: var(--aiv-text-muted);
    font-weight: 900;
  }

  .track-output__note {
    color: var(--aiv-text-muted);
    font-size: 0.94rem;
  }

  @media (max-width: 760px) {
    .track-output__intro p,
    .track-output__support p {
      -webkit-line-clamp: 2;
    }
  }
</style>
