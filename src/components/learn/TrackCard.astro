---
import type { CollectionEntry } from "astro:content";
import StatusBadge from "./StatusBadge.astro";
import { canRenderLearnTrack, trackPath } from "../../utils/learn";

type Props = {
  track: CollectionEntry<"learnTracks">;
  publicModuleCount?: number;
  contextLabel?: string;
  ctaLabel?: string;
  firstModuleTitle?: string;
  priorityLabel?: string;
  cardTone?: "primary" | "secondary";
};

const {
  track,
  publicModuleCount = track.data.canonicalModules.length,
  contextLabel,
  ctaLabel,
  firstModuleTitle,
  priorityLabel,
  cardTone,
} = Astro.props;
const href = canRenderLearnTrack(track) ? trackPath(track) : "";
const firstArtifact = track.data.requiredArtifacts[0] || "Track checkpoint";
const artifactMore = Math.max(track.data.requiredArtifacts.length - 1, 0);
const showStatus = ["coming_soon", "stale"].includes(track.data.status);
const hasTopLine = showStatus || contextLabel || priorityLabel;
const resolvedCtaLabel = ctaLabel || (track.data.status === "coming_soon" ? "Preview path" : "View track");
---

<article class:list={[
  "card",
  "learn-track-card",
  cardTone === "primary" && "learn-track-card--featured",
  cardTone === "secondary" && "learn-track-card--secondary",
  track.data.status === "coming_soon" && "learn-track-card--muted",
]}>
  {hasTopLine && (
    <div class="learn-track-card__top">
      {priorityLabel && <span class="learn-track-card__priority">{priorityLabel}</span>}
      {showStatus && <StatusBadge value={track.data.status} />}
      {contextLabel && <span class="learn-track-card__context">{contextLabel}</span>}
    </div>
  )}
  <h2>{href ? <a href={href}>{track.data.title}</a> : track.data.title}</h2>
  <p class="learn-track-card__summary">{track.data.summary}</p>
  <dl class="learn-track-card__details">
    <div>
      <dt>Main artifact</dt>
      <dd>{firstArtifact}{artifactMore > 0 ? ` +${artifactMore} more` : ""}</dd>
    </div>
    {firstModuleTitle && (
      <div>
        <dt>Start with</dt>
        <dd>{firstModuleTitle}</dd>
      </div>
    )}
  </dl>
  <div class="learn-track-card__footer">
    <span>{publicModuleCount} public {publicModuleCount === 1 ? "module" : "modules"}</span>
    {href && <a class="learn-track-card__cta" href={href}>{resolvedCtaLabel}</a>}
  </div>
</article>

<style>
  .learn-track-card {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-radius: 8px;
    box-shadow: var(--aiv-card-shadow);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 0;
    min-height: 100%;
    padding: 1.25rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .learn-track-card::before {
    display: none;
  }

  .learn-track-card:hover {
    border-color: var(--aiv-card-hover-border);
    box-shadow: var(--aiv-card-hover-shadow);
    transform: none;
  }

  .learn-track-card--featured {
    background: color-mix(in srgb, var(--aiv-action-primary) 10%, var(--aiv-card-bg));
    border-color: var(--aiv-action-primary);
    box-shadow: none;
  }

  .learn-track-card--secondary {
    background: color-mix(in srgb, var(--aiv-card-bg) 62%, transparent);
    border-color: var(--aiv-line-subtle);
    box-shadow: none;
  }

  .learn-track-card--muted {
    background: color-mix(in srgb, var(--aiv-card-bg) 70%, transparent);
    border-color: var(--aiv-line-subtle);
    box-shadow: none;
  }

  .learn-track-card h2 {
    font-size: 1.18rem;
    line-height: 1.25;
    margin: 0;
  }

  .learn-track-card h2 a {
    color: inherit;
  }

  .learn-track-card__summary {
    color: var(--aiv-text-secondary);
    flex: 1;
    line-height: 1.5;
    margin: 0;
  }

  .learn-track-card__top,
  .learn-track-card__footer {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .learn-track-card__top {
    min-height: 0;
  }

  .learn-track-card__priority,
  .learn-track-card__context {
    border: 1px solid var(--aiv-line-strong);
    border-radius: 999px;
    color: var(--aiv-text-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.14rem 0.5rem;
  }

  .learn-track-card__priority {
    background: color-mix(in srgb, var(--aiv-action-primary) 18%, transparent);
    border-color: var(--aiv-action-primary);
    color: var(--aiv-text-primary);
  }

  .learn-track-card__details {
    border-top: 1px solid var(--aiv-line-subtle);
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding-top: 0.85rem;
  }

  .learn-track-card__details div {
    display: grid;
    gap: 0.2rem;
  }

  .learn-track-card__details dt {
    color: var(--aiv-text-muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .learn-track-card__details dd {
    color: var(--aiv-text-primary);
    margin: 0;
  }

  .learn-track-card__footer {
    color: var(--aiv-text-muted);
    font-size: 0.9rem;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.15rem;
  }

  .learn-track-card__cta {
    align-items: center;
    color: var(--aiv-action-primary);
    display: inline-flex;
    font-weight: 800;
    min-height: 2.75rem;
    padding-inline: 0.15rem;
  }

  .learn-track-card a:focus-visible,
  .learn-track-card__cta:focus-visible {
    outline: 3px solid var(--aiv-focus-ring);
    outline-offset: 3px;
  }
</style>
