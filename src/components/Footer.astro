---
import { footerNavSections } from "../data/navigation";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <a class="footer-title" href="/">AI Village</a>
        <p class="text-mono">Securing AI, one hack at a time.</p>
      </div>
      <div class="footer-sitemap">
        {footerNavSections.map((section) => (
          <nav class="footer-nav-section" aria-label={`${section.title} footer links`}>
            <h2>{section.title}</h2>
            <ul>
              {section.links.map((item) => {
                const external = "external" in item && item.external;
                return (
                  <li>
                    <a href={item.href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        ))}
      </div>
      <p class="footer-copyright">&copy; {year} AI Village. All rights reserved.</p>
    </div>
  </div>
</footer>
