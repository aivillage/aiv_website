---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ModulePageView from "../../../../components/learn/ModulePageView.astro";
import {
  canRenderLearnLab,
  canRenderLearnModule,
  entrySlug,
  findPublicCanonicalTracksForModule,
  modulePath,
  previousNextModulesInTrack,
  refId,
} from "../../../../utils/learn";

type ResourceGroup = {
  role: "required" | "optional" | "deeper";
  heading: string;
  items: ResourceItem[];
};

type ResourceItem = {
  resource: CollectionEntry<"learnResources">;
  step?: number;
  note?: string;
  sourceIndex: number;
};

export async function getStaticPaths() {
  function canFeatureYouTubeEmbed(resource: CollectionEntry<"learnResources">) {
    return Boolean(
      resource.data.sourcePlatform === "youtube" &&
      resource.data.embedAllowed &&
      resource.data.featuredEmbed &&
      resource.data.reviewStatus === "accepted" &&
      resource.data.accessMode === "direct_open" &&
      resource.data.loginRequired === false &&
      !resource.data.ageRestricted &&
      (resource.data.videoId || resource.data.playlistId),
    );
  }

  const resourceGroupLabels = {
    required: "Start here",
    optional: "Optional resources",
    deeper: "Go deeper",
  } as const;
  function resourceItemsForRole(
    module: CollectionEntry<"learnModules">,
    resourceBySlug: Map<string, CollectionEntry<"learnResources">>,
    role: ResourceGroup["role"],
  ) {
    const items: ResourceItem[] = [];
    module.data.resources.forEach((resourceLink, sourceIndex) => {
      if (resourceLink.role !== role) return;
      const resource = resourceBySlug.get(refId(resourceLink.resource));
      if (!resource || resource.data.status === "draft") return;
      items.push(
        {
          resource,
          step: resourceLink.step,
          note: resourceLink.note,
          sourceIndex,
        },
      );
    });
    return items.sort((a, b) => (a.step ?? a.sourceIndex + 10000) - (b.step ?? b.sourceIndex + 10000));
  }

  function featuredEmbedForGroups(resourceGroups: ResourceGroup[]) {
    const requiredEmbed = resourceGroups.find((group) => group.role === "required")?.items.find((item) => canFeatureYouTubeEmbed(item.resource));
    if (requiredEmbed) return requiredEmbed;
    return resourceGroups.find((group) => group.role === "optional")?.items.find((item) => canFeatureYouTubeEmbed(item.resource));
  }

  const modules = await getCollection("learnModules", canRenderLearnModule);
  const allModules = await getCollection("learnModules");
  const tracks = await getCollection("learnTracks");
  const publicTracks = tracks.filter((track) => track.data.status !== "draft");
  const resources = await getCollection("learnResources");
  const labs = await getCollection("learnLabs");
  const moduleBySlug = new Map(allModules.flatMap((module) => [[entrySlug(module), module], [module.id, module]]));
  const trackBySlug = new Map(tracks.flatMap((track) => [[entrySlug(track), track], [track.id, track]]));
  const resourceBySlug = new Map(resources.flatMap((resource) => [[entrySlug(resource), resource], [resource.id, resource]]));
  const labBySlug = new Map(labs.flatMap((lab) => [[entrySlug(lab), lab], [lab.id, lab]]));

  return modules.map((module) => {
    const relatedTracks = module.data.tracks.map((trackRef) => trackBySlug.get(refId(trackRef))).filter(Boolean) as CollectionEntry<"learnTracks">[];
    const canonicalTracks = findPublicCanonicalTracksForModule(module, publicTracks);
    const primaryNavigation = canonicalTracks.length === 1 ? previousNextModulesInTrack(module, canonicalTracks[0], moduleBySlug) : undefined;
    const prerequisites = module.data.prerequisites
      .map((moduleRef) => moduleBySlug.get(refId(moduleRef)))
      .filter((prerequisite) => prerequisite && canRenderLearnModule(prerequisite)) as CollectionEntry<"learnModules">[];
    const resourceGroups = (["required", "optional", "deeper"] as const).map((role) => ({
      role,
      heading: resourceGroupLabels[role],
      items: resourceItemsForRole(module, resourceBySlug, role),
    })) satisfies ResourceGroup[];
    const hasComingSoonTrack = relatedTracks.some((track) => track.data.status === "coming_soon");
    const featuredEmbed = module.data.status === "coming_soon" || hasComingSoonTrack
      ? undefined
      : featuredEmbedForGroups(resourceGroups);
    const linkedLabs = (module.data.labs || [])
      .map((labRef) => labBySlug.get(refId(labRef)))
      .filter((lab) => lab && canRenderLearnLab(lab)) as CollectionEntry<"learnLabs">[];

    return {
      params: { slug: entrySlug(module) },
      props: {
        module,
        tracks: relatedTracks,
        canonicalTracks,
        prerequisites,
        resourceGroups,
        featuredEmbed,
        labs: linkedLabs,
        canonical: modulePath(module),
        globalTrackContext: canonicalTracks.length === 1 && primaryNavigation
          ? {
              track: canonicalTracks[0],
              moduleIndex: primaryNavigation.moduleIndex,
              moduleCount: primaryNavigation.moduleCount,
              previousModule: primaryNavigation.previousModule,
              nextModule: primaryNavigation.nextModule,
            }
          : undefined,
      },
    };
  });
}

const props = Astro.props;
---

<ModulePageView {...props} />
