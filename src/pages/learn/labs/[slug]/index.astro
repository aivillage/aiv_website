---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageShell from "../../../../components/layout/PageShell.astro";
import ArtifactBadge from "../../../../components/learn/ArtifactBadge.astro";
import ReferenceRail from "../../../../components/learn/ReferenceRail.astro";
import {
  canRenderLearnLab,
  canRenderLearnModule,
  canRenderLearnTrack,
  entrySlug,
  findPublicCanonicalTracksForModule,
  formatLabel,
  labPath,
  modulePath,
  refId,
  resourcePath,
  trackPath,
  trackScopedModulePath,
} from "../../../../utils/learn";

type MappingGroup = {
  label: string;
  values: string[];
};

type ModuleLink = {
  module: CollectionEntry<"learnModules">;
  track?: CollectionEntry<"learnTracks">;
};

type Props = {
  lab: CollectionEntry<"learnLabs">;
  modules: ModuleLink[];
  tracks: CollectionEntry<"learnTracks">[];
  resources: CollectionEntry<"learnResources">[];
  mappings: MappingGroup[];
};

export async function getStaticPaths() {
  const mappingLabels = {
    owasp: "OWASP",
    mitreAtlas: "MITRE ATLAS",
    nist: "NIST",
  } as const;
  const labs = await getCollection("learnLabs", canRenderLearnLab);
  const modules = await getCollection("learnModules");
  const tracks = await getCollection("learnTracks");
  const resources = await getCollection("learnResources", ({ data }) => data.status !== "draft");
  const trackBySlug = new Map(tracks.flatMap((track) => [[entrySlug(track), track], [track.id, track]]));

  return labs.map((lab) => {
    const labSlug = entrySlug(lab);
    const relatedModules = modules.filter((module) =>
      canRenderLearnModule(module) && (module.data.labs || []).some((labRef) => refId(labRef) === labSlug),
    );
    const moduleLinks = relatedModules.map((module) => {
      const canonicalTracks = findPublicCanonicalTracksForModule(module, tracks);
      return { module, track: canonicalTracks.length === 1 ? canonicalTracks[0] : undefined };
    });
    const relatedTracks = Array.from(
      new Map(
        relatedModules
          .flatMap((module) => module.data.tracks.map((trackRef) => trackBySlug.get(refId(trackRef))).filter((track) => track && canRenderLearnTrack(track)) as CollectionEntry<"learnTracks">[])
          .map((track) => [entrySlug(track), track]),
      ).values(),
    );
    const relatedResources = Array.from(
      new Map(
        resources
          .filter((resource) => entrySlug(resource) === labSlug || resource.data.canonicalFor.some((canonicalId) => canonicalId === labSlug || relatedModules.some((module) => entrySlug(module) === canonicalId)))
          .map((resource) => [entrySlug(resource), resource]),
      ).values(),
    );
    const mappings = (Object.entries(lab.data.mappings) as [keyof typeof mappingLabels, string[] | undefined][])
      .filter(([, values]) => values && values.length > 0)
      .map(([key, values]) => ({ label: mappingLabels[key], values: values || [] }));

    return {
      params: { slug: labSlug },
      props: { lab, modules: moduleLinks, tracks: relatedTracks, resources: relatedResources, mappings },
    };
  });
}

const { lab, modules, tracks, resources, mappings } = Astro.props;
const { Content } = await render(lab);
const sourceUrl = lab.data.sourceRepo
  ? `https://github.com/${lab.data.sourceRepo}${lab.data.sourcePath ? `/tree/main/${lab.data.sourcePath}` : ""}`
  : "";
const isWorkshopBacked = lab.data.sourceRepo === "aivillage/workshops";
const sourceHeading = isWorkshopBacked ? "Workshop Source" : "Source Reference";
const moduleTrackPriority = [
  "ai-security-core",
  "defensive-ai-engineering",
  "agentic-ai-advanced-builder",
  "offensive-ai-security-red-teaming",
];

function modulePriority({ module, track }: ModuleLink) {
  const trackSlug = track ? entrySlug(track) : "";
  const trackRank = moduleTrackPriority.includes(trackSlug) ? moduleTrackPriority.indexOf(trackSlug) : moduleTrackPriority.length;
  const offensiveWrapperPenalty = trackSlug === "offensive-ai-security-red-teaming" && module.data.moduleType === "lab" ? 1 : 0;
  return trackRank * 10 + offensiveWrapperPenalty;
}

const prioritizedModules = [...modules].sort((left, right) =>
  modulePriority(left) - modulePriority(right) || left.module.data.title.localeCompare(right.module.data.title),
);
const primaryModuleLinks = prioritizedModules.slice(0, 3);
const additionalModuleLinks = prioritizedModules.slice(3);
const sourceFacts = [
  { label: "Repository", value: lab.data.sourceRepo || "No public source link attached", href: sourceUrl || undefined, external: Boolean(sourceUrl) },
  { label: "Source path", value: lab.data.sourcePath },
  { label: "Setup status", value: formatLabel(lab.data.setupStatus) },
  { label: "Debrief status", value: formatLabel(lab.data.debriefStatus) },
  { label: "Instructor guide", value: formatLabel(lab.data.instructorGuideStatus) },
];
const railSections = [
  {
    title: "Exercise Specs",
    facts: [
      { label: "Run modes", value: lab.data.runModes.map(formatLabel).join(", ") },
      { label: "LLM", value: lab.data.llmRequired ? "Required" : "Not required" },
      { label: "GPU", value: lab.data.gpuRequired ? "Required" : "Not required" },
      { label: "Time", value: `${lab.data.estimatedMinutes} minutes` },
      { label: "Stage", value: `${formatLabel(lab.data.stageStart)} to ${formatLabel(lab.data.stageEnd)}` },
    ],
  },
  {
    title: sourceHeading,
    facts: sourceFacts,
  },
  {
    title: "Concepts",
    tags: lab.data.concepts,
  },
  {
    title: "Threat Categories",
    tags: lab.data.threatCategories,
  },
  {
    title: "Related Tracks",
    links: tracks.map((track) => ({ label: track.data.title, href: trackPath(track) })),
  },
  {
    title: "Related Resources",
    links: resources.map((resource) => ({
      label: resource.data.title,
      href: resourcePath(resource),
      meta: resource.data.provider,
    })),
  },
  {
    title: "Framework Mappings",
    collapsed: true,
    links: mappings.flatMap((mapping) => mapping.values.map((value) => ({ label: value, meta: mapping.label }))),
  },
];

function moduleLinkHref(module: CollectionEntry<"learnModules">, track?: CollectionEntry<"learnTracks">) {
  return track ? trackScopedModulePath(track, module) : modulePath(module);
}
---

<BaseLayout title={lab.data.title} canonical={labPath(lab)} description={lab.data.summary}>
  <PageShell class="learn-lab-page" width="full">
    <div class="learn-lab-page__inner">
      <nav class="learn-breadcrumb" aria-label="Breadcrumb"><a href="/learn/">Learn</a> / <a href="/learn/labs/">Labs</a> / <span>{lab.data.title}</span></nav>

      <header class="learn-lab-header">
        <div class="learn-meta-row">
          <span>{formatLabel(lab.data.difficulty)}</span>
          <span>{lab.data.estimatedMinutes} min</span>
          {lab.data.isOffensive && <span class="learn-flag">Offensive toy lab</span>}
        </div>
        <h1>{lab.data.title}</h1>
        <p>{lab.data.summary}</p>
      </header>

      <div class="learn-lab-layout">
        <main class="learn-lab-main">
          <section class="learn-exercise-brief learn-surface-exercise" aria-labelledby="exercise-brief-heading">
            <div>
              <span id="exercise-brief-heading">Safety Boundary</span>
              <p>{lab.data.safetyBoundary}</p>
            </div>
            <div>
              <span>Expected Artifact</span>
              <ArtifactBadge value={lab.data.requiredArtifact} />
            </div>
            {lab.data.isOffensive && (
              <div class="learn-exercise-brief__warning">
                <span>Authorized toy-lab boundary</span>
                <p>This exercise is for the provided toy lab and defensive debrief only. Do not transfer prompts, payloads, or techniques to real systems without explicit authorization and a documented scope.</p>
              </div>
            )}
          </section>

          {modules.length > 0 && (
            <section class="learn-continue-module learn-surface-reference" aria-labelledby="continue-module-heading">
              <div class="learn-section-heading">
                <div>
                  <span class="learn-kicker">Continue</span>
                  <h2 id="continue-module-heading">Continue in module</h2>
                </div>
                <p>Return to the closest curriculum module after completing the exercise artifact.</p>
              </div>
              <ul class="learn-link-list">
                {primaryModuleLinks.map(({ module, track }) => (
                  <li>
                    <a class="learn-module-link" href={moduleLinkHref(module, track)}>
                      <strong>{module.data.title}</strong>
                      {track && <span>{track.data.title}</span>}
                    </a>
                  </li>
                ))}
              </ul>
              {additionalModuleLinks.length > 0 && (
                <details class="learn-continuation-more">
                  <summary>Show {additionalModuleLinks.length} more related {additionalModuleLinks.length === 1 ? "module" : "modules"}</summary>
                  <ul class="learn-link-list">
                    {additionalModuleLinks.map(({ module, track }) => (
                      <li>
                        <a class="learn-module-link" href={moduleLinkHref(module, track)}>
                          <strong>{module.data.title}</strong>
                          {track && <span>{track.data.title}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
          )}

          <section class="learn-run-section learn-surface-task" aria-labelledby="run-section-heading">
            <div class="learn-section-heading">
              <div>
                <span class="learn-kicker">Exercise</span>
                <h2 id="run-section-heading">Run / Debrief</h2>
              </div>
              <p>Use the existing lab instructions inside the safety boundary above; source links and mappings stay in the reference rail.</p>
            </div>
            <div class="learn-content-body">
              <Content />
            </div>
          </section>
        </main>

        <ReferenceRail title="Lab Reference" sections={railSections} />
      </div>
    </div>
  </PageShell>
</BaseLayout>

<style>
  .learn-lab-page {
    width: 100%;
  }

  .learn-lab-page__inner {
    display: grid;
    gap: 1rem;
    margin-inline: auto;
    max-width: 1360px;
    min-width: 0;
  }

  .learn-breadcrumb,
  .learn-meta-row {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .learn-lab-header {
    display: grid;
    gap: 0.5rem;
  }

  .learn-lab-header h1,
  .learn-lab-header p {
    margin: 0;
  }

  .learn-lab-header h1 {
    font-size: clamp(2.05rem, 4vw, 3.4rem);
    line-height: 1.02;
    max-width: 16ch;
  }

  .learn-lab-header p {
    color: var(--aiv-text-secondary);
    font-size: clamp(1rem, 1.3vw, 1.16rem);
    line-height: 1.45;
    max-width: 74ch;
  }

  .learn-lab-layout {
    align-items: start;
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
  }

  .learn-lab-main {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .learn-exercise-brief,
  .learn-run-section,
  .learn-continue-module {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
  }

  .learn-exercise-brief {
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.55fr);
  }

  .learn-exercise-brief > div {
    display: grid;
    gap: 0.35rem;
  }

  .learn-exercise-brief span,
  .learn-kicker {
    color: var(--aiv-text-muted);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .learn-exercise-brief p,
  .learn-section-heading p {
    color: var(--aiv-text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .learn-exercise-brief__warning {
    background: color-mix(in srgb, var(--aiv-risk) 10%, var(--aiv-bg-panel));
    border: 1px solid color-mix(in srgb, var(--aiv-risk) 50%, var(--aiv-line-subtle));
    border-radius: 8px;
    grid-column: 1 / -1;
    padding: 0.85rem;
  }

  .learn-section-heading {
    align-items: start;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(11rem, max-content) minmax(18rem, 62ch);
    justify-content: space-between;
  }

  .learn-section-heading h2,
  .learn-section-heading p {
    margin: 0;
  }

  .learn-section-heading h2 {
    font-size: clamp(1.24rem, 2vw, 1.62rem);
    line-height: 1.15;
  }

  .learn-content-body {
    max-width: 82ch;
    min-width: 0;
  }

  .learn-content-body :global(h2:first-child),
  .learn-content-body :global(h3:first-child),
  .learn-content-body :global(p:first-child) {
    margin-top: 0;
  }

  .learn-flag {
    border: 1px solid var(--aiv-risk);
    border-radius: 999px;
    color: var(--aiv-risk);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.22rem 0.55rem;
  }

  .learn-link-list {
    display: grid;
    gap: 0.65rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .learn-module-link {
    display: inline-grid;
    gap: 0.12rem;
    line-height: 1.3;
    min-height: 2.65rem;
    padding-block: 0.2rem;
  }

  .learn-module-link strong {
    color: var(--aiv-action-primary);
  }

  .learn-module-link span {
    color: var(--aiv-text-muted);
    font-size: 0.92rem;
  }

  .learn-continuation-more {
    border-top: 1px solid var(--aiv-line-subtle);
    padding-top: 0.65rem;
  }

  .learn-continuation-more summary {
    cursor: pointer;
    font-weight: 900;
    min-height: 2.65rem;
  }

  .learn-module-link:focus-visible,
  .learn-continuation-more summary:focus-visible {
    outline: 3px solid var(--aiv-focus-ring);
    outline-offset: 3px;
  }

  @media (max-width: 1099px) {
    .learn-lab-layout,
    .learn-exercise-brief {
      grid-template-columns: 1fr;
    }

    .learn-lab-header h1 {
      max-width: none;
    }

    .learn-section-heading {
      grid-template-columns: 1fr;
    }
  }
</style>
