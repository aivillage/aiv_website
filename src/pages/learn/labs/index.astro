---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageShell from "../../../components/layout/PageShell.astro";
import LabCard from "../../../components/learn/LabCard.astro";
import { byTitle, canRenderLearnLab } from "../../../utils/learn";

const labs = (await getCollection("learnLabs", canRenderLearnLab)).sort(byTitle);
const offensiveLabs = labs.filter((lab) => lab.data.isOffensive);
const otherLabs = labs.filter((lab) => !lab.data.isOffensive);
---

<BaseLayout title="Learn Labs" canonical="/learn/labs/" description="Safety-bounded AI Village Learn lab metadata.">
  <PageShell class="learn-page">
    <h1>Labs</h1>
    <p class="text-lead">
      Hands-on Learn entries pair a bounded exercise with safety framing, run expectations, and a learner artifact. Labs link to source when a public workshop or repository is available.
    </p>
    <p>
      Labs work best from the module pages that introduce the relevant concepts, checkpoints, and review questions. Use this catalog when you need to return to a lab directly.
    </p>
    {offensiveLabs.length > 0 && (
      <section>
        <h2>Safety-Bounded Challenge Labs</h2>
        <div class="learn-grid">
          {offensiveLabs.map((lab) => <LabCard lab={lab} />)}
        </div>
      </section>
    )}
    {otherLabs.length > 0 && (
      <section>
        <h2>Evaluation And Reporting Labs</h2>
        <div class="learn-grid">
          {otherLabs.map((lab) => <LabCard lab={lab} />)}
        </div>
      </section>
    )}
  </PageShell>
</BaseLayout>

<style>
  .learn-page {
    display: grid;
    gap: 1.5rem;
  }

  .learn-page section {
    display: grid;
    gap: 0.9rem;
  }

  .learn-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
</style>
