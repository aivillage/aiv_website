---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageShell from "../../../../components/layout/PageShell.astro";
import ArtifactBadge from "../../../../components/learn/ArtifactBadge.astro";
import LabCard from "../../../../components/learn/LabCard.astro";
import DifficultyBadge from "../../../../components/learn/DifficultyBadge.astro";
import StageBadge from "../../../../components/learn/StageBadge.astro";
import StatusBadge from "../../../../components/learn/StatusBadge.astro";
import { canRenderLearnLab, canRenderLearnModule, canRenderLearnTrack, entrySlug, moduleTypeLabels, refId, securityLensLabels, trackPath, trackScopedModulePath } from "../../../../utils/learn";

type Props = {
  track: CollectionEntry<"learnTracks">;
  modules: CollectionEntry<"learnModules">[];
  labs: CollectionEntry<"learnLabs">[];
  prerequisiteTracks: CollectionEntry<"learnTracks">[];
};

export async function getStaticPaths() {
  const tracks = await getCollection("learnTracks", canRenderLearnTrack);
  const allTracks = await getCollection("learnTracks");
  const modules = await getCollection("learnModules");
  const labs = await getCollection("learnLabs", canRenderLearnLab);
  const trackBySlug = new Map(allTracks.flatMap((track) => [[entrySlug(track), track], [track.id, track]]));
  const moduleBySlug = new Map(modules.flatMap((module) => [[entrySlug(module), module], [module.id, module]]));
  const labBySlug = new Map(labs.flatMap((lab) => [[entrySlug(lab), lab], [lab.id, lab]]));

  return tracks.map((track) => {
    const canonicalModules = track.data.canonicalModules
      .map((moduleRef) => moduleBySlug.get(refId(moduleRef)))
      .filter((module) => module && canRenderLearnModule(module)) as CollectionEntry<"learnModules">[];
    const relatedLabs = Array.from(
      new Map(
        canonicalModules
          .flatMap((module) => module.data.labs?.map((labRef) => labBySlug.get(refId(labRef))).filter((lab) => lab && canRenderLearnLab(lab)) || [])
          .map((lab) => [entrySlug(lab as CollectionEntry<"learnLabs">), lab as CollectionEntry<"learnLabs">]),
      ).values(),
    );
    const prerequisiteTracks = track.data.prerequisites.map((trackRef) => trackBySlug.get(refId(trackRef))).filter(Boolean) as CollectionEntry<"learnTracks">[];

    return {
      params: { slug: entrySlug(track) },
      props: { track, modules: canonicalModules, labs: relatedLabs, prerequisiteTracks },
    };
  });
}

const { track, modules, labs, prerequisiteTracks } = Astro.props;
const { Content } = await render(track);

function shouldShowModuleStatus(status: CollectionEntry<"learnModules">["data"]["status"]) {
  return ["coming_soon", "stale"].includes(status);
}
---

<BaseLayout title={track.data.title} canonical={trackPath(track)} description={track.data.summary}>
  <PageShell class="learn-track-page" width="wide">
    <nav class="learn-breadcrumb" aria-label="Breadcrumb"><a href="/learn/">Learn</a> / <span>{track.data.title}</span></nav>

    <header class="learn-track-header">
      <div>
        <div class="learn-meta-row">
          <StatusBadge value={track.data.status} />
          <StageBadge value={track.data.stageStart} />
          <span>to</span>
          <StageBadge value={track.data.stageEnd} />
        </div>
        <h1>{track.data.title}</h1>
        <p class="text-lead">{track.data.summary}</p>
      </div>
      <div class="learn-side-panel">
        <h2>Required Artifacts</h2>
        <div class="learn-artifacts">
          {track.data.requiredArtifacts.map((artifact) => <ArtifactBadge value={artifact} />)}
        </div>
      </div>
    </header>

    <section class="learn-two-column">
      <div>
        <h2>Who Should Start Here</h2>
        <ul>
          {track.data.audiences.map((audience) => <li>{audience}</li>)}
        </ul>
        {prerequisiteTracks.length > 0 && (
          <>
            <h2>Track Prerequisites</h2>
            <ul>
              {
                prerequisiteTracks.map((prerequisite) => (
                  <li>
                    {canRenderLearnTrack(prerequisite) ? <a href={trackPath(prerequisite)}>{prerequisite.data.title}</a> : prerequisite.data.title}
                  </li>
                ))
              }
            </ul>
          </>
        )}
      </div>
      <div>
        <h2>Security Lens</h2>
        <p>{securityLensLabels[track.data.securityLens]}</p>
        {track.data.securityCheckpoints.length > 0 && (
          <ul>
            {track.data.securityCheckpoints.map((checkpoint) => <li>{checkpoint}</li>)}
          </ul>
        )}
      </div>
    </section>

    <section class="learn-content-body">
      <Content />
    </section>

    <section>
      <div class="learn-section-heading">
        <h2>Learning Path</h2>
        {modules.length > 0 && <a class="button" href={trackScopedModulePath(track, modules[0])}>Start Module 1</a>}
      </div>
      {
        modules.length > 0 ? (
          <ol class="learn-module-path">
            {modules.map((module, index) => (
              <li>
                <div class="learn-module-path__number">{index + 1}</div>
                <div>
                  <div class="learn-card__meta">
                    {shouldShowModuleStatus(module.data.status) && <StatusBadge value={module.data.status} />}
                    <DifficultyBadge value={module.data.difficulty} />
                    <span>{moduleTypeLabels[module.data.moduleType]}</span>
                  </div>
                  <h3><a href={trackScopedModulePath(track, module)}>{module.data.title}</a></h3>
                  <p>{module.data.summary}</p>
                  <div class="learn-card__meta">
                    <StageBadge value={module.data.stageStart} />
                    <span>to</span>
                    <StageBadge value={module.data.stageEnd} />
                    <span>{module.data.resources.length} resources</span>
                    {module.data.labs?.length ? <span>{module.data.labs.length} lab links</span> : null}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        ) : track.data.status === "coming_soon" ? (
          <p class="text-muted">Modules are being prepared for this track.</p>
        ) : (
          <p class="text-muted">No public modules are available for this track yet.</p>
        )
      }
    </section>

    {modules.length > 0 && (
      <section class="learn-artifact-path-section">
        <h2>Artifact Path</h2>
        <p class="text-muted">Each module checkpoint contributes to the track-level artifacts.</p>
        <ol class="learn-artifact-path">
          {modules.map((module, index) => (
            <li>
              <div class="learn-module-path__number">{index + 1}</div>
              <div>
                <h3><a href={trackScopedModulePath(track, module)}>{module.data.title}</a></h3>
                {module.data.requiredArtifact ? (
                  <ArtifactBadge value={module.data.requiredArtifact} />
                ) : (
                  <p class="text-muted">Checkpoint being refined.</p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="learn-two-column">
      <div class="card card--accent-primary">
        <h2 class="mt-0">What Exists Now</h2>
        <p>{track.data.whatExistsNow}</p>
      </div>
      <div class="card card--accent-muted">
        <h2 class="mt-0">What Is Coming Next</h2>
        <p>{track.data.whatComingNext}</p>
      </div>
    </section>

    {labs.length > 0 && <section>
      <h2>Related Labs</h2>
      <div class="learn-grid">{labs.map((lab) => <LabCard lab={lab} />)}</div>
    </section>}
  </PageShell>
</BaseLayout>

<style>
  .learn-track-page {
    display: grid;
    gap: 2rem;
  }

  .learn-breadcrumb,
  .learn-meta-row {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .learn-track-header,
  .learn-two-column {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
  }

  .learn-side-panel {
    align-self: start;
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 8px;
    padding: 1rem;
  }

  .learn-side-panel h2 {
    font-size: 1.1rem;
    margin-top: 0;
  }

  .learn-artifacts,
  .learn-artifact-path,
  .learn-grid,
  .learn-module-path {
    display: grid;
    gap: 0.75rem;
  }

  .learn-content-body {
    max-width: 76ch;
  }

  .learn-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .learn-section-heading {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .button {
    background: var(--aiv-action-primary);
    border: 1px solid var(--aiv-action-primary);
    border-radius: 6px;
    color: var(--aiv-bg-canvas);
    display: inline-flex;
    font-weight: 800;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.6rem 0.95rem;
    text-decoration: none;
  }

  .learn-module-path {
    counter-reset: module-path;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .learn-artifact-path {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .learn-artifact-path li {
    align-items: start;
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 8px;
    display: grid;
    gap: 0.85rem;
    grid-template-columns: auto minmax(0, 1fr);
    padding: 1rem;
  }

  .learn-artifact-path h3 {
    font-size: 1rem;
    margin: 0 0 0.45rem;
  }

  .learn-module-path li {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-radius: 8px;
    box-shadow: var(--aiv-card-shadow);
    display: grid;
    gap: 1rem;
    grid-template-columns: auto minmax(0, 1fr);
    padding: 1rem;
  }

  .learn-module-path__number {
    align-items: center;
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 999px;
    display: inline-flex;
    font-weight: 800;
    height: 2rem;
    justify-content: center;
    width: 2rem;
  }

  .learn-card__meta {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.9rem;
    gap: 0.5rem;
  }

  @media (max-width: 780px) {
    .learn-track-header,
    .learn-two-column {
      grid-template-columns: 1fr;
    }
  }
</style>
