---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageShell from "../../../../components/layout/PageShell.astro";
import PathMap from "../../../../components/learn/PathMap.astro";
import StageBadge from "../../../../components/learn/StageBadge.astro";
import StatusBadge from "../../../../components/learn/StatusBadge.astro";
import TrackOutputPanel from "../../../../components/learn/TrackOutputPanel.astro";
import { canRenderLearnLab, canRenderLearnModule, canRenderLearnTrack, entrySlug, labPath, refId, securityLensLabels, trackPath, trackScopedModulePath } from "../../../../utils/learn";

type Props = {
  track: CollectionEntry<"learnTracks">;
  modules: CollectionEntry<"learnModules">[];
  labs: CollectionEntry<"learnLabs">[];
  prerequisiteTracks: CollectionEntry<"learnTracks">[];
};

export async function getStaticPaths() {
  const tracks = await getCollection("learnTracks", canRenderLearnTrack);
  const allTracks = await getCollection("learnTracks");
  const modules = await getCollection("learnModules");
  const labs = await getCollection("learnLabs", canRenderLearnLab);
  const trackBySlug = new Map(allTracks.flatMap((track) => [[entrySlug(track), track], [track.id, track]]));
  const moduleBySlug = new Map(modules.flatMap((module) => [[entrySlug(module), module], [module.id, module]]));
  const labBySlug = new Map(labs.flatMap((lab) => [[entrySlug(lab), lab], [lab.id, lab]]));

  return tracks.map((track) => {
    const canonicalModules = track.data.canonicalModules
      .map((moduleRef) => moduleBySlug.get(refId(moduleRef)))
      .filter((module) => module && canRenderLearnModule(module)) as CollectionEntry<"learnModules">[];
    const relatedLabs = Array.from(
      new Map(
        canonicalModules
          .flatMap((module) => module.data.labs?.map((labRef) => labBySlug.get(refId(labRef))).filter((lab) => lab && canRenderLearnLab(lab)) || [])
          .map((lab) => [entrySlug(lab as CollectionEntry<"learnLabs">), lab as CollectionEntry<"learnLabs">]),
      ).values(),
    );
    const prerequisiteTracks = track.data.prerequisites.map((trackRef) => trackBySlug.get(refId(trackRef))).filter(Boolean) as CollectionEntry<"learnTracks">[];

    return {
      params: { slug: entrySlug(track) },
      props: { track, modules: canonicalModules, labs: relatedLabs, prerequisiteTracks },
    };
  });
}

const { track, modules, labs, prerequisiteTracks } = Astro.props;
const { Content } = await render(track);
const firstModule = modules[0];
const showTrackStatus = track.data.status !== "beta";
---

<BaseLayout title={track.data.title} canonical={trackPath(track)} description={track.data.summary}>
  <PageShell class="learn-track-page" width="full">
    <nav class="learn-breadcrumb" aria-label="Breadcrumb"><a href="/learn/">Learn</a> / <span>{track.data.title}</span></nav>

    <header class="learn-track-hero">
      <div class="learn-track-hero__main">
        <div class="learn-meta-row">
          {showTrackStatus && <StatusBadge value={track.data.status} />}
          <StageBadge value={track.data.stageStart} />
          <span>to</span>
          <StageBadge value={track.data.stageEnd} />
        </div>
        <h1>{track.data.title}</h1>
        <p class="text-lead">{track.data.summary}</p>
        {firstModule ? (
          <a class="button" href={trackScopedModulePath(track, firstModule)}>Start Module 1</a>
        ) : (
          <p class="learn-track-hero__empty">Public modules are not available yet.</p>
        )}
      </div>
    </header>

    <div class="learn-track-layout">
      <main class="learn-track-main" aria-label={`${track.data.title} output and path`}>
        <TrackOutputPanel track={track} modules={modules} />
        <PathMap track={track} modules={modules} />
      </main>

      <aside class="learn-track-rail learn-surface-reference" aria-label="Track context">
        <h2>Who Should Start Here</h2>
        <ul>
          {track.data.audiences.map((audience) => <li>{audience}</li>)}
        </ul>
        {prerequisiteTracks.length > 0 && (
          <section>
            <h2>Track Prerequisites</h2>
            <ul>
              {
                prerequisiteTracks.map((prerequisite) => (
                  <li>
                    {canRenderLearnTrack(prerequisite) ? <a href={trackPath(prerequisite)}>{prerequisite.data.title}</a> : prerequisite.data.title}
                  </li>
                ))
              }
            </ul>
          </section>
        )}
        <section class="learn-track-rail__security">
          <h2>Security Lens</h2>
          <p>{securityLensLabels[track.data.securityLens]}</p>
          {track.data.securityCheckpoints.length > 0 && (
            <ul>
              {track.data.securityCheckpoints.map((checkpoint) => <li>{checkpoint}</li>)}
            </ul>
          )}
        </section>
      </aside>
    </div>

    {labs.length > 0 && (
      <section class="learn-track-practice learn-surface-exercise" aria-labelledby="track-practice-heading">
        <div class="learn-section-heading">
          <h2 id="track-practice-heading">Practice In This Track</h2>
          <p>Use labs after the relevant module introduces the concept, boundary, and artifact.</p>
        </div>
        <ul class="learn-track-practice__list">
          {labs.map((lab) => (
            <li>
              <div>
                <h3><a href={labPath(lab)}>{lab.data.title}</a></h3>
                <p>{lab.data.summary}</p>
              </div>
              <span>{lab.data.estimatedMinutes} min</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="learn-track-about learn-surface-reference" aria-labelledby="track-about-heading">
      <h2 id="track-about-heading">About This Track</h2>
      <div class="learn-content-body">
        <Content />
      </div>
    </section>

    <details class="learn-track-roadmap learn-surface-roadmap">
      <summary>Beta Status And Roadmap</summary>
      <div class="learn-track-roadmap__grid">
        <div>
          <h2>What Exists Now</h2>
          <p>{track.data.whatExistsNow}</p>
        </div>
        <div>
          <h2>What Is Coming Next</h2>
          <p>{track.data.whatComingNext}</p>
        </div>
      </div>
    </details>
  </PageShell>
</BaseLayout>

<style>
  .learn-track-page {
    display: grid;
    gap: 0.9rem;
    margin-inline: auto;
    max-width: min(100%, 1440px);
  }

  .learn-breadcrumb,
  .learn-meta-row {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .learn-track-hero {
    align-items: start;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .learn-track-hero__main {
    align-items: end;
    display: grid;
    gap: 0.55rem 1rem;
    grid-template-columns: minmax(0, 1fr) auto;
    max-width: none;
  }

  .learn-track-hero h1,
  .learn-track-hero p {
    margin: 0;
  }

  .learn-track-hero h1 {
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.05;
  }

  .learn-track-hero .learn-meta-row,
  .learn-track-hero h1,
  .learn-track-hero .text-lead,
  .learn-track-hero__empty {
    grid-column: 1;
  }

  .learn-track-hero .button {
    align-self: end;
    grid-column: 2;
    grid-row: 1 / span 3;
  }

  .learn-track-hero__empty {
    color: var(--aiv-text-muted);
    font-weight: 800;
  }

  .learn-track-layout {
    align-items: start;
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 22rem);
  }

  .learn-track-main {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
  }

  .learn-track-rail {
    align-self: start;
    display: grid;
    gap: 1rem;
    padding: 1rem;
  }

  .learn-track-rail h2 {
    font-size: 1rem;
    margin: 0 0 0.45rem;
  }

  .learn-track-rail ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.1rem;
  }

  .learn-track-rail p {
    color: var(--aiv-text-secondary);
    margin: 0;
  }

  .learn-section-heading {
    align-items: end;
    display: grid;
    gap: 0.45rem;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 42ch);
    justify-content: space-between;
  }

  .learn-section-heading h2,
  .learn-section-heading p {
    margin: 0;
  }

  .learn-section-heading p {
    color: var(--aiv-text-muted);
  }

  .button {
    background: var(--aiv-action-primary);
    border: 1px solid var(--aiv-action-primary);
    border-radius: 6px;
    color: var(--aiv-bg-canvas);
    display: inline-flex;
    font-weight: 800;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.6rem 0.95rem;
    text-decoration: none;
    width: fit-content;
  }

  .learn-track-practice,
  .learn-track-about,
  .learn-track-roadmap {
    display: grid;
    gap: 1rem;
    padding: 1rem;
  }

  .learn-track-practice__list {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .learn-track-practice__list li {
    align-items: start;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(0, 1fr) auto;
    padding-block: 0.85rem;
  }

  .learn-track-practice__list li + li {
    border-top: 1px solid color-mix(in srgb, var(--aiv-risk) 28%, var(--aiv-line-subtle));
  }

  .learn-track-practice__list h3,
  .learn-track-practice__list p {
    margin: 0;
  }

  .learn-track-practice__list p {
    color: var(--aiv-text-secondary);
    margin-top: 0.25rem;
  }

  .learn-track-practice__list span {
    color: var(--aiv-text-muted);
    font-family: var(--aiv-font-mono);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .learn-content-body {
    max-width: 82ch;
  }

  .learn-track-about h2 {
    margin: 0;
  }

  .learn-track-roadmap {
    display: block;
  }

  .learn-track-roadmap summary {
    color: var(--aiv-action-primary);
    cursor: pointer;
    font-weight: 800;
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
  }

  .learn-track-roadmap__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 0 1rem 1rem;
  }

  .learn-track-roadmap h2,
  .learn-track-roadmap p {
    margin: 0;
  }

  .learn-track-roadmap h2 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  .button:focus-visible,
  .learn-track-practice a:focus-visible,
  .learn-track-roadmap summary:focus-visible {
    outline: 3px solid var(--aiv-focus-ring);
    outline-offset: 3px;
  }

  @media (max-width: 980px) {
    .learn-track-layout,
    .learn-section-heading,
    .learn-track-roadmap__grid {
      grid-template-columns: 1fr;
    }

    .learn-track-hero__main {
      grid-template-columns: 1fr;
    }

    .learn-track-hero .button {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (max-width: 620px) {
    .learn-track-practice__list li {
      grid-template-columns: 1fr;
    }
  }
</style>
