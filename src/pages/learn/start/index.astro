---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageShell from "../../../components/layout/PageShell.astro";
import TrackCard from "../../../components/learn/TrackCard.astro";
import { canRenderLearnModule, refId } from "../../../utils/learn";

const starterTrackSlugs = ["ai-fundamentals", "ai-practitioner", "ai-builder-core", "ai-security-core"];
const tracks = await getCollection("learnTracks", ({ data }) => data.status !== "draft");
const modules = await getCollection("learnModules");
const moduleBySlug = new Map(modules.flatMap((module) => [[module.data.slug, module], [module.id, module]]));
const trackBySlug = new Map(tracks.flatMap((track) => [[track.data.slug, track], [track.id, track]]));
const starterTracks = starterTrackSlugs.map((slug) => trackBySlug.get(slug)).filter((track) => Boolean(track)) as typeof tracks;

function publicModuleCount(track: (typeof tracks)[number]) {
  return track.data.canonicalModules
    .map((moduleRef) => moduleBySlug.get(refId(moduleRef)))
    .filter((module) => module && canRenderLearnModule(module)).length;
}
---

<BaseLayout title="Start Learning" canonical="/learn/start/" description="Starting points for the AI Village Learn curriculum beta.">
  <PageShell class="learn-page">
    <h1>Start Learning</h1>
    <p class="text-lead">
      Pick the track that matches what you are trying to do now. Stage is not a global prerequisite chain; prerequisites are listed on tracks and modules.
    </p>
    <div class="learn-grid">
      {starterTracks.map((track) => <TrackCard track={track} publicModuleCount={publicModuleCount(track)} />)}
    </div>
    <section class="card card--accent-muted">
      <h2 class="mt-0">Beta Notes</h2>
      <p>
        The beta is organized around track paths and module checkpoints. Start with a track, work module by module, and use resources, labs, and series as supporting material. Some deeper examples, role-specific scenarios, and authored security prose are still expanding.
      </p>
    </section>
  </PageShell>
</BaseLayout>

<style>
  .learn-page {
    display: grid;
    gap: 2rem;
  }

  .learn-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
</style>
