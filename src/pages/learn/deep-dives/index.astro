---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageShell from "../../../components/layout/PageShell.astro";
import TrackCard from "../../../components/learn/TrackCard.astro";
import ResourceCard from "../../../components/learn/ResourceCard.astro";
import { byTitle, canRenderLearnModule, refId } from "../../../utils/learn";

const advancedTrackSlugs = [
  "agentic-ai-advanced-builder",
  "defensive-ai-engineering",
  "evals-reliability-grt",
  "offensive-ai-security-red-teaming",
];
const allTracks = await getCollection("learnTracks", ({ data }) => data.status !== "draft");
const trackBySlug = new Map(allTracks.flatMap((track) => [[track.data.slug, track], [track.id, track]]));
const tracks = advancedTrackSlugs.map((slug) => trackBySlug.get(slug)).filter((track) => Boolean(track)) as typeof allTracks;
const modules = await getCollection("learnModules");
const moduleBySlug = new Map(modules.flatMap((module) => [[module.data.slug, module], [module.id, module]]));
const resources = (await getCollection("learnResources", ({ data }) => data.status !== "draft"))
  .filter((resource) => resource.data.difficulty === "advanced" || resource.data.difficulty === "expert")
  .sort(byTitle);

function publicModuleCount(track: (typeof tracks)[number]) {
  return track.data.canonicalModules
    .map((moduleRef) => moduleBySlug.get(refId(moduleRef)))
    .filter((module) => module && canRenderLearnModule(module)).length;
}
---

<BaseLayout title="Learn Deep Dives" canonical="/learn/deep-dives/" description="Advanced AI Village Learn beta tracks and resources.">
  <PageShell class="learn-page">
    <h1>Deep Dives</h1>
    <p class="text-lead">
      Advanced paths for agentic builders, authorized AI security work, defensive engineering, evals, reliability, and GRT-style contribution.
    </p>
    <section>
      <h2>Advanced Tracks</h2>
      <div class="learn-grid">
        {tracks.map((track) => <TrackCard track={track} publicModuleCount={publicModuleCount(track)} />)}
      </div>
    </section>
    <section>
      <h2>Advanced Resources</h2>
      <div class="learn-grid">
        {resources.map((resource) => <ResourceCard resource={resource} />)}
      </div>
    </section>
  </PageShell>
</BaseLayout>

<style>
  .learn-page {
    display: grid;
    gap: 2rem;
  }

  .learn-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
</style>
