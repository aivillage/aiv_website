---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageShell from "../../../components/layout/PageShell.astro";

const gates = [
  "No link-dump PRs.",
  "No resource without rights metadata.",
  "No resource without targetStage and difficulty.",
  "Required resources must be free, no-login, no-application, and directly accessible.",
  "Extra resources may require account or enrollment only when clearly labeled and kept outside the core path.",
  "No payment-gated core content.",
  "Official or creator-owned videos are preferred for embedding.",
  "Security, offensive, and evals videos require conservative review.",
  "No module can be stable with missing required Security Lens prose.",
  "No lab without a safetyBoundary.",
  "No offensive lab can be stable without a defensive debrief.",
  "No top-level track without requiredArtifacts.",
  "No coming_soon or beta top-level track without whatExistsNow and whatComingNext.",
  "No duplicate Evals/GRT and Research/GRT tracks.",
  "No promotion of resources with unresolved license status.",
  "No new original lab build unless a clear external gap exists.",
  "No required age-restricted video resource.",
];
---

<BaseLayout title="Contribute to Learn" canonical="/learn/contribute/" description="Publishing gates for AI Village Learn curriculum contributions.">
  <PageShell class="learn-page">
    <h1>Contribute to Learn</h1>
    <p class="text-lead">
      AI Village Learn is a curated curriculum beta, not an unreviewed link collection. Contributions need clear metadata, rights information, stage fit, and safety boundaries.
    </p>

    <section class="card card--accent-primary">
      <h2 class="mt-0">Publishing Gates</h2>
      <ul>
        {gates.map((gate) => <li>{gate}</li>)}
      </ul>
    </section>

    <section>
      <h2>Content Scope</h2>
      <p>
        The curriculum beta separates metadata from reviewed lesson content. Security Lens prose, lab debriefs, threat-model templates, eval-card templates, risk-memo templates, and full course copy need separate review.
      </p>
      <p>
        Contributions should keep Learn broad: AI fundamentals, practical use, builders, agents, security, defensive engineering, evals, governance, and contributor paths all belong here.
      </p>
    </section>

    <section>
      <h2>Video Embeds</h2>
      <p>
        Learn may embed YouTube videos only through the official player with creator attribution and a direct source link. Do not download, rehost, clip, mirror, modify, scrape, or republish videos, captions, or transcripts.
      </p>
      <p>
        Privacy-enhanced embeds are preferred. Videos must not autoplay on page load; click-to-load autoplay after explicit learner action is acceptable. Age-restricted videos should not be required curriculum.
      </p>
      <p>
        Use one featured embed per module by default, and use playlist links for series instead of a wall of iframes. Playlist links are encouraged when available, and courtesy outreach is recommended when a small creator's full series becomes central to a track.
      </p>
      <p>
        Pages with third-party YouTube embeds need meaningful AI Village learning context, such as framing, artifact guidance, source attribution, and relevant Security Lens context. Do not add sponsor, ad, or promotional placement to pages where third-party YouTube videos are the main draw.
      </p>
    </section>
  </PageShell>
</BaseLayout>

<style>
  .learn-page {
    display: grid;
    gap: 2rem;
  }
</style>
