---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageShell from "../../components/layout/PageShell.astro";
import TrackCard from "../../components/learn/TrackCard.astro";
import StatusBadge from "../../components/learn/StatusBadge.astro";
import { byTrackKindThenTitle, canRenderLearnModule, refId } from "../../utils/learn";

const tracks = (await getCollection("learnTracks", ({ data }) => data.status !== "draft")).sort(byTrackKindThenTitle);
const modules = await getCollection("learnModules");
const moduleBySlug = new Map(modules.flatMap((module) => [[module.data.slug, module], [module.id, module]]));
const browseCards = [
  {
    title: "Labs",
    href: "/learn/labs/",
    text: "Use safety-bounded hands-on labs when a module calls for practice.",
  },
  {
    title: "Resources",
    href: "/learn/resources/",
    text: "Browse curated no-login resources, videos, docs, and off-ramp links.",
  },
  {
    title: "Video series",
    href: "/learn/series/",
    text: "Follow ordered video paths with episode focus and checkpoints.",
  },
  {
    title: "Contribute",
    href: "/learn/contribute/",
    text: "Review the publishing gates before proposing resources, modules, or labs.",
  },
  {
    title: "Glossary",
    href: "/learn/glossary/",
    text: "Look up shared terms used across tracks, modules, labs, and resources.",
  },
  {
    title: "Deep dives",
    href: "/learn/deep-dives/",
    text: "Use longer reference notes after the main path gives you context.",
  },
];
const primaryCards = [
  {
    title: "Start here",
    href: "/learn/start/",
    text: "Begin with the broadest entry points and move into the first useful modules.",
  },
  {
    title: "Choose your path",
    href: "/learn/choose-your-path/",
    text: "Find the track that matches your current role, artifact, or learning goal.",
  },
];

function publicModuleCount(track: (typeof tracks)[number]) {
  return track.data.canonicalModules
    .map((moduleRef) => moduleBySlug.get(refId(moduleRef)))
    .filter((module) => module && canRenderLearnModule(module)).length;
}
---

<BaseLayout
  title="Learn"
  canonical="/learn/"
  description="AI Village Learn is a curriculum beta for broad public-interest AI learning with security built in."
>
  <PageShell class="learn-page">
    <section class="learn-hero">
      <div>
        <div class="learn-kicker"><StatusBadge value="beta" /> Curriculum beta</div>
        <h1>AI Village Learn</h1>
        <p class="text-lead">
          A broad public-interest AI learning hub for people new to AI, practitioners, builders, agent developers, security teams, eval contributors, and governance learners.
        </p>
        <p>
          Follow a path, use the core no-login resources, produce a small artifact, then move deeper when the checkpoint is clear. Security is built into each path as review questions, lab safety boundaries, and defensive checkpoints.
        </p>
      </div>
      <nav class="learn-actions" aria-label="Learn navigation">
        <a class="button" href="/learn/start/">Start here</a>
        <a class="button button--secondary" href="/learn/choose-your-path/">Choose your path</a>
      </nav>
    </section>

    <section class="learn-nav-grid learn-nav-grid--primary" aria-label="Primary Learn sections">
      {primaryCards.map((card) => (
        <a class="learn-nav-card" href={card.href}>
          <h2>{card.title}</h2>
          <p>{card.text}</p>
        </a>
      ))}
    </section>

    <section class="learn-flow-strip" aria-label="How Learn works">
      <h2>How Learn Works</h2>
      <ol>
        <li>Track</li>
        <li>Module</li>
        <li>Resource/Lab</li>
        <li>Checkpoint</li>
      </ol>
    </section>

    <section class="learn-secondary-links" aria-label="Browse and reference">
      <div>
        <h2>Browse And Reference</h2>
        <p>Use catalogs after you have started a path, or when a module points you to a specific lab, resource, series, or reference page.</p>
      </div>
      <div class="learn-nav-grid">
        {browseCards.map((card) => (
          <a class="learn-nav-card learn-nav-card--secondary" href={card.href}>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2>Tracks</h2>
      <p>
        Tracks represent learner intent. Stage describes demonstrated capability and artifact maturity. Difficulty describes the content item itself.
      </p>
      <div class="learn-grid">
        {tracks.map((track) => <TrackCard track={track} publicModuleCount={publicModuleCount(track)} />)}
      </div>
    </section>

    <section class="card card--accent-primary">
      <h2 class="mt-0">What This Beta Is</h2>
      <p>
        This curriculum beta organizes tracks, modules, resources, labs, and navigation. It does not claim completion, certification, mastery, or production readiness.
      </p>
      <p>
        AI security is a first-class path, and security thinking also appears as lightweight checkpoints in fundamentals, practitioner, builder, agentic, evals, and governance paths.
      </p>
    </section>
  </PageShell>
</BaseLayout>

<style>
  .learn-page {
    display: grid;
    gap: 2rem;
  }

  .learn-hero {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr) auto;
    padding-top: 1rem;
  }

  .learn-kicker,
  .learn-actions,
  .learn-nav-grid,
  .learn-grid {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .learn-kicker {
    color: var(--aiv-text-muted);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .learn-actions {
    align-content: start;
    justify-content: end;
  }

  .learn-secondary-links {
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 8px;
    display: grid;
    gap: 1rem;
    padding: 1rem;
  }

  .learn-secondary-links h2,
  .learn-secondary-links p {
    margin: 0;
  }

  .learn-secondary-links h2 {
    font-size: 1.1rem;
  }

  .button {
    background: var(--aiv-action-primary);
    border: 1px solid var(--aiv-action-primary);
    border-radius: 6px;
    color: var(--aiv-bg-canvas);
    display: inline-flex;
    font-weight: 800;
    min-height: 2.75rem;
    padding: 0.6rem 0.95rem;
    text-decoration: none;
  }

  .button--secondary {
    background: transparent;
    color: var(--aiv-action-primary);
  }

  .learn-nav-grid {
    align-items: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .learn-nav-grid--primary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .learn-nav-card {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-radius: 8px;
    box-shadow: var(--aiv-card-shadow);
    color: inherit;
    display: grid;
    gap: 0.45rem;
    padding: 1rem;
    text-decoration: none;
  }

  .learn-nav-card h2 {
    font-size: 1.1rem;
    margin: 0;
  }

  .learn-nav-card h3 {
    font-size: 1rem;
    margin: 0;
  }

  .learn-nav-card--secondary {
    background: var(--aiv-card-bg);
    box-shadow: none;
  }

  .learn-nav-card p {
    color: var(--aiv-text-muted);
    margin: 0;
  }

  .learn-flow-strip {
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 8px;
    padding: 1rem;
  }

  .learn-flow-strip h2 {
    font-size: 1.1rem;
    margin-top: 0;
  }

  .learn-flow-strip ol {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .learn-flow-strip li {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-radius: 8px;
    font-weight: 800;
    padding: 0.75rem;
    text-align: center;
  }

  .learn-grid {
    align-items: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: 1.25rem;
  }

  @media (max-width: 780px) {
    .learn-hero,
    .learn-nav-grid--primary,
    .learn-flow-strip ol {
      grid-template-columns: 1fr;
    }

    .learn-actions {
      justify-content: start;
    }
  }
</style>
