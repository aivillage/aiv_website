---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageShell from "../../components/layout/PageShell.astro";
import TrackCard from "../../components/learn/TrackCard.astro";
import StatusBadge from "../../components/learn/StatusBadge.astro";
import { byTitle, canRenderLearnModule, entrySlug, refId } from "../../utils/learn";

const allTracks = await getCollection("learnTracks", ({ data }) => data.status !== "draft");
const modules = await getCollection("learnModules");
const moduleBySlug = new Map(modules.flatMap((module) => [[module.data.slug, module], [module.id, module]]));
const trackBySlug = new Map(allTracks.flatMap((track) => [[entrySlug(track), track], [track.id, track]]));
const learnerTrackOrder = [
  "ai-fundamentals",
  "ai-practitioner",
  "ai-builder-core",
  "agentic-ai-advanced-builder",
  "evals-reliability-grt",
  "ai-security-core",
  "offensive-ai-security-red-teaming",
  "defensive-ai-engineering",
  "governance-responsible-use",
];
const orderedTracks = learnerTrackOrder
  .map((slug) => trackBySlug.get(slug))
  .filter((track): track is (typeof allTracks)[number] => Boolean(track));
const remainingTracks = allTracks
  .filter((track) => !learnerTrackOrder.includes(entrySlug(track)))
  .sort(byTitle);
const tracks = [...orderedTracks, ...remainingTracks];
const recommendedStartSlugs = ["ai-fundamentals", "ai-practitioner", "ai-builder-core", "ai-security-core"];
const recommendedTracks = recommendedStartSlugs
  .map((slug) => trackBySlug.get(slug))
  .filter((track): track is (typeof allTracks)[number] => Boolean(track));
const browseCards = [
  {
    title: "Resources",
    href: "/learn/resources/",
    text: "Browse curated no-login resources, videos, docs, and off-ramp links.",
  },
  {
    title: "Labs",
    href: "/learn/labs/",
    text: "Return to safety-bounded practice labs after a module introduces them.",
  },
  {
    title: "Video series",
    href: "/learn/series/",
    text: "Follow ordered video paths with episode focus and checkpoints.",
  },
  {
    title: "Contribute",
    href: "/learn/contribute/",
    text: "Review the publishing gates before proposing resources, modules, or labs.",
  },
  {
    title: "Glossary",
    href: "/learn/glossary/",
    text: "Look up shared terms used across tracks, modules, labs, and resources.",
  },
  {
    title: "Deep dives",
    href: "/learn/deep-dives/",
    text: "Use longer reference notes after the main path gives you context.",
  },
];

function publicModuleCount(track: (typeof tracks)[number]) {
  return track.data.canonicalModules
    .map((moduleRef) => moduleBySlug.get(refId(moduleRef)))
    .filter((module) => module && canRenderLearnModule(module)).length;
}
---

<BaseLayout
  title="Learn"
  canonical="/learn/"
  description="AI Village Learn is a curriculum beta for broad public-interest AI learning with security built in."
>
  <PageShell class="learn-page" width="wide">
    <section class="learn-hero">
      <div>
        <div class="learn-kicker"><StatusBadge value="beta" /> Curriculum beta</div>
        <h1>AI Village Learn</h1>
        <p class="text-lead">
          A guided curriculum for people new to AI, practitioners, builders, agent developers, security teams, eval contributors, and governance learners.
        </p>
        <p>
          Start with a path, complete the modules, use resources and labs as support, then produce a checkpoint artifact you can review. Security is built into that flow.
        </p>
      </div>
      <nav class="learn-actions" aria-label="Learn navigation">
        <a class="button" href="/learn/start/">Start learning</a>
        <a class="button button--secondary" href="/learn/choose-your-path/">Choose your path</a>
      </nav>
    </section>

    <section class="learn-flow-strip" aria-label="How Learn works">
      <h2>How Learn Works</h2>
      <ol>
        <li>
          <span>Choose a track</span>
        </li>
        <li>
          <span>Complete modules</span>
        </li>
        <li>
          <span>Use resources/labs</span>
        </li>
        <li>
          <span>Produce checkpoints</span>
        </li>
      </ol>
    </section>

    <section class="learn-starting-points" aria-labelledby="recommended-starting-points">
      <div class="learn-section-intro">
        <h2 id="recommended-starting-points">Recommended Starting Points</h2>
        <p>Most learners should begin with one of these four paths, then move into advanced tracks after the first checkpoint is clear.</p>
      </div>
      <div class="learn-grid learn-grid--starting">
        {recommendedTracks.map((track) => (
          <TrackCard track={track} publicModuleCount={publicModuleCount(track)} ctaLabel="Start track" />
        ))}
      </div>
    </section>

    <section class="learn-all-tracks" aria-labelledby="all-learn-tracks">
      <h2 id="all-learn-tracks">All Tracks</h2>
      <p>
        Tracks represent learner intent. Start with the closest path, then use advanced and specialist tracks when their prerequisites match your current work.
      </p>
      <div class="learn-grid">
        {tracks.map((track) => <TrackCard track={track} publicModuleCount={publicModuleCount(track)} />)}
      </div>
    </section>

    <section class="learn-secondary-links" aria-label="Browse and reference">
      <div class="learn-section-intro">
        <h2>Browse And Reference</h2>
        <p>Use catalogs after you have started a path, or when a module points you to a specific lab, resource, series, or reference page.</p>
      </div>
      <div class="learn-nav-grid">
        {browseCards.map((card) => (
          <a class="learn-nav-card learn-nav-card--secondary" href={card.href}>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="card card--accent-primary">
      <h2 class="mt-0">What This Beta Is</h2>
      <p>
        This curriculum beta organizes tracks, modules, resources, labs, and navigation. It does not claim completion, certification, mastery, or production readiness.
      </p>
      <p>
        AI security is a first-class path, and security thinking also appears as lightweight checkpoints in fundamentals, practitioner, builder, agentic, evals, and governance paths.
      </p>
    </section>
  </PageShell>
</BaseLayout>

<style>
  .learn-page {
    display: grid;
    gap: 2.4rem;
  }

  .learn-hero {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) auto;
    padding-top: 1rem;
  }

  .learn-kicker,
  .learn-actions,
  .learn-nav-grid,
  .learn-grid {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .learn-kicker {
    color: var(--aiv-text-muted);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .learn-actions {
    align-content: start;
    justify-content: end;
  }

  .learn-actions .button {
    font-size: 1rem;
  }

  .learn-section-intro {
    display: grid;
    gap: 0.45rem;
  }

  .learn-section-intro h2,
  .learn-section-intro p {
    margin: 0;
  }

  .learn-secondary-links {
    border-top: 1px solid var(--aiv-line-subtle);
    border-radius: 8px;
    display: grid;
    gap: 1.1rem;
    padding-top: 1.5rem;
  }

  .learn-secondary-links h2 {
    font-size: 1.1rem;
  }

  .button {
    background: var(--aiv-action-primary);
    border: 1px solid var(--aiv-action-primary);
    border-radius: 6px;
    color: var(--aiv-bg-canvas);
    display: inline-flex;
    font-weight: 800;
    min-height: 2.75rem;
    padding: 0.6rem 0.95rem;
    text-decoration: none;
  }

  .button--secondary {
    background: transparent;
    color: var(--aiv-action-primary);
  }

  .button:focus-visible,
  .learn-nav-card:focus-visible {
    outline: 3px solid var(--aiv-focus-ring);
    outline-offset: 3px;
  }

  .learn-nav-grid {
    align-items: stretch;
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .learn-nav-card {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-radius: 8px;
    box-shadow: var(--aiv-card-shadow);
    color: inherit;
    display: grid;
    gap: 0.45rem;
    padding: 1rem;
    text-decoration: none;
  }

  .learn-nav-card h2 {
    font-size: 1.1rem;
    margin: 0;
  }

  .learn-nav-card h3 {
    font-size: 1rem;
    margin: 0;
  }

  .learn-nav-card--secondary {
    background: color-mix(in srgb, var(--aiv-card-bg) 56%, transparent);
    border-color: var(--aiv-line-subtle);
    box-shadow: none;
  }

  .learn-nav-card p {
    color: var(--aiv-text-muted);
    margin: 0;
  }

  .learn-flow-strip {
    border-block: 1px solid var(--aiv-line-subtle);
    border-radius: 8px;
    padding: 1.15rem 0;
  }

  .learn-flow-strip h2 {
    font-size: 1.1rem;
    margin-top: 0;
  }

  .learn-flow-strip ol {
    counter-reset: learn-flow;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .learn-flow-strip li {
    align-items: center;
    background: color-mix(in srgb, var(--aiv-card-bg) 72%, transparent);
    border: 1px solid var(--aiv-line-subtle);
    border-radius: 8px;
    color: var(--aiv-text-secondary);
    display: flex;
    gap: 0.65rem;
    font-weight: 800;
    min-height: 3rem;
    padding: 0.55rem 0.85rem;
  }

  .learn-flow-strip li::before {
    align-items: center;
    background: color-mix(in srgb, var(--aiv-action-secondary) 22%, transparent);
    border: 1px solid var(--aiv-action-secondary);
    border-radius: 999px;
    color: var(--aiv-text-primary);
    content: counter(learn-flow);
    counter-increment: learn-flow;
    display: inline-flex;
    flex: 0 0 auto;
    font-family: var(--aiv-font-mono);
    font-size: 0.85rem;
    height: 2rem;
    justify-content: center;
    width: 2rem;
  }

  .learn-starting-points,
  .learn-all-tracks {
    display: grid;
    gap: 1rem;
  }

  .learn-grid {
    align-items: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: 1.25rem;
  }

  .learn-grid--starting {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 780px) {
    .learn-hero,
    .learn-flow-strip ol,
    .learn-grid--starting {
      grid-template-columns: 1fr;
    }

    .learn-actions {
      justify-content: start;
    }
  }
</style>
