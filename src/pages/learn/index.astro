---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageShell from "../../components/layout/PageShell.astro";
import TrackCard from "../../components/learn/TrackCard.astro";
import StatusBadge from "../../components/learn/StatusBadge.astro";
import { byTrackKindThenTitle } from "../../utils/learn";

const tracks = (await getCollection("learnTracks", ({ data }) => data.status !== "draft")).sort(byTrackKindThenTitle);
const betaTracks = tracks.filter((track) => track.data.status === "beta").length;
---

<BaseLayout
  title="Learn"
  canonical="/learn/"
  description="AI Village Learn is a curriculum beta for broad public-interest AI learning with security built in."
>
  <PageShell class="learn-page">
    <section class="learn-hero">
      <div>
        <div class="learn-kicker"><StatusBadge value="beta" /> Curriculum beta</div>
        <h1>AI Village Learn</h1>
        <p class="text-lead">
          A broad public-interest AI learning hub for people new to AI, practitioners, builders, agent developers, security teams, eval contributors, and governance learners.
        </p>
        <p>
          Security is built in as checkpoints across the curriculum and as first-class security tracks. Reviewed lessons, exercises, and debriefs are being added throughout the curriculum beta.
        </p>
      </div>
      <nav class="learn-actions" aria-label="Learn navigation">
        <a class="button" href="/learn/start/">Start</a>
        <a class="button button--secondary" href="/learn/choose-your-path/">Choose your path</a>
        <a class="button button--secondary" href="/learn/resources/">Resources</a>
      </nav>
    </section>

    <section class="learn-stat-grid" aria-label="Curriculum status">
      <div>
        <strong>{tracks.length}</strong>
        <span>public tracks</span>
      </div>
      <div>
        <strong>{betaTracks}</strong>
        <span>beta tracks</span>
      </div>
      <div>
        <strong>Beta</strong>
        <span>lessons expanding</span>
      </div>
    </section>

    <section>
      <h2>Tracks</h2>
      <p>
        Tracks represent learner intent. Stage describes demonstrated capability and artifact maturity. Difficulty describes the content item itself.
      </p>
      <div class="learn-grid">
        {tracks.map((track) => <TrackCard track={track} />)}
      </div>
    </section>

    <section class="card card--accent-primary">
      <h2 class="mt-0">What This Beta Is</h2>
      <p>
        This curriculum beta organizes tracks, modules, resources, labs, and navigation. It does not claim completion, certification, mastery, or production readiness.
      </p>
      <p>
        AI security is a first-class path, and security thinking also appears as lightweight checkpoints in fundamentals, practitioner, builder, agentic, evals, and governance paths.
      </p>
    </section>
  </PageShell>
</BaseLayout>

<style>
  .learn-page {
    display: grid;
    gap: 2rem;
  }

  .learn-hero {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr) auto;
    padding-top: 1rem;
  }

  .learn-kicker,
  .learn-actions,
  .learn-stat-grid,
  .learn-grid {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .learn-kicker {
    color: var(--aiv-text-muted);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .learn-actions {
    align-content: start;
    justify-content: end;
  }

  .button {
    background: var(--aiv-action-primary);
    border: 1px solid var(--aiv-action-primary);
    border-radius: 6px;
    color: var(--aiv-bg-canvas);
    display: inline-flex;
    font-weight: 800;
    min-height: 2.75rem;
    padding: 0.6rem 0.95rem;
    text-decoration: none;
  }

  .button--secondary {
    background: transparent;
    color: var(--aiv-action-primary);
  }

  .learn-stat-grid {
    align-items: stretch;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .learn-stat-grid div {
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 8px;
    padding: 1rem;
  }

  .learn-stat-grid strong,
  .learn-stat-grid span {
    display: block;
  }

  .learn-stat-grid strong {
    font-size: 1.65rem;
  }

  .learn-grid {
    align-items: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: 1.25rem;
  }

  @media (max-width: 780px) {
    .learn-hero,
    .learn-stat-grid {
      grid-template-columns: 1fr;
    }

    .learn-actions {
      justify-content: start;
    }
  }
</style>
