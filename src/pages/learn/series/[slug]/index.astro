---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageShell from "../../../../components/layout/PageShell.astro";
import {
  accessModeLabels,
  byTitle,
  entrySlug,
  findPublicCanonicalTracksForModule,
  formatLabel,
  isPlaylistResource,
  modulePath,
  refId,
  resourcePath,
  seriesPath,
  trackPath,
  trackScopedModulePath,
} from "../../../../utils/learn";

type Props = {
  series: CollectionEntry<"learnResources">;
  episodes: CollectionEntry<"learnResources">[];
  tracks: CollectionEntry<"learnTracks">[];
  allTracks: CollectionEntry<"learnTracks">[];
  modules: CollectionEntry<"learnModules">[];
};

export async function getStaticPaths() {
  const resources = await getCollection("learnResources", ({ data }) => data.status !== "draft");
  const tracks = await getCollection("learnTracks", ({ data }) => data.status !== "draft");
  const modules = await getCollection("learnModules", ({ data }) => data.status !== "draft");
  const trackBySlug = new Map(tracks.flatMap((track) => [[entrySlug(track), track], [track.id, track]]));
  const seriesResources = resources.filter(isPlaylistResource);

  return seriesResources.map((series) => {
    const seriesSlug = entrySlug(series);
    const episodes = resources
      .filter((resource) => resource.data.seriesSlug === seriesSlug)
      .sort((left, right) => {
        const leftOrder = left.data.episodeOrder ?? Number.POSITIVE_INFINITY;
        const rightOrder = right.data.episodeOrder ?? Number.POSITIVE_INFINITY;
        if (leftOrder !== rightOrder) return leftOrder - rightOrder;
        return byTitle(left, right);
      });
    const relatedTracks = series.data.tracks
      .map((trackRef) => trackBySlug.get(refId(trackRef)))
      .filter((track): track is CollectionEntry<"learnTracks"> => Boolean(track))
      .sort(byTitle) as CollectionEntry<"learnTracks">[];

    return {
      params: { slug: seriesSlug },
      props: { series, episodes, tracks: relatedTracks, allTracks: tracks, modules },
    };
  });
}

const { series, episodes, tracks, allTracks, modules } = Astro.props;
const creator = series.data.creator || series.data.attribution || series.data.provider;
const accessLabel = accessModeLabels[series.data.accessMode] || accessModeLabels.direct_open;
const episodeCount = episodes.length;
const pathLabel = episodeCount === 0 ? "Episode Path Not Ready" : episodeCount === 1 ? "Single Selected Episode" : "AIV-Selected Episode Path";

function episodeModules(episode: CollectionEntry<"learnResources">) {
  const episodeSlug = entrySlug(episode);
  const canonicalFor = new Set(episode.data.canonicalFor.map(refId));
  return modules.filter((module) =>
    canonicalFor.has(entrySlug(module)) ||
    module.data.resources.some((link) => refId(link.resource) === episodeSlug)
  ).slice(0, 3);
}

function episodeModulePath(module: CollectionEntry<"learnModules">) {
  const canonicalTracks = findPublicCanonicalTracksForModule(module, allTracks);
  return canonicalTracks.length === 1 ? trackScopedModulePath(canonicalTracks[0], module) : modulePath(module);
}

function episodeModuleTrack(module: CollectionEntry<"learnModules">) {
  const canonicalTracks = findPublicCanonicalTracksForModule(module, allTracks);
  return canonicalTracks.length === 1 ? canonicalTracks[0] : undefined;
}
---

<BaseLayout title={series.data.title} canonical={seriesPath(series)} description={`Learn series from ${series.data.provider}: ${series.data.title}.`}>
  <PageShell class="learn-series-page">
    <nav class="learn-breadcrumb" aria-label="Breadcrumb"><a href="/learn/">Learn</a> / <a href="/learn/series/">Series</a> / <span>{series.data.title}</span></nav>

    <header class="learn-series-header">
      <div>
        <div class="learn-meta-row">
          <span>{formatLabel(series.data.resourceType)}</span>
          <span class="learn-access-badge">{accessLabel}</span>
          <span>{pathLabel}</span>
        </div>
        <h1>{series.data.title}</h1>
        <p class="text-lead">
          {episodeCount >= 2
            ? series.data.watchFocus || `An ordered learning path from ${creator}.`
            : episodeCount === 1
              ? `AI Village has selected one episode from ${creator}. Treat this as a focused resource path, not a full series.`
              : `Episode records for this playlist are not ready yet. Use the original source links as secondary context.`}
        </p>
      </div>
      <aside class="learn-side-panel">
        <h2>Source</h2>
        <p>{series.data.provider}</p>
        <a href={series.data.canonicalUrl} target="_blank" rel="noopener noreferrer">Open original series</a>
        {series.data.playlistUrl && <a href={series.data.playlistUrl} target="_blank" rel="noopener noreferrer">Open playlist</a>}
      </aside>
    </header>

    <section class="learn-callout">
      <h2>How To Use This Series</h2>
      <p>
        {episodeCount >= 2
          ? "Watch episodes in order when you want the full path, or jump from a related module to the episode that supports its checkpoint. Each episode links to a resource detail page with focus and checkpoint notes."
          : episodeCount === 1
            ? "Use the selected episode from its resource page or related module. The full source remains secondary until more AIV-selected episodes are mapped."
            : "This playlist is not presented as a full Learn series until public episode records are mapped."}
      </p>
      {series.data.accessNotes && <p>{series.data.accessNotes}</p>}
    </section>

    {tracks.length > 0 && (
      <section>
        <h2>Related Tracks</h2>
        <ul class="learn-link-list">
          {tracks.map((track) => <li><a href={trackPath(track)}>{track.data.title}</a></li>)}
        </ul>
      </section>
    )}

    <section>
      <h2>{episodeCount === 1 ? "Selected Episode" : "Episodes"}</h2>
      {episodes.length > 0 ? (
        <ol class="learn-episode-list">
          {episodes.map((episode, index) => {
            const mappedModules = episodeModules(episode);

            return (
              <li class="learn-episode-card">
                <div class="learn-episode-card__order">Episode {episode.data.episodeOrder ?? index + 1}</div>
                <div class="learn-episode-card__body">
                  <h3><a href={resourcePath(episode)}>{episode.data.title}</a></h3>
                  <dl>
                    <div>
                      <dt>Focus</dt>
                      <dd>{episode.data.watchFocus || episode.data.provider}</dd>
                    </div>
                    {episode.data.checkpointPrompt && (
                      <div>
                        <dt>Checkpoint</dt>
                        <dd>{episode.data.checkpointPrompt}</dd>
                      </div>
                    )}
                    {mappedModules.length > 0 && (
                      <div>
                        <dt>Module mapping</dt>
                        <dd>
                          <ul class="learn-module-link-list">
                            {mappedModules.map((module) => {
                              const track = episodeModuleTrack(module);
                              return (
                                <li>
                                  <a href={episodeModulePath(module)}>
                                    <strong>{module.data.title}</strong>
                                    {track && <span>{" · "}{track.data.title}</span>}
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        </dd>
                      </div>
                    )}
                  </dl>
                  <div class="learn-episode-card__actions">
                    <a href={resourcePath(episode)}>View resource details</a>
                    {mappedModules.length > 0 && <a href={episodeModulePath(mappedModules[0])}>Continue in module</a>}
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      ) : (
        <section class="learn-callout">
          <h3>Episodes Coming Later</h3>
          <p>Episode records have not been added to this series yet. Use the source links above for the original series.</p>
        </section>
      )}
    </section>
  </PageShell>
</BaseLayout>

<style>
  .learn-series-page {
    display: grid;
    gap: 2rem;
  }

  .learn-breadcrumb,
  .learn-meta-row {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .learn-series-header,
  .learn-two-column {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
  }

  .learn-side-panel,
  .learn-callout {
    align-self: start;
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 8px;
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
  }

  .learn-side-panel h2,
  .learn-callout h2 {
    font-size: 1.1rem;
    margin-top: 0;
  }

  .learn-episode-list {
    display: grid;
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding-left: 0;
  }

  .learn-episode-card {
    background: var(--aiv-card-bg);
    border: 1px solid var(--aiv-card-border);
    border-radius: 8px;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: auto minmax(0, 1fr);
    padding: 1rem;
  }

  .learn-episode-card__order {
    align-items: center;
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 999px;
    display: inline-flex;
    font-weight: 800;
    height: 3rem;
    justify-content: center;
    line-height: 1.15;
    text-align: center;
    width: 4.6rem;
  }

  .learn-episode-card__body,
  .learn-episode-card dl,
  .learn-module-link-list {
    display: grid;
    gap: 0.75rem;
  }

  .learn-episode-card h3,
  .learn-episode-card dl,
  .learn-episode-card dd,
  .learn-module-link-list {
    margin: 0;
  }

  .learn-episode-card dt {
    color: var(--aiv-text-muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .learn-module-link-list {
    list-style: none;
    padding-left: 0;
  }

  .learn-module-link-list a {
    display: inline-grid;
    gap: 0.12rem;
    min-height: 2.35rem;
  }

  .learn-module-link-list span {
    color: var(--aiv-text-muted);
    font-size: 0.92rem;
  }

  .learn-episode-card__actions {
    align-items: center;
    border-top: 1px solid var(--aiv-line-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.75rem;
  }

  .learn-access-badge {
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 999px;
    color: var(--aiv-text);
    padding: 0.12rem 0.45rem;
  }

  .learn-episode-card a:focus-visible,
  .learn-side-panel a:focus-visible {
    outline: 3px solid var(--aiv-focus-ring);
    outline-offset: 3px;
  }

  @media (max-width: 780px) {
    .learn-series-header,
    .learn-two-column {
      grid-template-columns: 1fr;
    }

    .learn-episode-card {
      grid-template-columns: 1fr;
    }
  }
</style>
