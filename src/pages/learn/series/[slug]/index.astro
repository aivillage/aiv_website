---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageShell from "../../../../components/layout/PageShell.astro";
import ReferenceRail from "../../../../components/learn/ReferenceRail.astro";
import {
  accessModeLabels,
  byTitle,
  entrySlug,
  findPublicCanonicalTracksForModule,
  formatLabel,
  isPlaylistResource,
  modulePath,
  refId,
  resourcePath,
  seriesPath,
  trackPath,
  trackScopedModulePath,
} from "../../../../utils/learn";

type Props = {
  series: CollectionEntry<"learnResources">;
  episodes: CollectionEntry<"learnResources">[];
  tracks: CollectionEntry<"learnTracks">[];
  allTracks: CollectionEntry<"learnTracks">[];
  modules: CollectionEntry<"learnModules">[];
};

export async function getStaticPaths() {
  const resources = await getCollection("learnResources", ({ data }) => data.status !== "draft");
  const tracks = await getCollection("learnTracks", ({ data }) => data.status !== "draft");
  const modules = await getCollection("learnModules", ({ data }) => data.status !== "draft");
  const trackBySlug = new Map(tracks.flatMap((track) => [[entrySlug(track), track], [track.id, track]]));
  const seriesResources = resources.filter(isPlaylistResource);

  return seriesResources.map((series) => {
    const seriesSlug = entrySlug(series);
    const episodes = resources
      .filter((resource) => resource.data.seriesSlug === seriesSlug)
      .sort((left, right) => {
        const leftOrder = left.data.episodeOrder ?? Number.POSITIVE_INFINITY;
        const rightOrder = right.data.episodeOrder ?? Number.POSITIVE_INFINITY;
        if (leftOrder !== rightOrder) return leftOrder - rightOrder;
        return byTitle(left, right);
      });
    const relatedTracks = series.data.tracks
      .map((trackRef) => trackBySlug.get(refId(trackRef)))
      .filter((track): track is CollectionEntry<"learnTracks"> => Boolean(track))
      .sort(byTitle) as CollectionEntry<"learnTracks">[];

    return {
      params: { slug: seriesSlug },
      props: { series, episodes, tracks: relatedTracks, allTracks: tracks, modules },
    };
  });
}

const { series, episodes, tracks, allTracks, modules } = Astro.props;
const creator = series.data.creator || series.data.attribution || series.data.provider;
const accessLabel = accessModeLabels[series.data.accessMode] || accessModeLabels.direct_open;
const episodeCount = episodes.length;
const pathLabel = episodeCount === 0 ? "Episode path not ready" : episodeCount === 1 ? "Single selected episode" : "AIV-selected episode path";
const introText = episodeCount >= 2
  ? series.data.watchFocus || "Use the selected episodes in order, then continue through the module checkpoint each episode supports."
  : episodeCount === 1
    ? "AI Village has selected one episode from this source. Treat it as a focused resource path, not a full video course."
    : "Episode records for this playlist are not public yet. Use the original source only as secondary reference.";
const railSections = [
  {
    title: "Series Source",
    facts: [
      { label: "Provider", value: series.data.provider },
      { label: "Creator", value: creator },
      { label: "Access", value: accessLabel },
      { label: "Episodes mapped", value: `${episodeCount}` },
      { label: "Original", value: "Open original series", href: series.data.canonicalUrl, external: true },
      series.data.playlistUrl && series.data.playlistUrl !== series.data.canonicalUrl
        ? { label: "Playlist", value: "Open playlist", href: series.data.playlistUrl, external: true }
        : { label: "Playlist", value: "" },
    ],
  },
  {
    title: "Related Tracks",
    links: tracks.map((track) => ({ label: track.data.title, href: trackPath(track) })),
  },
  {
    title: "Use Pattern",
    text: "Choose an episode row first. Open the original playlist only after the module focus and checkpoint are clear.",
  },
];

function episodeModules(episode: CollectionEntry<"learnResources">) {
  const episodeSlug = entrySlug(episode);
  const canonicalFor = new Set(episode.data.canonicalFor.map(refId));
  return modules.filter((module) =>
    canonicalFor.has(entrySlug(module)) ||
    module.data.resources.some((link) => refId(link.resource) === episodeSlug)
  ).slice(0, 3);
}

function episodeModulePath(module: CollectionEntry<"learnModules">) {
  const canonicalTracks = findPublicCanonicalTracksForModule(module, allTracks);
  return canonicalTracks.length === 1 ? trackScopedModulePath(canonicalTracks[0], module) : modulePath(module);
}

function episodeModuleTrack(module: CollectionEntry<"learnModules">) {
  const canonicalTracks = findPublicCanonicalTracksForModule(module, allTracks);
  return canonicalTracks.length === 1 ? canonicalTracks[0] : undefined;
}
---

<BaseLayout title={series.data.title} canonical={seriesPath(series)} description={`Learn series from ${series.data.provider}: ${series.data.title}.`}>
  <PageShell class="learn-series-page" width="full">
    <div class="learn-series-page__inner">
      <nav class="learn-breadcrumb" aria-label="Breadcrumb"><a href="/learn/">Learn</a> / <a href="/learn/series/">Series</a> / <span>{series.data.title}</span></nav>

      <header class="learn-series-header">
        <div class="learn-meta-row">
          <span>{pathLabel}</span>
          <span>{formatLabel(series.data.resourceType)}</span>
          <span class="learn-access-badge">{accessLabel}</span>
        </div>
        <h1>{series.data.title}</h1>
        <p>{introText}</p>
      </header>

      <div class="learn-series-layout">
        <main class="learn-series-main">
          <section class="episode-path learn-surface-path" aria-labelledby="episode-path-heading">
            <div class="episode-path__header">
              <div>
                <span>Episode path</span>
                <h2 id="episode-path-heading">{episodeCount === 1 ? "Selected episode" : "Episodes"}</h2>
              </div>
              {episodeCount > 0 && <p>{episodeCount} mapped {episodeCount === 1 ? "episode" : "episodes"}</p>}
            </div>

            {episodes.length > 0 ? (
              <ol class="episode-path__list">
                {episodes.map((episode, index) => {
                  const mappedModules = episodeModules(episode);

                  return (
                    <li class="episode-path__item">
                      <div class="episode-path__marker" aria-label={`Episode ${episode.data.episodeOrder ?? index + 1}`}>{episode.data.episodeOrder ?? index + 1}</div>
                      <div class="episode-path__main">
                        <h3><a href={resourcePath(episode)}>{episode.data.title}</a></h3>
                        <div class="episode-path__details">
                          <div>
                            <span>Focus</span>
                            <p>{episode.data.watchFocus || "Use the resource page for AIV focus notes before opening the source."}</p>
                          </div>
                          <div>
                            <span>Checkpoint</span>
                            <p>{episode.data.checkpointPrompt || "Write one note about how this episode changes the related module artifact."}</p>
                          </div>
                        </div>
                      </div>
                      <div class="episode-path__mapping">
                        <span>Module mapping</span>
                        {mappedModules.length > 0 ? (
                          <ul>
                            {mappedModules.map((module) => {
                              const track = episodeModuleTrack(module);
                              return (
                                <li>
                                  <a href={episodeModulePath(module)}>{module.data.title}</a>
                                  {track && <small>{track.data.title}</small>}
                                </li>
                              );
                            })}
                          </ul>
                        ) : (
                          <p>No public module mapping yet.</p>
                        )}
                      </div>
                      <div class="episode-path__actions">
                        {mappedModules.length > 0 && <a class="episode-path__continue" href={episodeModulePath(mappedModules[0])}>Continue in module</a>}
                        <a href={resourcePath(episode)}>Open resource page</a>
                      </div>
                    </li>
                  );
                })}
              </ol>
            ) : (
              <div class="episode-path__empty">
                <h3>Episodes coming later</h3>
                <p>Episode records have not been added to this series yet. Use the source links in the reference rail as secondary context.</p>
              </div>
            )}
          </section>
        </main>

        <ReferenceRail title="Series Reference" sections={railSections} />
      </div>
    </div>
  </PageShell>
</BaseLayout>

<style>
  .learn-series-page {
    width: 100%;
  }

  .learn-series-page__inner {
    display: grid;
    gap: 1rem;
    margin-inline: auto;
    max-width: 1360px;
    min-width: 0;
  }

  .learn-breadcrumb,
  .learn-meta-row {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .learn-series-header {
    display: grid;
    gap: 0.5rem;
  }

  .learn-series-header h1,
  .learn-series-header p {
    margin: 0;
  }

  .learn-series-header h1 {
    font-size: clamp(2.05rem, 4vw, 3.4rem);
    line-height: 1.02;
    max-width: 17ch;
  }

  .learn-series-header p {
    color: var(--aiv-text-secondary);
    font-size: clamp(1rem, 1.3vw, 1.16rem);
    line-height: 1.45;
    max-width: 78ch;
  }

  .learn-series-layout {
    align-items: start;
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
  }

  .learn-series-main {
    min-width: 0;
  }

  .learn-access-badge {
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 999px;
    color: var(--aiv-text);
    padding: 0.12rem 0.45rem;
  }

  .episode-path {
    display: grid;
    gap: 0.8rem;
    padding: 0.95rem;
  }

  .episode-path__header {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
  }

  .episode-path__header span,
  .episode-path__details span,
  .episode-path__mapping > span {
    color: var(--aiv-text-muted);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .episode-path h2,
  .episode-path h3,
  .episode-path p,
  .episode-path ul,
  .episode-path__header p,
  .episode-path__empty h3 {
    margin: 0;
  }

  .episode-path h2 {
    font-size: clamp(1.28rem, 2vw, 1.7rem);
    line-height: 1.15;
  }

  .episode-path__header p,
  .episode-path__details p,
  .episode-path__mapping p {
    color: var(--aiv-text-secondary);
  }

  .episode-path__list {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .episode-path__item {
    align-items: start;
    display: grid;
    gap: 0.72rem;
    grid-template-columns: auto minmax(0, 1fr) minmax(13rem, 0.35fr) auto;
    padding: 0.85rem 0;
  }

  .episode-path__item + .episode-path__item {
    border-top: 1px solid color-mix(in srgb, var(--aiv-action-primary) 30%, var(--aiv-line-subtle));
  }

  .episode-path__marker {
    align-items: center;
    background: var(--aiv-action-primary);
    border-radius: 999px;
    color: var(--aiv-bg-canvas);
    display: inline-flex;
    font-family: var(--aiv-font-mono);
    font-weight: 900;
    height: 2.15rem;
    justify-content: center;
    margin-top: 0.1rem;
    width: 2.15rem;
  }

  .episode-path__main,
  .episode-path__details,
  .episode-path__mapping {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .episode-path h3 {
    font-size: 1.12rem;
    line-height: 1.22;
  }

  .episode-path__details {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .episode-path__details > div,
  .episode-path__mapping li {
    display: grid;
    gap: 0.18rem;
  }

  .episode-path__mapping {
    background: color-mix(in srgb, var(--aiv-bg-canvas) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--aiv-action-secondary) 32%, var(--aiv-line-subtle));
    border-radius: 8px;
    padding: 0.58rem 0.65rem;
  }

  .episode-path__mapping ul {
    display: grid;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
  }

  .episode-path__mapping small {
    color: var(--aiv-text-muted);
  }

  .episode-path__actions {
    display: grid;
    gap: 0.42rem;
    justify-items: stretch;
  }

  .episode-path__actions a {
    align-items: center;
    border: 1px solid var(--aiv-line-strong);
    border-radius: 6px;
    display: inline-flex;
    font-weight: 900;
    justify-content: center;
    min-height: 2.45rem;
    padding: 0.4rem 0.62rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .episode-path__continue {
    background: var(--aiv-action-primary);
    border-color: var(--aiv-action-primary) !important;
    color: var(--aiv-bg-canvas);
  }

  .episode-path__empty {
    display: grid;
    gap: 0.35rem;
    padding-block: 0.75rem;
  }

  .episode-path a:focus-visible {
    outline: 3px solid var(--aiv-focus-ring);
    outline-offset: 3px;
  }

  @media (max-width: 1180px) {
    .episode-path__item {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .episode-path__mapping,
    .episode-path__actions {
      grid-column: 2;
    }

    .episode-path__actions {
      justify-items: start;
    }
  }

  @media (max-width: 1099px) {
    .learn-series-layout,
    .episode-path__details {
      grid-template-columns: 1fr;
    }

    .learn-series-header h1 {
      max-width: none;
    }
  }

  @media (max-width: 620px) {
    .episode-path__item,
    .episode-path__mapping,
    .episode-path__actions {
      grid-column: auto;
      grid-template-columns: 1fr;
    }
  }
</style>
