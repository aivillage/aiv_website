---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageShell from "../../../components/layout/PageShell.astro";
import {
  accessModeLabels,
  byTitle,
  difficultyLabels,
  entrySlug,
  findPublicCanonicalTracksForModule,
  formatLabel,
  modulePath,
  refId,
  resourceActionLabel,
  resourcePath,
  stageLabels,
  trackScopedModulePath,
} from "../../../utils/learn";

const resources = (await getCollection("learnResources", ({ data }) => data.status !== "draft")).sort(byTitle);
const tracks = (await getCollection("learnTracks", ({ data }) => data.status !== "draft")).sort(byTitle);
const publicModules = await getCollection("learnModules", ({ data }) => data.status !== "draft");
const linkedResourceSlugs = new Set(publicModules.flatMap((module) => module.data.resources.map((link) => refId(link.resource))));
const moduleByResourceSlug = new Map<string, { title: string; href: string }>();

for (const module of publicModules.sort(byTitle)) {
  for (const link of module.data.resources) {
    const resourceSlug = refId(link.resource);
    if (resourceSlug && !moduleByResourceSlug.has(resourceSlug)) {
      const canonicalTracks = findPublicCanonicalTracksForModule(module, tracks);
      const href = canonicalTracks.length === 1 ? trackScopedModulePath(canonicalTracks[0], module) : modulePath(module);
      moduleByResourceSlug.set(resourceSlug, { title: module.data.title, href });
    }
  }
}
const stages = [...new Set(resources.map((resource) => resource.data.targetStage))];
const difficulties = [...new Set(resources.map((resource) => resource.data.difficulty))];
const resourceTypes = [...new Set(resources.map((resource) => resource.data.resourceType))].sort();
const acceptedResources = resources.filter((resource) => resource.data.reviewStatus === "accepted");
const underReviewResources = resources.filter((resource) =>
  resource.data.reviewStatus &&
  resource.data.reviewStatus !== "accepted" &&
  linkedResourceSlugs.has(entrySlug(resource))
);
const featuredVideos = resources.filter((resource) =>
  resource.data.accessMode === "direct_open" &&
  resource.data.reviewStatus === "accepted" &&
  resource.data.loginRequired === false &&
  resource.data.sourcePlatform === "youtube" &&
  resource.data.embedAllowed &&
  resource.data.ageRestricted === false &&
  resource.data.featuredEmbed &&
  (resource.data.mediaType === "video" || resource.data.resourceType === "video"),
);
const labsAndWorkshops = acceptedResources.filter((resource) =>
  resource.data.accessMode === "direct_open" &&
  resource.data.loginRequired === false &&
  (resource.data.resourceType === "lab" || resource.data.mediaType === "lab" || /workshop/i.test(`${resource.data.title} ${resource.data.provider}`)),
);
const coreResources = acceptedResources.filter((resource) =>
  resource.data.accessMode === "direct_open" &&
  resource.data.loginRequired === false &&
  !featuredVideos.includes(resource) &&
  !labsAndWorkshops.includes(resource),
);
const offRampResources = acceptedResources.filter((resource) => resource.data.accessMode !== "direct_open");
const resourceSections = [
  {
    title: "Featured Videos",
    text: "Click-to-load videos selected as useful starting points for modules.",
    resources: featuredVideos,
  },
  {
    title: "Core No-Login Resources",
    text: "Direct-open docs, courses, and references used by public Learn modules.",
    resources: coreResources,
  },
  {
    title: "Labs And Workshops",
    text: "Hands-on resources and workshop references that are safe to browse from the catalog.",
    resources: labsAndWorkshops,
  },
  {
    title: "Extra/Off-Ramps",
    text: "Useful links that may require an account, enrollment, or another step. These are not the required core path.",
    resources: offRampResources,
  },
  {
    title: "Under Review",
    text: "Public links kept secondary while source details or review status are still being checked.",
    resources: underReviewResources,
  },
].filter((section) => section.resources.length > 0);
const shownResourceCount = resourceSections.reduce((sum, section) => sum + section.resources.length, 0);
---

<BaseLayout title="Learn Resources" canonical="/learn/resources/" description="Browse the AI Village Learn beta resource appendix.">
  <PageShell class="learn-page" width="wide">
    <header class="learn-appendix-header">
      <span>Appendix</span>
      <h1>Resource Library</h1>
      <p class="text-lead">
        Use this library when a module sends you here. For a guided path, start from a track.
      </p>
      <p class="text-muted">
        Resources are linked to their original sources and remain owned by their respective creators.
      </p>
    </header>

    <form class="learn-filters" aria-label="Resource filters">
      <label>
        Track
        <select data-filter="track">
          <option value="">All tracks</option>
          {tracks.map((track) => <option value={entrySlug(track)}>{track.data.title}</option>)}
        </select>
      </label>
      <label>
        Stage
        <select data-filter="stage">
          <option value="">All stages</option>
          {stages.map((stage) => <option value={stage}>{stageLabels[stage]}</option>)}
        </select>
      </label>
      <label>
        Difficulty
        <select data-filter="difficulty">
          <option value="">All difficulty</option>
          {difficulties.map((difficulty) => <option value={difficulty}>{difficultyLabels[difficulty]}</option>)}
        </select>
      </label>
      <label>
        Type
        <select data-filter="type">
          <option value="">All types</option>
          {resourceTypes.map((type) => <option value={type}>{formatLabel(type)}</option>)}
        </select>
      </label>
    </form>

    <p class="text-muted" id="resource-count">{shownResourceCount} resources shown</p>
    <div data-resource-grid>
      {resourceSections.map((section) => (
        <section class="learn-resource-section">
          <h2>{section.title}</h2>
          <p>{section.text}</p>
          <div class="learn-resource-row-list">
            {section.resources.map((resource) => {
              const usedInModule = moduleByResourceSlug.get(entrySlug(resource));
              const creator = resource.data.creator || resource.data.attribution;
              const accessLabel = accessModeLabels[resource.data.accessMode] || accessModeLabels.direct_open;
              const isUnderReview = resource.data.reviewStatus !== "accepted";
              const isOffRamp = resource.data.accessMode !== "direct_open" || resource.data.loginRequired || resource.data.cost !== "free";
              return (
                <article
                  class="learn-resource-row learn-surface-reference"
                  data-track-refs={resource.data.tracks.map(refId).join(" ")}
                  data-stage={resource.data.targetStage}
                  data-difficulty={resource.data.difficulty}
                  data-type={resource.data.resourceType}
                  data-access={resource.data.accessMode}
                >
                  <div class="learn-resource-row__main">
                    <span>{resourceActionLabel(resource)}</span>
                    <h3><a href={resourcePath(resource)}>{resource.data.title}</a></h3>
                    <p>{creator ? `${resource.data.provider} / ${creator}` : resource.data.provider}</p>
                  </div>
                  <div class="learn-resource-row__context">
                    <span>{formatLabel(resource.data.resourceType)}</span>
                    <span>{isOffRamp ? "Off-ramp" : accessLabel}</span>
                    {isUnderReview && <span>Under review</span>}
                    {usedInModule && <a href={usedInModule.href}>Used in {usedInModule.title}</a>}
                  </div>
                  <div class="learn-resource-row__actions">
                    <a href={resourcePath(resource)}>View notes</a>
                    <a href={resource.data.canonicalUrl} target="_blank" rel="noopener noreferrer">Open original</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </PageShell>
</BaseLayout>

<script>
  const filters = Array.from(document.querySelectorAll<HTMLSelectElement>("[data-filter]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-resource-grid] article"));
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-resource-grid] .learn-resource-section"));
  const count = document.getElementById("resource-count");

  function updateResourceFilters() {
    const selected = Object.fromEntries(filters.map((filter) => [filter.dataset.filter || "", filter.value]));
    let shown = 0;

    cards.forEach((card) => {
      const matchesTrack = !selected.track || card.dataset.trackRefs?.split(" ").includes(selected.track);
      const matchesStage = !selected.stage || card.dataset.stage === selected.stage;
      const matchesDifficulty = !selected.difficulty || card.dataset.difficulty === selected.difficulty;
      const matchesType = !selected.type || card.dataset.type === selected.type;
      const visible = Boolean(matchesTrack && matchesStage && matchesDifficulty && matchesType);
      card.toggleAttribute("hidden", !visible);
      if (visible) shown += 1;
    });

    sections.forEach((section) => {
      const sectionCards = Array.from(section.querySelectorAll<HTMLElement>("article"));
      const sectionShown = sectionCards.some((card) => !card.hidden);
      section.toggleAttribute("hidden", !sectionShown);
    });

    if (count) count.textContent = `${shown} ${shown === 1 ? "resource" : "resources"} shown`;
  }

  filters.forEach((filter) => filter.addEventListener("change", updateResourceFilters));
</script>

<style>
  .learn-page {
    display: grid;
    gap: 1.5rem;
  }

  .learn-appendix-header {
    display: grid;
    gap: 0.45rem;
  }

  .learn-appendix-header span {
    color: var(--aiv-text-muted);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .learn-appendix-header h1,
  .learn-appendix-header p {
    margin: 0;
  }

  .learn-filters {
    background: color-mix(in srgb, var(--aiv-bg-panel) 58%, transparent);
    border: 1px solid var(--aiv-line-subtle);
    border-radius: 8px;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    padding: 0.9rem;
  }

  .learn-filters label {
    color: var(--aiv-text-muted);
    display: grid;
    font-weight: 700;
    gap: 0.35rem;
  }

  .learn-resource-row-list {
    display: grid;
    gap: 0.55rem;
  }

  .learn-resource-section {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .learn-resource-section h2,
  .learn-resource-section p {
    margin: 0;
  }

  .learn-resource-section > p {
    color: var(--aiv-text-muted);
  }

  .learn-resource-section[hidden] {
    display: none;
  }

  .learn-resource-row {
    align-items: start;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.42fr) auto;
    padding: 0.75rem 0.85rem;
  }

  .learn-resource-row[hidden] {
    display: none;
  }

  .learn-resource-row__main,
  .learn-resource-row__context,
  .learn-resource-row__actions {
    min-width: 0;
  }

  .learn-resource-row__main {
    display: grid;
    gap: 0.22rem;
  }

  .learn-resource-row__main > span {
    color: var(--aiv-action-secondary);
    font-family: var(--aiv-font-mono);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .learn-resource-row h3,
  .learn-resource-row p {
    margin: 0;
  }

  .learn-resource-row h3 {
    font-size: 1rem;
    line-height: 1.24;
  }

  .learn-resource-row p,
  .learn-resource-row__context {
    color: var(--aiv-text-muted);
    font-size: 0.9rem;
  }

  .learn-resource-row__context,
  .learn-resource-row__actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .learn-resource-row__context span,
  .learn-resource-row__context a {
    border-bottom: 1px dotted var(--aiv-line-subtle);
    min-height: 2rem;
  }

  .learn-resource-row__actions a {
    align-items: center;
    display: inline-flex;
    font-weight: 800;
    min-height: 2.45rem;
    padding-inline: 0.1rem;
  }

  .learn-resource-row a:focus-visible {
    outline: 3px solid var(--aiv-focus-ring);
    outline-offset: 3px;
  }

  @media (max-width: 860px) {
    .learn-resource-row {
      grid-template-columns: 1fr;
    }
  }
</style>
