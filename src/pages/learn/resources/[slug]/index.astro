---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PageShell from "../../../../components/layout/PageShell.astro";
import DifficultyBadge from "../../../../components/learn/DifficultyBadge.astro";
import StageBadge from "../../../../components/learn/StageBadge.astro";
import YouTubeEmbed from "../../../../components/learn/YouTubeEmbed.astro";
import {
  accessModeLabels,
  byTitle,
  entrySlug,
  findPublicCanonicalTracksForModule,
  formatLabel,
  modulePath,
  refId,
  resourceActionLabel,
  resourcePath,
  seriesPath,
  trackPath,
  trackScopedModulePath,
} from "../../../../utils/learn";

type ModuleLink = {
  module: CollectionEntry<"learnModules">;
  track?: CollectionEntry<"learnTracks">;
};

type Props = {
  resource: CollectionEntry<"learnResources">;
  tracks: CollectionEntry<"learnTracks">[];
  modules: ModuleLink[];
};

export async function getStaticPaths() {
  const resources = await getCollection("learnResources", ({ data }) =>
    data.status !== "draft" &&
    Boolean(data.accessMode) &&
    Boolean(data.reviewStatus) &&
    data.reviewStatus !== "rejected" &&
    data.reviewStatus !== "deferred"
  );
  const tracks = await getCollection("learnTracks", ({ data }) => data.status !== "draft");
  const modules = await getCollection("learnModules", ({ data }) => data.status !== "draft");
  const trackBySlug = new Map(tracks.flatMap((track) => [[entrySlug(track), track], [track.id, track]]));

  return resources.map((resource) => {
    const resourceSlug = entrySlug(resource);
    const relatedTracks = resource.data.tracks
      .map((trackRef) => trackBySlug.get(refId(trackRef)))
      .filter((track): track is CollectionEntry<"learnTracks"> => Boolean(track))
      .sort(byTitle) as CollectionEntry<"learnTracks">[];
    const relatedModules = modules
      .filter((module) => module.data.resources.some((link) => refId(link.resource) === resourceSlug))
      .sort(byTitle);
    const moduleLinks = relatedModules.map((module) => {
      const canonicalTracks = findPublicCanonicalTracksForModule(module, tracks);
      return { module, track: canonicalTracks.length === 1 ? canonicalTracks[0] : undefined };
    });

    return {
      params: { slug: resourceSlug },
      props: { resource, tracks: relatedTracks, modules: moduleLinks },
    };
  });
}

const { resource, tracks, modules } = Astro.props;
const { Content } = await render(resource);
const creator = resource.data.creator || resource.data.attribution || resource.data.provider;
const isPlaylist = resource.data.resourceType === "playlist" || resource.data.mediaType === "playlist";
const accessLabel = accessModeLabels[resource.data.accessMode] || accessModeLabels.direct_open;
const actionLabel = resourceActionLabel(resource);
const isOffRamp = resource.data.accessMode !== "direct_open";
const isUnderReview = resource.data.reviewStatus !== "accepted";
const canEmbedVideo = Boolean(
  resource.data.sourcePlatform === "youtube" &&
  resource.data.embedAllowed &&
  resource.data.reviewStatus === "accepted" &&
  resource.data.accessMode === "direct_open" &&
  resource.data.loginRequired === false &&
  !resource.data.ageRestricted &&
  resource.data.videoId &&
  !isPlaylist,
);
const boilerplateBodyPatterns = [
  new RegExp(["Catalog metadata", "linked resource", "curriculum beta"].join(".*"), "i"),
  new RegExp(["Catalog metadata", "linked video", "curriculum beta"].join(".*"), "i"),
  new RegExp(["Catalog metadata", "series", "curriculum beta"].join(".*"), "i"),
  new RegExp(["Review rights", "attribution", "reuse beyond linking"].join(".*"), "i"),
  /Use the official YouTube player when embedding/i,
  /Do not embed until reviewed/i,
];
const bodyText = (resource.body || "").trim();
const hasLearnerBody = Boolean(bodyText && !boilerplateBodyPatterns.some((pattern) => pattern.test(bodyText)));
const primaryModuleLink = modules[0];
const focusText = resource.data.watchFocus || `Use this ${formatLabel(resource.data.resourceType).toLowerCase()} to support the related Learn checkpoint.`;
const checkpointText = resource.data.checkpointPrompt || "Write one note about how this resource changes your module artifact or question list.";
const fallbackRationale = primaryModuleLink
  ? `AI Village includes this resource because it supports the ${primaryModuleLink.module.data.title} module and gives learners source material for the module checkpoint.`
  : `AI Village includes this resource as a learner-facing ${formatLabel(resource.data.resourceType).toLowerCase()} from ${resource.data.provider}. Use it with a concrete checkpoint instead of treating it as a catalog endpoint.`;

function moduleLinkHref(module: CollectionEntry<"learnModules">, track?: CollectionEntry<"learnTracks">) {
  return track ? trackScopedModulePath(track, module) : modulePath(module);
}
---

<BaseLayout title={resource.data.title} canonical={resourcePath(resource)} description={`Learn resource from ${resource.data.provider}: ${resource.data.title}.`}>
  <PageShell class="learn-resource-page">
    <nav class="learn-breadcrumb" aria-label="Breadcrumb"><a href="/learn/">Learn</a> / <a href="/learn/resources/">Resources</a> / <span>{resource.data.title}</span></nav>

    <header class="learn-resource-header">
      <div>
        <div class="learn-meta-row">
          <StageBadge value={resource.data.targetStage} />
          <DifficultyBadge value={resource.data.difficulty} />
          <span>{formatLabel(resource.data.resourceType)}</span>
          <span class="learn-access-badge">{isOffRamp ? "Off-ramp" : accessLabel}</span>
          {isUnderReview && <span class="learn-access-badge learn-access-badge--review">Under review</span>}
        </div>
        <h1>{resource.data.title}</h1>
        <p class="text-muted">By {creator}</p>
      </div>
    </header>

    <section class="learn-content-body">
      <h2>Why AIV Includes This</h2>
      {hasLearnerBody ? <Content /> : <p>{resource.data.accessNotes || fallbackRationale}</p>}
    </section>

    <section class="learn-two-column">
      <section class="learn-callout">
        <h2>{actionLabel} Focus</h2>
        <p>{focusText}</p>
      </section>
      <section class="learn-callout">
        <h2>Checkpoint Prompt</h2>
        <p>{checkpointText}</p>
      </section>
    </section>

    {modules.length > 0 && (
      <section class="learn-callout">
        <h2>Continue in module</h2>
        <ul class="learn-link-list">
          {modules.map(({ module, track }) => (
            <li>
              <a class="learn-module-link" href={moduleLinkHref(module, track)}>
                <strong>{module.data.title}</strong>
                {track && <span>{" · "}{track.data.title}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {canEmbedVideo && (
      <section>
        <h2>{actionLabel} Source</h2>
        <YouTubeEmbed
          title={resource.data.title}
          creator={creator}
          canonicalUrl={resource.data.canonicalUrl}
          channelUrl={resource.data.channelUrl}
          videoId={resource.data.videoId}
          embedPrivacyMode={resource.data.embedPrivacyMode}
        />
      </section>
    )}

    {!canEmbedVideo && (
      <section class="learn-callout">
        <h2>{actionLabel} Source</h2>
        <p>Open the original source when you are ready to use this resource.</p>
        <a class="button" href={resource.data.canonicalUrl} target="_blank" rel="noopener noreferrer">Open original</a>
      </section>
    )}

    {isPlaylist && (
      <section class="learn-callout">
        <h2>Video Series</h2>
        <p>Use the series page for the ordered episode list and checkpoints.</p>
        <a href={seriesPath(resource)}>View series page</a>
      </section>
    )}

    {tracks.length > 0 && (
      <section>
        <h2>Related Tracks</h2>
        <div class="learn-related-grid">
          <div>
            <ul class="learn-link-list">
              {tracks.map((track) => <li><a href={trackPath(track)}>{track.data.title}</a></li>)}
            </ul>
          </div>
        </div>
      </section>
    )}
  </PageShell>
</BaseLayout>

<style>
  .learn-resource-page {
    display: grid;
    gap: 2rem;
  }

  .learn-breadcrumb,
  .learn-meta-row {
    align-items: center;
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .learn-resource-header,
  .learn-two-column {
    display: grid;
    gap: 1.25rem;
  }

  .learn-callout {
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 8px;
    padding: 1rem;
  }

  .button {
    background: var(--aiv-action-primary);
    border: 1px solid var(--aiv-action-primary);
    border-radius: 6px;
    color: var(--aiv-bg-canvas);
    display: inline-flex;
    font-weight: 800;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.6rem 0.95rem;
    text-decoration: none;
  }

  .learn-access-badge {
    background: var(--aiv-nested-bg);
    border: 1px solid var(--aiv-nested-border);
    border-radius: 999px;
    color: var(--aiv-text);
    padding: 0.12rem 0.45rem;
  }

  .learn-callout h2 {
    font-size: 1.1rem;
    margin-top: 0;
  }

  .learn-link-list {
    display: grid;
    gap: 0.65rem;
    margin-bottom: 0;
    padding-left: 1.1rem;
  }

  .learn-module-link {
    display: inline-grid;
    gap: 0.12rem;
    line-height: 1.3;
    min-height: 2.75rem;
    padding-block: 0.2rem;
  }

  .learn-module-link strong {
    color: var(--aiv-action-primary);
  }

  .learn-module-link span,
  .learn-link-list span {
    color: var(--aiv-text-muted);
    font-size: 0.92rem;
  }

  .learn-content-body {
    max-width: 76ch;
  }

  .learn-related-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .learn-related-grid h3 {
    font-size: 1rem;
    margin-top: 0;
  }

  .button:focus-visible,
  .learn-module-link:focus-visible,
  .learn-related-grid a:focus-visible {
    outline: 3px solid var(--aiv-focus-ring);
    outline-offset: 3px;
  }

  @media (max-width: 780px) {
    .learn-two-column {
      grid-template-columns: 1fr;
    }
  }
</style>
