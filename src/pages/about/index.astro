---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageShell from "../../components/layout/PageShell.astro";
import VolunteerCard from "../../components/VolunteerCard.astro";
import { volunteerApplicationUrl } from "../../data/site";

const volunteers = (await getCollection("volunteers")).sort((a, b) => {
  const orderDiff = a.data.order - b.data.order;
  return orderDiff === 0 ? a.id.localeCompare(b.id) : orderDiff;
});
const rendered = new Map();
for (const volunteer of volunteers) {
  rendered.set(volunteer.id, await render(volunteer));
}
---

<BaseLayout
  title="About"
  canonical="/about/"
  description="Learn about AI Village's mission, leadership team, community work, and ways to participate in AI security education and research."
>
  <PageShell>
  <h1>About AI Village</h1>
  <div class="page-intro about-intro">
    <p class="text-muted text-lead">
      AI Village is a community of hackers and data scientists working to educate the world on the use and abuse of artificial intelligence in security and privacy.
    </p>
  </div>
  <hr />
  <h2>Mission</h2>
  <p>
    We aim to bring more diverse viewpoints to AI security, grow a community of hackers, engineers, researchers, and policy makers, and encourage more people with a hacker mindset to assess machine learning systems.
  </p>
  <p>
    The site content reflects that mission through public events, technical posts, hands-on workshop material, and community discussion.
  </p>
  <p>
    Community participation is governed by the <a href="/about/conduct/">AI Village code of conduct</a>.
  </p>
  <hr />
  <h2>Leadership Team</h2>
  <div class="team-grid">
    {volunteers.map((volunteer, index) => {
      const { Content } = rendered.get(volunteer.id);
      return (
        <>
          <VolunteerCard volunteer={volunteer} Content={Content} />
          {index < volunteers.length - 1 && <hr class="team-grid__separator" />}
        </>
      );
    })}
  </div>
  <hr />
  <h2 id="-join-our-team">Join the Work</h2>
  <div class="card card--accent-primary">
    <h4 class="text-accent mt-0">Get Involved</h4>
    <p>AI Village welcomes help from researchers, engineers, educators, organizers, and community builders.</p>
    <div class="mt-2">
      <a class="text-accent text-strong" href={volunteerApplicationUrl} target="_blank" rel="noopener noreferrer">→ Submit a volunteer application</a>
    </div>
  </div>
  </PageShell>
</BaseLayout>

<style>
  .about-intro {
    margin: 2rem 0;
    text-align: left;
  }

  .team-grid {
    display: grid;
    gap: 2rem;
  }

  .team-grid__separator {
    border: none;
    border-top: 1px solid var(--aiv-rule-color);
    margin: 1rem 0;
  }
</style>
