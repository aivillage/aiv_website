---
import { kioskSlides } from "../../data/kiosk";
const corners = ["top-left", "top-right", "bottom-right", "bottom-left"];
let posterNumber = 0;
const slides = kioskSlides.map((slide) => {
  if (slide.type === "brand")
    return { ...slide, duration: slide.duration ?? 9000 };
  if (slide.type === "embed")
    return { ...slide, duration: slide.duration ?? 28000 };
  return {
    ...slide,
    duration: slide.duration ?? 22000,
    corner: corners[posterNumber++ % corners.length],
  };
});

if (!slides.length || slides[0].type !== "brand") {
  throw new Error("Kiosk playlist must start with a brand slide");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Village Kiosk</title>
    <meta name="description" content="AI Village research poster slideshow" />
    <style>
      * {
        box-sizing: border-box;
      }
      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
      }
      body {
        background: #080d19;
        color: #fff;
        font-family: Arial, Helvetica, sans-serif;
      }
      main {
        position: relative;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
      }
      .slide {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 500ms ease,
          visibility 500ms ease;
      }
      .slide.active {
        opacity: 1;
        visibility: visible;
        z-index: 1;
      }
      .brand {
        background: radial-gradient(circle at center, #172945 0%, #080d19 72%);
        text-align: center;
        padding: 4vmin;
      }
      .brand-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: clamp(1rem, 3vh, 3rem);
        max-height: 100%;
      }
      .brand h1 {
        font-size: clamp(2.5rem, 6vw, 7rem);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin: 0;
      }
      .brand img {
        display: block;
        width: min(58vw, 66vh, 680px);
        max-height: 58vh;
        object-fit: contain;
        filter: invert(1);
      }
      .brand p {
        font-size: clamp(1.25rem, 2.4vw, 3rem);
        letter-spacing: 0.12em;
        margin: 0;
      }
      .poster {
        grid-template-columns: minmax(0, 62fr) minmax(0, 38fr);
        gap: 2vmin;
        padding: clamp(8px, 1.5vmin, 28px);
      }
      .poster-art {
        min-width: 0;
        min-height: 0;
        height: 100%;
      }
      .poster-art img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .poster-copy {
        align-self: center;
        max-height: 100%;
        overflow: hidden;
        padding-right: 1vmin;
      }
      .poster-copy h2 {
        font-size: max(20px, 1.6vw);
        line-height: 1.15;
        margin: 0 0 1.2em;
      }
      .poster-copy p {
        color: #dce8fb;
        font-size: max(13px, 1.05vw);
        line-height: 1.4;
        margin: 0;
        white-space: pre-line;
      }
      .poster-mark {
        position: absolute;
        width: clamp(80px, 15vmin, 340px);
        height: auto;
        filter: invert(1);
        opacity: 0.8;
        pointer-events: none;
      }
      .poster-mark--top-left {
        top: 1.5vmin;
        left: 1.5vmin;
      }
      .poster-mark--top-right {
        top: 1.5vmin;
        right: 1.5vmin;
      }
      .poster-mark--bottom-right {
        right: 1.5vmin;
        bottom: 1.5vmin;
      }
      .poster-mark--bottom-left {
        bottom: 1.5vmin;
        left: 1.5vmin;
      }
      .embed {
        background: #080d19;
      }
      .embed iframe {
        width: 100%;
        height: 100%;
        border: 0;
      }
      @media (prefers-reduced-motion: reduce) {
        .slide {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <main aria-label="AI Village kiosk slideshow">
      {
        slides.map((slide, index) => (
          <section
            class:list={["slide", slide.type, { active: index === 0 }]}
            data-duration={slide.duration}
            data-embed-src={slide.type === "embed" ? slide.url : undefined}
            data-requires-workshops={
              slide.type === "embed" && slide.requiresWorkshops
                ? "true"
                : undefined
            }
            aria-hidden={index === 0 ? "false" : "true"}
          >
            {slide.type === "brand" ? (
              <div class="brand-content">
                <h1>AI Village</h1>
                <img src="/assets/images/aiv_logo.svg" alt="" />
                <p>aivillage.org</p>
              </div>
            ) : slide.type === "embed" ? (
              <iframe title={slide.title} tabindex="-1" loading="eager" />
            ) : (
              <>
                <div class="poster-art">
                  <img alt="" />
                </div>
                <div class="poster-copy">
                  <h2 />
                  <p />
                </div>
                <img
                  class={`poster-mark poster-mark--${slide.corner}`}
                  src="/assets/images/aiv_logo.svg"
                  alt=""
                />
              </>
            )}
          </section>
        ))
      }
    </main>
    <script>
      import { posters } from "../../data/posters";

      const hostedPosters = posters.filter(
        (poster) => poster.posterAvailability === "hosted",
      );
      const posterSlides =
        document.querySelectorAll<HTMLElement>(".slide.poster");
      if (hostedPosters.length === 0) {
        throw new Error("Kiosk requires hosted posters");
      }
      for (let i = hostedPosters.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [hostedPosters[i], hostedPosters[j]] = [
          hostedPosters[j],
          hostedPosters[i],
        ];
      }
      posterSlides.forEach((slide, index) => {
        const poster = hostedPosters[index % hostedPosters.length];
        slide.dataset.src = `https://drive.google.com/thumbnail?id=${encodeURIComponent(poster.driveFileId)}&sz=w2400`;
        slide
          .querySelector(".poster-art img")!
          .setAttribute("alt", poster.title);
        slide.querySelector(".poster-copy h2")!.textContent = poster.title;
        slide.querySelector(".poster-copy p")!.textContent = poster.abstract;
      });

      const workshopsEnabled =
        new URLSearchParams(window.location.search).get("workshops") === "1";
      document
        .querySelectorAll<HTMLElement>('[data-requires-workshops="true"]')
        .forEach((slide) => {
          if (!workshopsEnabled) slide.remove();
        });
      const slides = Array.from(
        document.querySelectorAll<HTMLElement>(".slide"),
      );
      const imageState = new Map<string, "loading" | "ready" | "failed">();
      let current = 0;
      let paused = false;
      let timer: number | undefined;

      function preload(url: string): void {
        imageState.set(url, "loading");
        const image = new Image();
        image.onload = () => imageState.set(url, "ready");
        image.onerror = () => imageState.set(url, "failed");
        image.src = url;
      }

      for (const slide of slides) {
        if (slide.dataset.src && !imageState.has(slide.dataset.src))
          preload(slide.dataset.src);
      }

      function schedule(): void {
        window.clearTimeout(timer);
        if (!paused) {
          timer = window.setTimeout(
            () => advance(1),
            Number(slides[current].dataset.duration),
          );
        }
      }

      function advance(direction: number): void {
        // Search at most one full lap. A brand slide always remains available.
        for (let step = 1; step <= slides.length; step++) {
          const next =
            (current + direction * step + slides.length * step) % slides.length;
          const candidate = slides[next];
          const url = candidate.dataset.src;
          if (url && imageState.get(url) !== "ready") {
            if (imageState.get(url) === "failed") preload(url);
            continue;
          }
          const previous = slides[current];
          previous.classList.remove("active");
          previous.setAttribute("aria-hidden", "true");
          const previousFrame = previous.querySelector("iframe");
          if (previousFrame) {
            window.setTimeout(() => {
              if (!previous.classList.contains("active"))
                previousFrame.removeAttribute("src");
            }, 500);
          }
          if (url) {
            const image = candidate.querySelector("img");
            if (image) {
              image.onerror = () => {
                imageState.set(url, "failed");
                if (current === next) advance(1);
              };
              image.src = url;
            }
          }
          const frame = candidate.querySelector("iframe");
          if (frame && candidate.dataset.embedSrc)
            frame.src = candidate.dataset.embedSrc;
          candidate.classList.add("active");
          candidate.setAttribute("aria-hidden", "false");
          current = next;
          schedule();
          return;
        }
        schedule();
      }

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "ArrowRight" ||
          event.key === " " ||
          event.key === "ArrowLeft"
        ) {
          event.preventDefault();
          advance(event.key === "ArrowLeft" ? -1 : 1);
        } else if (event.key.toLowerCase() === "p") {
          paused = !paused;
          schedule();
        }
      });

      schedule();
    </script>
  </body>
</html>
