---
import "../styles/global.scss";
import "katex/dist/katex.min.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article" | "event";
  publishedTime?: Date;
  author?: string | string[];
  eventDate?: Date;
  eventLocation?: string;
  noindex?: boolean;
};
---

<!DOCTYPE html>
<html lang="en" data-theme="auto">
  <head>
    <script is:inline>
      (() => {
        const legacyThemes = new Map([
          ["institutional-dark", "dark"],
          ["institutional-light", "light"],
        ]);
        const allowed = new Set(["auto", "dark", "light"]);
        let selectedTheme = "auto";

        try {
          let savedTheme = localStorage.getItem("aiv-theme");
          if (legacyThemes.has(savedTheme)) {
            savedTheme = legacyThemes.get(savedTheme);
            localStorage.setItem("aiv-theme", savedTheme);
          }

          if (allowed.has(savedTheme)) selectedTheme = savedTheme;
          else if (savedTheme) localStorage.removeItem("aiv-theme");
        } catch {
          selectedTheme = "auto";
        }

        const effectiveTheme =
          selectedTheme === "auto"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : selectedTheme;

        document.documentElement.dataset.themePreference = selectedTheme;
        document.documentElement.dataset.theme = effectiveTheme;
        document.documentElement.dataset.ecTheme = effectiveTheme;
      })();
    </script>
    <SeoHead {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" class="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
