---
import "../styles/global.scss";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article" | "event";
  publishedTime?: Date;
  author?: string;
  eventDate?: Date;
  eventLocation?: string;
  noindex?: boolean;
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead {...Astro.props} />
  </head>
  <body>
    <Header />
    <main class="main-content">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
