---
import "../styles/global.scss";
import "katex/dist/katex.min.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article" | "event";
  publishedTime?: Date;
  author?: string;
  eventDate?: Date;
  eventLocation?: string;
  noindex?: boolean;
};
---

<!DOCTYPE html>
<html lang="en" data-theme="auto">
  <head>
    <script is:inline>
      (() => {
        const allowed = new Set(["auto", "institutional-dark", "institutional-light"]);
        let selectedTheme = "auto";

        try {
          const savedTheme = localStorage.getItem("aiv-theme");
          if (allowed.has(savedTheme)) selectedTheme = savedTheme;
          else if (savedTheme) localStorage.removeItem("aiv-theme");
        } catch {
          selectedTheme = "auto";
        }

        document.documentElement.dataset.theme = selectedTheme;
      })();
    </script>
    <SeoHead {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" class="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
