---
import BaseLayout from "./BaseLayout.astro";
import PageShell from "../components/layout/PageShell.astro";
import EventPosters from "../components/posters/EventPosters.astro";
import EmbeddedEventPosters from "../components/posters/EmbeddedEventPosters.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { EventEntry } from "../utils/site";
import { eventPath, formatDateRange, isoDateOnly, truncate } from "../utils/site";
import { posterEvents } from "../data/poster-events";
import { posters } from "../data/posters";
import { scheduleRoutesForEvent } from "../data/schedules";
import { volunteerApplicationUrl } from "../data/site";
import { normalizeImage, selectEventSocialImage } from "../utils/social-images";
import { resolveEventPosterPlacement } from "../utils/event-content";

const { event, previous, next, Content } = Astro.props as {
  event: EventEntry;
  previous?: EventEntry;
  next?: EventEntry;
  Content: AstroComponentFactory;
};
const url = eventPath(event);
const shareUrl = new URL(url, Astro.site ?? "https://aivillage.org").toString();
const scheduleLinks = scheduleRoutesForEvent(event.id);
const posterEvent = posterEvents.find((item) => item.eventPath === url);
const hasEventPosters =
  posterEvent !== undefined &&
  posters.some((poster) => poster.event === posterEvent.id);
if (posterEvent && event.body === undefined) {
  throw new Error(
    `Raw event body is unavailable for ${event.id}; poster placement cannot be resolved.`,
  );
}
const posterPlacement = resolveEventPosterPlacement({
  body: event.body ?? "",
  filePath: event.filePath,
  hasPosterEvent: posterEvent !== undefined,
});
const isMdxEvent = event.filePath?.toLowerCase().endsWith(".mdx") ?? false;
const eventContentComponents = {
  EventPosters: EmbeddedEventPosters,
};
const eventImage = normalizeImage(event.data.image);
const socialImage = selectEventSocialImage(event.data);
const formattedDateRange = formatDateRange(event.data.date, event.data.endDate);
const isMultiDay =
  event.data.endDate && isoDateOnly(event.data.endDate) > isoDateOnly(event.data.date);
const [formattedStartDate, formattedEndDate] = isMultiDay
  ? formattedDateRange.split("–")
  : [formattedDateRange, undefined];
---

<BaseLayout title={event.data.title} description={event.data.description} canonical={url} image={socialImage.path} socialImageAlt={socialImage.alt} type="event" eventDate={event.data.date} eventEndDate={event.data.endDate} eventLocation={event.data.location}>
  <PageShell>
    <article class="event">
      <header class="event-header event-layout__header">
        <h1>{event.data.title}</h1>
        <div class="event-meta event-layout__meta">
          <div>
            <strong>📅 {isMultiDay ? "Dates:" : "Date:"}</strong>
            {" "}
            {isMultiDay && event.data.endDate ? (
              <>
                <time datetime={isoDateOnly(event.data.date)}>{formattedStartDate}</time>
                <span aria-hidden="true">–</span>
                <time datetime={isoDateOnly(event.data.endDate)}>{formattedEndDate}</time>
              </>
            ) : (
              <time datetime={isoDateOnly(event.data.date)}>{formattedDateRange}</time>
            )}
          </div>
          {event.data.location && <div><strong>📍 Location:</strong> {event.data.location}</div>}
        </div>
        {event.data.description && <div class="event-description content-note content-note--accent-primary event-layout__description"><p>{event.data.description}</p></div>}
      </header>
      {eventImage && (
        <div class="post-cover-wrapper event-layout__cover">
          <img
            src={eventImage.path}
            alt={eventImage.alt ?? event.data.title}
            width={eventImage.width}
            height={eventImage.height}
            class="post-cover"
            loading="eager"
            decoding="async"
          />
        </div>
      )}
      <div class="event-content event-layout__content">
        {isMdxEvent ? (
          <Content components={eventContentComponents} />
        ) : (
          <Content />
        )}
      </div>
      {posterPlacement === "fallback" && hasEventPosters && posterEvent && (
        <div
          class="event-layout__posters"
          data-event-posters-placement="fallback"
        >
          <EventPosters
            eventId={posterEvent.id}
            variant="compact"
            limit={6}
          />
        </div>
      )}
      {scheduleLinks.length > 0 && (
        <section class="card event-layout__schedule">
          <h2>Schedules and Talks</h2>
          <ul>
            {scheduleLinks.map((link) => <li><a href={link.path}>{link.label}</a></li>)}
          </ul>
        </section>
      )}
      <footer class="event-footer event-layout__footer">
        <div class="card card--center event-layout__cta">
          <p>🎪 Interested in attending or presenting at AI Village events?</p>
          <div class="event-layout__cta-links">
            <a href="/discord/">Join our Discord</a>
            <span aria-hidden="true">•</span>
            <a href={volunteerApplicationUrl} target="_blank" rel="noopener noreferrer">Volunteer Application</a>
            <span aria-hidden="true">•</span>
            <a href="/events/">All Events</a>
          </div>
        </div>
        <div class="event-layout__footer-row">
          <div class="event-navigation">
            {previous && <a href={eventPath(previous)}>← {truncate(previous.data.title, 30)}</a>}
            {previous && next && <span aria-hidden="true">|</span>}
            {next && <a href={eventPath(next)}>{truncate(next.data.title, 30)} →</a>}
          </div>
          <div class="event-share">
            <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(event.data.title)}&via=aivillage_dc`} target="_blank" rel="noopener noreferrer">Share Event</a>
          </div>
        </div>
      </footer>
    </article>
  </PageShell>
</BaseLayout>

<style>
  .event-layout__header {
    margin-inline: auto;
    margin-bottom: 2rem;
    max-width: var(--aiv-measure-blog);
  }

  .event-layout__header h1 {
    margin: 0 0 1rem;
  }

  .event-layout__meta {
    color: var(--aiv-text-muted);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--aiv-font-mono);
    gap: 2rem;
    margin: 1rem 0;
  }

  .event-layout__meta strong {
    color: var(--aiv-warning);
  }

  .event-layout__description p {
    color: var(--aiv-text-secondary);
    font-size: 1.1rem;
    margin: 0;
  }

  .event-layout__content {
    line-height: 1.7;
    margin-inline: auto;
    max-width: var(--aiv-measure-blog);
  }

  .event-layout__posters {
    margin-inline: auto;
    max-width: var(--aiv-measure-blog);
  }

  .event-layout__schedule {
    margin-inline: auto;
    margin-top: 2rem;
    max-width: var(--aiv-measure-blog);
  }

  .event-layout__schedule h2 {
    margin-top: 0;
  }

  .event-layout__footer {
    border-top: 1px solid var(--aiv-rule-color);
    margin-inline: auto;
    margin-top: 3rem;
    max-width: var(--aiv-measure-blog);
    padding-top: 2rem;
  }

  .event-layout__cta {
    margin: 2rem 0;
  }

  .event-layout__cta p {
    color: var(--aiv-brand-primary);
    font-weight: 700;
    margin: 0 0 1rem;
  }

  .event-layout__cta-links,
  .event-layout__footer-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .event-layout__cta-links {
    justify-content: center;
  }

  .event-layout__cta-links a,
  .event-navigation a,
  .event-share a {
    color: var(--aiv-action-primary);
  }

  .event-layout__cta-links span,
  .event-navigation span {
    color: var(--aiv-text-muted);
  }

  .event-layout__footer-row {
    justify-content: space-between;
    margin-top: 2rem;
  }

  .event-navigation span {
    margin-inline: 1rem;
  }

  .event-share a {
    margin-inline: 0.5rem;
  }

</style>
