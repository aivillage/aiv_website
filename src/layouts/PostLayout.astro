---
import BaseLayout from "./BaseLayout.astro";
import PageShell from "../components/layout/PageShell.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { BlogEntry } from "../utils/site";
import { canonicalPostPath, excerptFromBody, formatDate, isoDate, truncate } from "../utils/site";
const { post, previous, next, Content } = Astro.props as {
  post: BlogEntry;
  previous?: BlogEntry;
  next?: BlogEntry;
  Content: AstroComponentFactory;
};
const url = canonicalPostPath(post);
const author = Array.isArray(post.data.author) ? post.data.author.join(", ") : post.data.author;
const shareUrl = new URL(url, Astro.site ?? "https://aivillage.org").toString();
const description = post.data.description ?? post.data.excerpt ?? excerptFromBody(post.body ?? "", 30);
---
<BaseLayout title={post.data.title} description={description} canonical={url} image={post.data.cover} type="article" publishedTime={post.data.date} author={author}>
  <PageShell>
    <article class="post">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          {author && <span class="post-author">By {author}</span>}
          {author && post.data.date && " • "}
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          {post.data.category && <> • <span class="post-category">#{post.data.category}</span></>}
        </div>
        {post.data.description && <div class="post-description"><p>{post.data.description}</p></div>}
      </header>
      {post.data.cover && <div class="post-cover-wrapper"><img src={post.data.cover} alt={post.data.title} class="post-cover" /></div>}
      <div class="post-content">
        <Content />
      </div>
      <footer class="post-footer">
        <div class="post-footer-content">
          <div class="post-navigation">
            {previous && <a href={canonicalPostPath(previous)} class="nav-link prev-link">← {truncate(previous.data.title, 30)}</a>}
            {previous && next && <span class="nav-separator">|</span>}
            {next && <a href={canonicalPostPath(next)} class="nav-link next-link">{truncate(next.data.title, 30)} →</a>}
          </div>
          <div class="post-share">
            <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(post.data.title)}&via=aivillage_dc`} target="_blank" rel="noopener noreferrer" class="share-link">Share on Twitter</a>
          </div>
        </div>
        <div class="post-contribute">
          <p>
            📝 <strong>Want to contribute?</strong>
            <a href="https://github.com/aivillage/aiv_website" target="_blank" rel="noopener noreferrer">Submit a pull request</a>
            or join our <a href="/discord/">Discord</a> to discuss ideas.
          </p>
        </div>
      </footer>
    </article>

    {post.data.mermaid && (
      <script>
        import mermaid from "mermaid";

        const mediaTheme = window.matchMedia("(prefers-color-scheme: dark)");

        document.querySelectorAll('pre[data-language="mermaid"]').forEach((pre) => {
          const code = pre.querySelector("code");
          const div = document.createElement("div");
          div.className = "mermaid";
          div.dataset.source = code ? code.textContent : pre.textContent;
          div.textContent = div.dataset.source;
          pre.replaceWith(div);
        });

        function colorToken(name: string) {
          return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
        }

        function mermaidConfig() {
          const darkMode =
            document.documentElement.dataset.theme === "institutional-dark" ||
            (document.documentElement.dataset.theme === "auto" && mediaTheme.matches);
          const canvas = colorToken("--aiv-bg-canvas");
          const surface = colorToken("--aiv-bg-surface");
          const panel = colorToken("--aiv-bg-panel");
          const nested = colorToken("--aiv-nested-bg");
          const border = colorToken("--aiv-nested-border");
          const text = colorToken("--aiv-text-primary");
          const muted = colorToken("--aiv-text-muted");
          const action = colorToken("--aiv-action-primary");
          const brand = colorToken("--aiv-brand-primary");
          const warning = colorToken("--aiv-warning");
          const risk = colorToken("--aiv-risk");

          return {
            startOnLoad: false,
            theme: "base" as const,
            themeVariables: {
              background: canvas,
              mainBkg: surface,
              primaryColor: nested,
              primaryTextColor: text,
              primaryBorderColor: border,
              secondaryColor: darkMode ? panel : "#ffffff",
              secondaryTextColor: text,
              secondaryBorderColor: border,
              tertiaryColor: darkMode ? "#2a1f12" : "#fff3d6",
              tertiaryTextColor: text,
              tertiaryBorderColor: warning,
              noteBkg: surface,
              noteTextColor: text,
              noteBorderColor: border,
              lineColor: darkMode ? action : muted,
              textColor: text,
              edgeLabelBackground: surface,
              labelBackground: surface,
              actorBkg: surface,
              actorBorder: border,
              actorTextColor: text,
              signalColor: action,
              signalTextColor: text,
              loopTextColor: text,
              activationBkgColor: nested,
              activationBorderColor: border,
              sequenceNumberColor: text,
              nodeBorder: border,
              clusterBkg: surface,
              clusterBorder: border,
              titleColor: text,
              labelTextColor: text,
              darkMode,
              errorBkgColor: risk,
              errorTextColor: text,
              altBackground: darkMode ? panel : "#f5f7f9",
              fillType0: nested,
              fillType1: darkMode ? "#1f2f3d" : "#eaf2f6",
              fillType2: darkMode ? "#2a1f12" : "#fff3d6",
              fillType3: darkMode ? "#17271f" : "#e9f4ee",
              fillType4: darkMode ? "#2d1d1d" : "#f7e7e4",
              fillType5: surface,
              fillType6: darkMode ? "#202436" : "#eeeaf5",
              fillType7: darkMode ? "#1b2b32" : "#e8f4f8",
              cScale0: action,
              cScale1: brand,
              cScale2: warning,
              cScale3: risk,
            },
          };
        }

        async function renderMermaid() {
          const diagrams = Array.from(document.querySelectorAll<HTMLElement>(".mermaid"));
          diagrams.forEach((diagram) => {
            diagram.removeAttribute("data-processed");
            diagram.textContent = diagram.dataset.source || "";
          });

          mermaid.initialize(mermaidConfig());
          await mermaid.run({ nodes: diagrams });
        }

        renderMermaid();
      </script>
    )}
  </PageShell>
</BaseLayout>
